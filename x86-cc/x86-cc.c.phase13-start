            if(cond_depth>=16){free(out);return 0;} parent_active[cond_depth]=active; branch_true[cond_depth]=(cv!=0); active=active&&branch_true[cond_depth]; cond_depth++;
        } else if ((end-line >= 7 && !strncmp(line, "#ifdef", 6) && isspace((unsigned char)line[6])) ||
            (end-line >= 8 && !strncmp(line, "#ifndef", 7) && isspace((unsigned char)line[7]))) {
            int invert = line[3] == 'n', found = 0, m; const char *q = line + (invert ? 7 : 6); char nbuf[64]; size_t nn=0;
            while (q<end && isspace((unsigned char)*q)) q++;
            while (q<end && (isalnum((unsigned char)*q)||*q=='_') && nn+1<sizeof(nbuf)) nbuf[nn++]=*q++;
            nbuf[nn]=0; if (!nn || cond_depth>=16) { free(out); return 0; }
            for (m=nmac-1;m>=0;m--) if (!strcmp(macros[m].name,nbuf)) { found=1; break; }
            parent_active[cond_depth]=active; branch_true[cond_depth]=invert ? !found : found;
            active = active && branch_true[cond_depth]; cond_depth++;
        } else if (end-line >= 5 && !strncmp(line, "#else", 5)) {
            if (cond_depth<=0) { free(out); return 0; }
            active = parent_active[cond_depth-1] && !branch_true[cond_depth-1];
            branch_true[cond_depth-1] = !branch_true[cond_depth-1];
        } else if (end-line >= 6 && !strncmp(line, "#endif", 6)) {
            if (cond_depth<=0) { free(out); return 0; }
            cond_depth--; active = parent_active[cond_depth];
        } else if (!active) {
            /* discard inactive source lines */
        } else if (end - line >= 8 && !strncmp(line, "#include", 8) && isspace((unsigned char)line[8])) {
            const char *q = line + 8;
            while (q < end && isspace((unsigned char)*q)) q++;
            { char hname[128]; size_t hn = 0; char close;
              if (*q == '<') close = '>'; else if (*q == '\"') close = '\"'; else { free(out); return 0; }
              q++;
              while (q < end && *q != close && hn + 1 < sizeof(hname)) hname[hn++] = *q++;
              hname[hn] = 0;
              if (q >= end || *q != close || !hn || !load_target_header_types(hname, close == '\"', macros, &nmac)) { free(out); return 0; }
            }
        } else if (end - line >= 7 && !strncmp(line, "#define", 7) && isspace((unsigned char)line[7])) {
            const char *q = line + 7, *v; size_t nn, vn;
            while (q < end && isspace((unsigned char)*q)) q++;
            v = q; while (v < end && (isalnum((unsigned char)*v) || *v == '_')) v++;
            nn = (size_t)(v - q); if (!nn || nn >= sizeof(macros[0].name)) { free(out); return 0; }
            if (v < end && *v == '(') {
                const char *ps = ++v, *pe; size_t pn;
                if (nfmac >= 32) { free(out); return 0; }
                pe = ps; while (pe < end && (isalnum((unsigned char)*pe) || *pe == '_')) pe++;
                pn = (size_t)(pe-ps); if (!pn || pn >= sizeof(fmacros[0].param) || pe>=end || *pe!=')') { free(out); return 0; }
                memcpy(fmacros[nfmac].name,q,nn); fmacros[nfmac].name[nn]=0;
                memcpy(fmacros[nfmac].param,ps,pn); fmacros[nfmac].param[pn]=0;
                v=pe+1; while (v<end && isspace((unsigned char)*v)) v++;
                vn=(size_t)(end-v); while(vn && isspace((unsigned char)v[vn-1])) vn--;
                if (!vn || vn>=sizeof(fmacros[0].value)) { free(out); return 0; }
                memcpy(fmacros[nfmac].value,v,vn); fmacros[nfmac].value[vn]=0; nfmac++;
            } else {
                if (nmac >= 64) { free(out); return 0; }
                memcpy(macros[nmac].name, q, nn); macros[nmac].name[nn] = 0;
                while (v < end && isspace((unsigned char)*v)) v++;
                vn = (size_t)(end - v); while (vn && isspace((unsigned char)v[vn-1])) vn--;
                if (!vn || vn >= sizeof(macros[0].value)) { free(out); return 0; }
                memcpy(macros[nmac].value, v, vn); macros[nmac].value[vn] = 0; nmac++;
            }
        } else {
            size_t i = 0; int quote = 0;
            while (i < len) {
                if (block_comment) {
                    if (i + 1 < len && p[i] == '*' && p[i+1] == '/') block_comment = 0;
                    if (w+2 >= cap) { free(out); return 0; } out[w++] = p[i++];
                    continue;
                }
                if (quote) {
                    if (w+2 >= cap) { free(out); return 0; }
                    out[w++] = p[i];
                    if (p[i] == '\\' && i + 1 < len) { out[w++] = p[++i]; i++; continue; }
                    if (p[i] == quote) quote = 0;
                    i++; continue;
                }
                if (i + 1 < len && p[i] == '/' && p[i+1] == '*') block_comment = 1;
                if (i + 1 < len && p[i] == '/' && p[i+1] == '/') {
                    if (w + (len-i) + 2 >= cap) { free(out); return 0; }
                    memcpy(out+w, p+i, len-i); w += len-i; i=len; continue;
                }
                if (p[i] == '\"' || p[i] == '\'') { quote = (unsigned char)p[i]; out[w++] = p[i++]; continue; }
                if (!block_comment && (isalpha((unsigned char)p[i]) || p[i] == '_')) {
                    size_t j = i + 1; int m, hit = -1, fhit = -1;
                    while (j < len && (isalnum((unsigned char)p[j]) || p[j] == '_')) j++;
                    for (m = nfmac - 1; m >= 0; m--) if (strlen(fmacros[m].name)==j-i && !strncmp(p+i,fmacros[m].name,j-i)) { fhit=m; break; }
                    if (fhit >= 0 && j < len && p[j] == '(') {
                        size_t a0=j+1, a1=a0, k=0, z; int dep=1; char arg[128]; const char *rv=fmacros[fhit].value;
                        while (a1<len && dep) { if(p[a1]=='(') dep++; else if(p[a1]==')') { dep--; if(!dep) break; } a1++; }
                        if (dep || a1-a0 >= sizeof(arg)) { free(out); return 0; }
                        memcpy(arg,p+a0,a1-a0); arg[a1-a0]=0;
                        while (rv[k]) {
                            if ((isalpha((unsigned char)rv[k])||rv[k]=='_')) {
                                size_t t=k+1; while (isalnum((unsigned char)rv[t])||rv[t]=='_') t++;
                                if (strlen(fmacros[fhit].param)==t-k && !strncmp(rv+k,fmacros[fhit].param,t-k)) { z=strlen(arg); if(w+z+2>=cap){free(out);return 0;} memcpy(out+w,arg,z); w+=z; }
                                else { if(w+t-k+2>=cap){free(out);return 0;} memcpy(out+w,rv+k,t-k); w+=t-k; }
                                k=t;
                            } else { if(w+2>=cap){free(out);return 0;} out[w++]=rv[k++]; }
                        }
                        i=a1+1;
                    } else {
                        for (m = nmac - 1; m >= 0; m--) if (strlen(macros[m].name) == j-i && !strncmp(p+i, macros[m].name, j-i)) { hit = m; break; }
                        if (hit >= 0) { size_t z = strlen(macros[hit].value); if (w+z+2 >= cap) { free(out); return 0; } memcpy(out+w, macros[hit].value, z); w += z; }
                        else { if (w+j-i+2 >= cap) { free(out); return 0; } memcpy(out+w,p+i,j-i); w += j-i; }
                        i = j;
                    }
                } else { if (w+2 >= cap) { free(out); return 0; } out[w++] = p[i++]; }
            }
            out[w++] = '\n';
        }
        p = *end ? end + 1 : end;
    }
    if (cond_depth != 0) { free(out); return 0; }
    out[w] = 0; free(src); *psrc = out; return 1;
}

static void normalize_integer_suffixes(char *s) {
    char *p = s; int quote = 0;
    while (*p) {
        if (quote) { if (*p == '\\' && p[1]) { p += 2; continue; } if (*p == quote) quote = 0; p++; continue; }
        if (*p == '"' || *p == '\'') { quote = (unsigned char)*p++; continue; }
        if (isdigit((unsigned char)*p)) {
            char *q = p; while (isalnum((unsigned char)*q) || *q == 'x' || *q == 'X') q++;
            while (q > p && (q[-1] == 'u' || q[-1] == 'U' || q[-1] == 'l' || q[-1] == 'L')) *--q = ' ';
            while (*p && !isspace((unsigned char)*p) && (isalnum((unsigned char)*p) || *p == 'x' || *p == 'X')) p++;
        } else p++;
    }
}

static void normalize_decl_qualifiers(char *s) {
    char *p = s;
    int quote = 0;
    while (*p) {
        char *q;
        if (quote) {
            if (*p == '\\' && p[1]) { p += 2; continue; }
            if (*p == quote) quote = 0;
            p++;
            continue;
        }
        if (*p == '"' || *p == '\'') { quote = (unsigned char)*p++; continue; }
        q = p;
        while (*q && (isalnum((unsigned char)*q) || *q == '_')) q++;
        if (q > p && ((q - p == 6 && !strncmp(p, "static", 6)) ||
                      (q - p == 5 && !strncmp(p, "const", 5)))) {
            while (p < q) *p++ = ' ';
        } else if (q > p) {
            p = q;
        } else {
            p++;
        }
    }
}

static void compact_ws(char *s) {
    char *r = s, *w = s;
    int pending_space = 0;

    while (*r) {
        if (isspace((unsigned char)*r)) {
            pending_space = 1;
            r++;
            continue;
        }
        if (pending_space && w != s && w[-1] != '{' && w[-1] != ';' &&
            *r != '}' && *r != ';' && *r != '(' && w[-1] != '(') {
            *w++ = ' ';
        }
        pending_space = 0;
        *w++ = *r++;
    }
    *w = '\0';
}

static int find_return_expr(const char *src, char *expr, size_t exprsz) {
    const char *p = src;
    const char *q;
    size_t n;

    while ((p = strstr(p, "return")) != NULL) {
        unsigned char before = (p == src) ? 0 : (unsigned char)p[-1];
        unsigned char after = (unsigned char)p[6];
        if ((p == src || !(isalnum(before) || before == '_')) &&
            !(isalnum(after) || after == '_')) {
            break;
        }
        p += 6;
    }
    if (!p) return 0;

    p += 6;
    while (isspace((unsigned char)*p)) p++;
    q = strchr(p, ';');
    if (!q) return 0;
    n = (size_t)(q - p);
    if (n + 1 > exprsz) return 0;
    memcpy(expr, p, n);
    expr[n] = '\0';
    return 1;
}

#define MAX_STRUCT_TYPES 16
#define MAX_STRUCT_MEMBERS 16

typedef struct {
    char name[64];
    char member_name[MAX_STRUCT_MEMBERS][64];
    int member_pointer[MAX_STRUCT_MEMBERS]; /* Phase 5C: 0 scalar, 1 pointer */
    int member_char[MAX_STRUCT_MEMBERS];    /* scalar/pointee base type */
    int member_offset[MAX_STRUCT_MEMBERS];  /* byte offset from struct base */
    int member_count;
    int size_bytes;
} StructType;

static StructType g_structs[MAX_STRUCT_TYPES];
static int g_struct_count;

static int struct_find(const char *name) {
    int i;
    for (i = 0; i < g_struct_count; i++)
        if (!strcmp(g_structs[i].name, name)) return i;
    return -1;
}

static int struct_member_find(int sid, const char *name) {
    int i;
    if (sid < 0 || sid >= g_struct_count) return -1;
    for (i = 0; i < g_structs[sid].member_count; i++)
        if (!strcmp(g_structs[sid].member_name[i], name)) return i;
    return -1;
}

/* Phase 5C: members now carry type and byte layout metadata.  The current
 * aggregate fence supports int, char, int *, and char * members.  Layout is
 * deliberately packed and deterministic: char consumes one byte, while int
 * and pointers consume two.  Nested structs, member arrays, and T ** members
 * remain later work. */
static int scan_struct_defs(const char *src) {
    const char *p = src;
    g_struct_count = 0;
    while (*p) {
        const char *q;
        char sname[64];
        size_t sn = 0;
        int sid, members = 0, size_bytes = 0;
        while (isspace((unsigned char)*p)) p++;
        if (strncmp(p, "struct", 6) || (isalnum((unsigned char)p[6]) || p[6] == '_')) {
            p++;
            continue;
        }
        q = p + 6;
        while (isspace((unsigned char)*q)) q++;
        if (!(isalpha((unsigned char)*q) || *q == '_')) return 0;
        while ((isalnum((unsigned char)*q) || *q == '_') && sn + 1 < sizeof(sname)) sname[sn++] = *q++;
        sname[sn] = 0;
        while (isspace((unsigned char)*q)) q++;
        if (*q != '{') { p++; continue; } /* local/reference use, not a definition */
        if (struct_find(sname) >= 0 || g_struct_count >= MAX_STRUCT_TYPES) return 0;
        sid = g_struct_count;
        snprintf(g_structs[sid].name, sizeof(g_structs[sid].name), "%s", sname);
        q++;
        while (1) {
            char mname[64]; size_t mn = 0; int k, is_char = 0, pointer_depth = 0;
            while (isspace((unsigned char)*q)) q++;
            if (*q == '}') { q++; break; }
            if (!strncmp(q, "int", 3) && isspace((unsigned char)q[3])) q += 3;
            else if (!strncmp(q, "char", 4) && isspace((unsigned char)q[4])) { q += 4; is_char = 1; }
            else return 0;
            while (isspace((unsigned char)*q)) q++;
            while (*q == '*') { pointer_depth++; q++; while (isspace((unsigned char)*q)) q++; }
            if (pointer_depth > 1) return 0;
            if (!(isalpha((unsigned char)*q) || *q == '_')) return 0;
            while ((isalnum((unsigned char)*q) || *q == '_') && mn + 1 < sizeof(mname)) mname[mn++] = *q++;
            mname[mn] = 0;
            while (isspace((unsigned char)*q)) q++;
            if (*q != ';' || members >= MAX_STRUCT_MEMBERS) return 0;
            for (k = 0; k < members; k++) if (!strcmp(g_structs[sid].member_name[k], mname)) return 0;
            snprintf(g_structs[sid].member_name[members], 64, "%s", mname);
            g_structs[sid].member_pointer[members] = pointer_depth;
            g_structs[sid].member_char[members] = is_char;
            g_structs[sid].member_offset[members] = size_bytes;
            size_bytes += (is_char && pointer_depth == 0) ? 1 : 2;
            members++;
            q++;
        }
        if (members == 0) return 0;
        while (isspace((unsigned char)*q)) q++;
        if (*q != ';') return 0;
        q++;
        g_structs[sid].member_count = members;
        g_structs[sid].size_bytes = size_bytes;
        g_struct_count++;
        p = q;
    }
    return 1;
}

#define MAX_LOCALS 512
#define MAX_GLOBALS 128

typedef struct {
    char name[64];
    int is_pointer;
    int is_char;
    int width;
    int array_len;
    int has_init;
    long init_value;
} GlobalObject;

static GlobalObject g_globals[MAX_GLOBALS];
static int g_global_count;

static int global_find(const char *name) {
    int i;
    for (i = 0; i < g_global_count; i++)
        if (!strcmp(g_globals[i].name, name)) return i;
    return -1;
}

typedef struct {
    char name[64];
    int offset; /* signed BP displacement: locals negative, parameters positive */
    int is_pointer; /* Phase 4I: pointer depth (0, 1, or 2) */
    int is_char;    /* Phase 4F: char object, or char element/pointee when pointer/array */
    int array_len;  /* >0 for local array objects */
    int struct_id;  /* Phase 5A: >=0 for a local struct object */
} Local;

typedef struct {
    const char *p;
    int ok;
    FILE *out;
    Local locals[MAX_LOCALS];
    int nlocals;
    int total_locals;
    int scope_depth;
    int scope_base[32];
    int next_label;
    int loop_depth;
    int break_label[32];
    int continue_label[32];
    int loop_kind[32]; /* 0=while, 1=for */
    char return_label[80];
    int expr_is_pointer; /* Phase 4I: pointer depth of most recent expression */
    int expr_pointer_char; /* base type is char when pointer depth > 0 */
    int expr_struct_id; /* Phase 5B: >=0 when expression is pointer to named struct */
} BodyParser;

static void body_ws(BodyParser *b) {
    while (isspace((unsigned char)*b->p)) b->p++;
}

static int body_ident(BodyParser *b, char *name, size_t namesz) {
    const char *start;
    size_t n;
    body_ws(b);
    if (!(isalpha((unsigned char)*b->p) || *b->p == '_')) return 0;
    start = b->p++;
    while (isalnum((unsigned char)*b->p) || *b->p == '_') b->p++;
    n = (size_t)(b->p - start);
    if (n + 1 > namesz) { b->ok = 0; return 0; }
    memcpy(name, start, n);
    name[n] = '\0';
    return 1;
}

static int body_kw(BodyParser *b, const char *kw) {
    size_t n = strlen(kw);
    body_ws(b);
    if (strncmp(b->p, kw, n) != 0) return 0;
    if (isalnum((unsigned char)b->p[n]) || b->p[n] == '_') return 0;
    b->p += n;
    return 1;
}

static int local_find(BodyParser *b, const char *name) {
    int i;
    /* Search innermost declarations first so a block-local may shadow an
     * outer declaration without changing expression code generation. */
    for (i = b->nlocals - 1; i >= 0; i--)
        if (!strcmp(b->locals[i].name, name)) return i;
    return -1;
}

static int local_find_current_scope(BodyParser *b, const char *name) {
    int i;
    int base = b->scope_depth > 0 ? b->scope_base[b->scope_depth - 1] : 0;
    for (i = b->nlocals - 1; i >= base; i--)
        if (!strcmp(b->locals[i].name, name)) return i;
    return -1;
}

static void scope_enter(BodyParser *b) {
    if (b->scope_depth >= 32) { b->ok = 0; return; }
    b->scope_base[b->scope_depth++] = b->nlocals;
}

static void scope_leave(BodyParser *b) {
    if (b->scope_depth <= 0) { b->ok = 0; return; }
    b->nlocals = b->scope_base[--b->scope_depth];
}

static int local_add_typed(BodyParser *b, const char *name, int is_pointer, int is_char) {
    Local *l;
    if (b->nlocals >= MAX_LOCALS || b->total_locals >= MAX_LOCALS ||
        local_find_current_scope(b, name) >= 0) {
        b->ok = 0;
        return -1;
    }
    l = &b->locals[b->nlocals];
    snprintf(l->name, sizeof(l->name), "%s", name);
    /* Keep each declaration on a distinct preallocated frame slot.  Scope
     * exit removes the name from lookup, not the already reserved storage. */
    l->offset = -2 * (b->total_locals + 1);
    l->is_pointer = is_pointer;
    l->is_char = is_char;
    l->array_len = 0;
    l->struct_id = -1;
    b->total_locals++;
    return b->nlocals++;
}

static int local_add_array(BodyParser *b, const char *name, int array_len, int is_char, int element_pointer_depth) {
    Local *l;
    if (array_len <= 0 || b->nlocals >= MAX_LOCALS ||
        b->total_locals + ((is_char && element_pointer_depth == 0) ? (array_len + 1) / 2 : array_len) > MAX_LOCALS ||
        local_find_current_scope(b, name) >= 0) {
        b->ok = 0;
        return -1;
    }
    l = &b->locals[b->nlocals];
    snprintf(l->name, sizeof(l->name), "%s", name);
    /* Arrays are contiguous. int elements occupy two bytes; char elements one. */
    {
        int slots = (is_char && element_pointer_depth == 0) ? (array_len + 1) / 2 : array_len;
        l->offset = -2 * (b->total_locals + slots);
        b->total_locals += slots;
    }
    l->is_pointer = element_pointer_depth;
    l->is_char = is_char;
    l->array_len = array_len;
    l->struct_id = -1;
    return b->nlocals++;
}

static int local_add_struct(BodyParser *b, const char *name, int sid) {
    Local *l;
    int slots;
    if (sid < 0 || sid >= g_struct_count) { b->ok = 0; return -1; }
    slots = (g_structs[sid].size_bytes + 1) / 2;
    if (b->nlocals >= MAX_LOCALS || b->total_locals + slots > MAX_LOCALS ||
        local_find_current_scope(b, name) >= 0) { b->ok = 0; return -1; }
    l = &b->locals[b->nlocals];
    snprintf(l->name, sizeof(l->name), "%s", name);
    l->offset = -2 * (b->total_locals + slots);
    l->is_pointer = 0;
    l->is_char = 0;
    l->array_len = 0;
    l->struct_id = sid;
    b->total_locals += slots;
    return b->nlocals++;
}

static int local_add_struct_pointer(BodyParser *b, const char *name, int sid) {
    Local *l;
    if (sid < 0 || sid >= g_struct_count) { b->ok = 0; return -1; }
    if (b->nlocals >= MAX_LOCALS || b->total_locals >= MAX_LOCALS ||
        local_find_current_scope(b, name) >= 0) { b->ok = 0; return -1; }
    l = &b->locals[b->nlocals];
    snprintf(l->name, sizeof(l->name), "%s", name);
    l->offset = -2 * (b->total_locals + 1);
    l->is_pointer = 1;
    l->is_char = 0;
    l->array_len = 0;
    l->struct_id = sid;
    b->total_locals++;
    return b->nlocals++;
}



