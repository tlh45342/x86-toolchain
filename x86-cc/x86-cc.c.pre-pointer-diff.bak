        if(end-q>=7&&!strncmp(q,"defined",7) && (q+7==end || !(isalnum((unsigned char)q[7])||q[7]=='_'))) {
            char n[64];size_t z=0;q+=7;while(q<end&&isspace((unsigned char)*q))q++;
            if(q<end&&*q=='('){q++;while(q<end&&isspace((unsigned char)*q))q++;}
            while(q<end&&(isalnum((unsigned char)*q)||*q=='_')&&z+1<sizeof(n))n[z++]=*q++;
            n[z]=0;while(q<end&&isspace((unsigned char)*q))q++;if(q<end&&*q==')')q++;
