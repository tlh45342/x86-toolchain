            if(raw_depth>=16){free(out);return 0;} raw_parent[raw_depth]=raw_active; raw_taken[raw_depth]=cv; raw_active=raw_active&&cv; raw_depth++;
            if(w+len+2>=cap){free(out);return 0;} memcpy(out+w,p,len);w+=len;out[w++]='\n';
        } else if ((end-line>=7&&!strncmp(line,"#ifdef",6)&&isspace((unsigned char)line[6])) ||
