}

static int join_path(char *dst, size_t cap, const char *dir, const char *name) {
    size_t a=strlen(dir), b=strlen(name);
    if (a+b+2 > cap) return 0;
    memcpy(dst,dir,a); dst[a]='/'; memcpy(dst+a+1,name,b+1);
    return 1;
}

static void normalize_pp_directive_spacing(char *s)
{
    char *p=s;
    while(*p) {
        char *line=p,*hash,*q,*end=strchr(p,'\n');
        if(!end) end=p+strlen(p);
        hash=line; while(hash<end&&(*hash==' '||*hash=='\t'||*hash=='\r'))hash++;
        if(hash<end&&*hash=='#') {
            q=hash+1; while(q<end&&(*q==' '||*q=='\t'))q++;
            if(q>hash+1) memmove(hash+1,q,strlen(q)+1);
        }
        p=strchr(line,'\n'); if(!p)break; p++;
    }
}

/* Phase 6I: recursively replace #include lines with the complete header text.
