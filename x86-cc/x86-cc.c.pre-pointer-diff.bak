typedef struct { char name[64]; int is_char; int width; char struct_tag[64]; } TypeAlias;
static TypeAlias g_aliases[512];
static int g_alias_count;
static char g_pp_context[256];
static char g_include_dir[512] = X86CC_DEFAULT_INCLUDEDIR;
static char g_source_dir[512] = ".";
static char g_user_include_dirs[8][512];
static int g_user_include_count;

/* Phase 6J include-control macro state.  This is deliberately limited to
 * deciding whether an include directive is active and resolving object-like
 * header-name macros; the normal macro pass still performs C token expansion. */
typedef struct { char name[64]; char value[256]; } IncludeMacro;
static IncludeMacro g_inc_macros[128];
static int g_inc_macro_count;
static int inc_macro_find(const char *name) {
    int i; for (i=g_inc_macro_count-1;i>=0;i--) if(!strcmp(g_inc_macros[i].name,name)) return i; return -1;
}
static void inc_macro_set(const char *name, const char *value) {
    int i=inc_macro_find(name); if(i<0) { if(g_inc_macro_count>=128)return; i=g_inc_macro_count++; }
    snprintf(g_inc_macros[i].name,sizeof(g_inc_macros[i].name),"%s",name);
    snprintf(g_inc_macros[i].value,sizeof(g_inc_macros[i].value),"%s",value?value:"");
}
static void inc_macro_unset(const char *name) {
    int i=inc_macro_find(name); if(i>=0) { for(;i+1<g_inc_macro_count;i++) g_inc_macros[i]=g_inc_macros[i+1]; g_inc_macro_count--; }
}
static int inc_eval_if(const char *q, const char *end) {
    char expr[4096]; size_t w=0;
