            nbuf[nn]=0;
            cv=inc_macro_find(nbuf)>=0; if(inv)cv=!cv;
            if(raw_depth>=16){free(out);return 0;} raw_parent[raw_depth]=raw_active; raw_taken[raw_depth]=cv; raw_active=raw_active&&cv; raw_depth++;
            if(w+len+2>=cap){free(out);return 0;} memcpy(out+w,p,len);w+=len;out[w++]='\n';
        } else if (end-line>=5&&!strncmp(line,"#else",5)&&raw_depth>0) {
            raw_active=raw_parent[raw_depth-1]&&!raw_taken[raw_depth-1]; raw_taken[raw_depth-1]=1;
            if(w+len+2>=cap){free(out);return 0;} memcpy(out+w,p,len);w+=len;out[w++]='\n';
        } else if (end-line >= 6 && !strncmp(line, "#endif", 6) && raw_depth > 0) {
            raw_active = raw_parent[--raw_depth];
