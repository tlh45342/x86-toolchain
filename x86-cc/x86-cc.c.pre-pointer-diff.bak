/* x86-cc.c - deliberately small C-to-flat-binary compiler seed for x86.
 * Version 0.0.47
 *
 * Phase 0 established the toolchain shape with:
 *
 *   int main(void) { return INTEGER; }
 *   int main(void) { return INTEGER + INTEGER; }
 *
 * Phase 1A replaced the old one-off return-expression scanner with the
 * beginning of a real recursive-descent expression parser.
 *
 * Phase 1C added scalar local int declarations, initialization, assignment,
 * identifier lookup, and stack-backed local storage. Phase 1D integrated
 * multiplicative expressions with runtime local values and added focused
 * diagnostics. Phase 2A added equality and relational expressions and canonical C truth
 * values. Phase 2B adds compound statements and if/else control flow. Phase 2C adds while loops plus break and continue. Phase 2D adds for loops. Phase 2E adds logical !, &&, and || with short-circuit evaluation. Phase 2F adds lexical block scope, local shadowing, and for-initializer scope. Phase 3A adds multiple zero-argument functions and direct function calls. Phase 3B adds integer parameters and arguments. Phase 3C validates recursive and mutually recursive calls on the function-frame model. Phase 3D adds function prototypes and a translation-unit function-signature pass. Phase 4A adds local int pointers, address-of, dereference, and indirect store. Phase 4B makes lvalue address generation explicit and composes address-of/dereference through the expression model. Phase 4C carries pointer types across function-call boundaries with pointer parameters and typed argument validation. Phase 4D adds local int arrays, indexed lvalues/rvalues, scaled indexing, and array-to-pointer decay for calls. Phase 4E adds scaled int-pointer arithmetic for pointer +/- integer and integer + pointer expressions. Phase 4F adds char objects, char pointers, char arrays, byte loads/stores, and byte-scaled pointer arithmetic. Phase 4G adds compiler-owned NUL-terminated string literals as static data and makes each literal expression yield a char pointer. Phase 4H generalizes indexed lvalues/rvalues from local arrays to typed pointer values, making p[i] equivalent to *(p + i). Phase 4I extends the compact type model to pointer depth two, enabling int ** and char ** objects, address-of pointer objects, double dereference, double-pointer parameters, and pointer-depth-preserving subscripting. Phase 4J adds local arrays whose elements are typed pointers, including array-to-pointer decay from T *[N] to T **. Phase 5A begins aggregate types with named struct definitions, local struct objects, int members, deterministic member layout, and dot-member lvalues/rvalues. Phase 5B adds pointers to named structs, address-of struct objects, typed struct-pointer assignment/initialization, and arrow-member lvalues/rvalues. Phase 5C gives struct members their own scalar/pointer type and byte offset, adding char members, int/char pointer members, packed byte-aware layout, and type-preserving dot/arrow access.
 *
 * Phase 2A expression grammar:
 *
 *   expression     := equality
 *   equality       := relational { ('==' | '!=') relational }
 *   relational     := additive { ('<' | '<=' | '>' | '>=') additive }
 *   additive       := multiplicative { ('+' | '-') multiplicative }
 *   multiplicative := unary { ('*' | '/' | '%') unary }
 *   unary          := ('+' | '-') unary | primary
 *   primary        := INTEGER | '(' expression ')'
 *
 * Expressions are currently constant-folded by the compiler.  The generated
 * program is still 16-bit real-mode flat binary, loaded at 0000:1000.  AX is
 * the return-value register and the standalone test program halts after main.
 */

#include <ctype.h>
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define X86CC_VERSION "0.0.56"

#ifndef X86CC_DEFAULT_INCLUDEDIR
#define X86CC_DEFAULT_INCLUDEDIR "include"
#endif

static int g_blackjack_target;
static int g_translation_unit_only;
static int g_relocatable_output;
#define MAX_SOURCE (16 * 1024 * 1024)


#define MAX_STRING_LITERALS 128
#define MAX_STRING_BYTES 1024

typedef struct {
    unsigned char bytes[MAX_STRING_BYTES];
    int len;
} StringLiteral;

static StringLiteral g_strings[MAX_STRING_LITERALS];
static int g_string_count;

static int intern_string_literal(const char **pp) {
    const char *p = *pp;
    StringLiteral *lit;
    int n = 0;
    if (*p != '"' || g_string_count >= MAX_STRING_LITERALS) return -1;
    lit = &g_strings[g_string_count];
    for (;;) {
        p++;
        while (*p && *p != '"') {
            int ch = (unsigned char)*p++;
            if (ch == '\\') {
                ch = (unsigned char)*p++;
                if (!ch) return -1;
                if (ch == 'x') {
                    int hi, lo;
                    hi = (unsigned char)*p++;
                    lo = (unsigned char)*p++;
                    if (!isxdigit(hi) || !isxdigit(lo)) return -1;
                    hi = isdigit(hi) ? hi - '0' : 10 + (tolower(hi) - 'a');
                    lo = isdigit(lo) ? lo - '0' : 10 + (tolower(lo) - 'a');
                    ch = (hi << 4) | lo;
                }
                else if (ch == 'n') ch = '\n';
                else if (ch == 'r') ch = '\r';
                else if (ch == 't') ch = '\t';
                else if (ch == 'b') ch = '\b';
                else if (ch == 'a') ch = '\a';
                else if (ch == 'f') ch = '\f';
                else if (ch == 'v') ch = '\v';
                else if (ch >= '0' && ch <= '7') {
                    /* C octal escape: one to three octal digits total. */
                    int v = ch - '0';
                    int k;
                    for (k = 0; k < 2 && *p >= '0' && *p <= '7'; k++)
                        v = (v << 3) + (*p++ - '0');
                    ch = v & 0xFF;
                }
                else if (ch == '\\') ch = '\\';
                else if (ch == '"') ch = '"';
                else return -1;
            }
            if (n + 1 >= MAX_STRING_BYTES) return -1;
            lit->bytes[n++] = (unsigned char)ch;
        }
        if (*p != '"') return -1;
        p++;
        while (isspace((unsigned char)*p)) p++;
        if (*p != '"') break;
    }
    lit->bytes[n++] = 0;
    lit->len = n;
    *pp = p;
    return g_string_count++;
}

static void emit_string_pool(FILE *out) {
    int i, j;
    const int bytes_per_db = 16;
    if (!g_string_count) return;
    fprintf(out, "\n; Phase 4G compiler-owned string data\n");
    for (i = 0; i < g_string_count; i++) {
        fprintf(out, ".Lstr_%d:\n", i);
        for (j = 0; j < g_strings[i].len; j++) {
            if ((j % bytes_per_db) == 0) fprintf(out, "    db ");
            else fprintf(out, ",");
            fprintf(out, "0x%02X", (unsigned)g_strings[i].bytes[j]);
            if ((j % bytes_per_db) == bytes_per_db - 1 || j == g_strings[i].len - 1)
                fprintf(out, "\n");
        }
    }
}

typedef struct {
    const char *p;
    int ok;
} Expr;

static void skip_ws(Expr *e) {
    while (isspace((unsigned char)*e->p)) e->p++;
}

static long parse_expression(Expr *e);

static long parse_number(Expr *e) {
    char *end = NULL;
    long v;

    skip_ws(e);
    errno = 0;
    v = strtol(e->p, &end, 0);
    if (end == e->p || errno != 0) {
        e->ok = 0;
        return 0;
    }
    e->p = end;
    return v;
}

static long parse_primary(Expr *e) {
    long value;

    skip_ws(e);
    if (!e->ok) return 0;

    if (*e->p == '(') {
        e->p++;
        value = parse_expression(e);
        skip_ws(e);
        if (!e->ok || *e->p != ')') {
            e->ok = 0;
            return 0;
        }
        e->p++;
        return value;
    }

    return parse_number(e);
}

static long parse_unary(Expr *e) {
    skip_ws(e);
    if (!e->ok) return 0;

    if (*e->p == '+') {
        e->p++;
        return parse_unary(e);
    }
    if (*e->p == '-') {
        e->p++;
        return -parse_unary(e);
    }
    if (*e->p == '!') {
        e->p++;
        return !parse_unary(e);
    }
    if (*e->p == '~') {
        e->p++;
        return ~parse_unary(e);
    }

    return parse_primary(e);
}

static long parse_multiplicative(Expr *e) {
    long value = parse_unary(e);

    while (e->ok) {
        long rhs;
        char op;

        skip_ws(e);
        if (*e->p != '*' && *e->p != '/' && *e->p != '%') break;

        op = *e->p++;
        rhs = parse_unary(e);
        if (!e->ok) return 0;
        if ((op == '/' || op == '%') && rhs == 0) {
            e->ok = 0;
            return 0;
        }
        if (op == '*') value *= rhs;
        else if (op == '/') value /= rhs;
        else value %= rhs;
    }

    return value;
}

static long parse_additive(Expr *e) {
    long value = parse_multiplicative(e);

    while (e->ok) {
        long rhs;
        char op;

        skip_ws(e);
        if (*e->p != '+' && *e->p != '-') break;

        op = *e->p++;
        rhs = parse_multiplicative(e);
        if (!e->ok) return 0;
        value = (op == '+') ? value + rhs : value - rhs;
    }

    return value;
}

static long parse_relational(Expr *e) {
    long value = parse_additive(e);

    while (e->ok) {
        long rhs;
        int op = 0;

        skip_ws(e);
        if (!strncmp(e->p, "<=", 2)) { op = 1; e->p += 2; }
        else if (!strncmp(e->p, ">=", 2)) { op = 2; e->p += 2; }
        else if (*e->p == '<') { op = 3; e->p++; }
        else if (*e->p == '>') { op = 4; e->p++; }
        else break;

        rhs = parse_additive(e);
        if (!e->ok) return 0;
        if (op == 1) value = (value <= rhs);
        else if (op == 2) value = (value >= rhs);
        else if (op == 3) value = (value < rhs);
        else value = (value > rhs);
    }
    return value;
}

static long parse_equality(Expr *e) {
    long value = parse_relational(e);

    while (e->ok) {
        long rhs;
        int is_equal;

        skip_ws(e);
        if (!strncmp(e->p, "==", 2)) { is_equal = 1; e->p += 2; }
        else if (!strncmp(e->p, "!=", 2)) { is_equal = 0; e->p += 2; }
        else break;

        rhs = parse_relational(e);
        if (!e->ok) return 0;
        value = is_equal ? (value == rhs) : (value != rhs);
    }
    return value;
}

static long parse_expression(Expr *e) {
    return parse_equality(e);
}

static long parse_return_expression(const char *s, int *ok) {
    Expr e = { s, 1 };
    long value = parse_expression(&e);

    skip_ws(&e);
    if (*e.p != '\0') e.ok = 0;
    *ok = e.ok;
    return value;
}

static char *read_file(const char *path) {
    FILE *f;
    long n;
    char *buf;

    f = fopen(path, "rb");
    if (!f) return NULL;
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }
    n = ftell(f);
    if (n < 0 || n > MAX_SOURCE) { fclose(f); return NULL; }
    rewind(f);
    buf = (char *)malloc((size_t)n + 1);
    if (!buf) { fclose(f); return NULL; }
    if (n && fread(buf, 1, (size_t)n, f) != (size_t)n) {
        free(buf);
        fclose(f);
        return NULL;
    }
    buf[n] = '\0';
    fclose(f);
    return buf;
}

/* Phase 6A: accept the C storage/type qualifiers needed by portable small-C
 * sources.  For the current single-translation-unit flat-image model,
 * 'static' does not change linkage yet and 'const' does not change object
 * representation.  Blank the tokens (rather than squeezing the source) so
 * later parsers can consume the declarations normally. */
typedef struct { char name[64]; char value[1024]; } ObjectMacro;
static int expand_object_text(const char *in, char *out, size_t outsz,
                              ObjectMacro *macros, int nmac, int depth);
static int pp_eval_if_expr(const char *q, const char *end, ObjectMacro *macros, int nmac)
{
    char expr[4096]; size_t w=0;
    while(q<end) {
        if(isspace((unsigned char)*q)){if(w+2>=sizeof(expr))return 0;expr[w++]=*q++;continue;}
        if(end-q>=7&&!strncmp(q,"defined",7)&&(q+7==end||!(isalnum((unsigned char)q[7])||q[7]=='_'))) {
            char n[64];size_t z=0;int m,found=0;q+=7;while(q<end&&isspace((unsigned char)*q))q++;if(q<end&&*q=='('){q++;while(q<end&&isspace((unsigned char)*q))q++;}
            while(q<end&&(isalnum((unsigned char)*q)||*q=='_')&&z+1<sizeof(n))
                n[z++]=*q++;
            n[z]=0;
            while(q<end&&isspace((unsigned char)*q))q++;
            if(q<end&&*q==')')q++;
            for(m=nmac-1;m>=0;m--)
                if(!strcmp(macros[m].name,n)){found=1;break;}
            if(w+2>=sizeof(expr))return 0;
            expr[w++]=found?'1':'0';
            continue;
        }
        if(isalpha((unsigned char)*q)||*q=='_') {
            char n[64], expanded[4096];size_t z=0;int m;const char *v="0";while(q<end&&(isalnum((unsigned char)*q)||*q=='_')){if(z+1<sizeof(n))n[z++]=*q;q++;}n[z]=0;
            for(m=nmac-1;m>=0;m--)if(!strcmp(macros[m].name,n)){v=macros[m].value[0]?macros[m].value:"0";break;}
            if(m>=0){if(!expand_object_text(v,expanded,sizeof(expanded),macros,nmac,0))return 0;v=expanded;}
            z=strlen(v);if(w+z+1>=sizeof(expr))return 0;memcpy(expr+w,v,z);w+=z;continue;
        }
        if(w+2>=sizeof(expr))return 0;
        expr[w++]=*q++;
    }
    expr[w]=0;{Expr e={expr,1};long v=parse_expression(&e);skip_ws(&e);return e.ok&&!*e.p&&v!=0;}
}

static int expand_object_text(const char *in, char *out, size_t outsz,
                              ObjectMacro *macros, int nmac, int depth)
{
    size_t r=0,w=0;
    if (depth > 32) return 0;
    while (in[r]) {
        if (isalpha((unsigned char)in[r]) || in[r]=='_') {
            size_t j=r+1; int m,hit=-1;
            while (isalnum((unsigned char)in[j]) || in[j]=='_') j++;
            for (m=nmac-1;m>=0;m--)
                if (strlen(macros[m].name)==j-r && !strncmp(in+r,macros[m].name,j-r)) { hit=m; break; }
            if (hit>=0) {
                char tmp[4096];
                if (!expand_object_text(macros[hit].value,tmp,sizeof(tmp),macros,nmac,depth+1)) return 0;
                { size_t z=strlen(tmp); if(w+z+1>=outsz)return 0; memcpy(out+w,tmp,z);w+=z; }
            } else {
                if(w+j-r+1>=outsz)return 0;
                memcpy(out+w,in+r,j-r);
                w+=j-r;
            }
            r=j;
        } else {
            if(w+2>=outsz)return 0;
            out[w++]=in[r++];
        }
    }
    out[w]=0; return 1;
}
typedef struct {
    char name[64];
    char params[32][64];
    int nparams;
    int variadic;
    char value[65536];
} FunctionMacro;

/* Expand a macro replacement as preprocessing tokens, then rescan the result.
 * This is intentionally independent of the line/directive driver: directives
 * collect macro definitions; this routine implements the recursive expansion
 * semantics used by ordinary source tokens and macro arguments. */
static int macro_disabled(const char *set, const char *name, size_t n)
{
    const char *p=set;
    while(p && *p) {
        const char *e=strchr(p,';'); size_t z=e?(size_t)(e-p):strlen(p);
        if(z==n && !strncmp(p,name,n)) return 1;
        if(!e) break;
        p=e+1;
    }
    return 0;
}
static char g_pp_raw[33][32][4096];
static char g_pp_expa[33][32][4096];
static char g_pp_repl[33][16384];
static char g_pp_resc[33][16384];
static char g_pp_tmp[33][16384];
static char g_pp_str[33][8192];

static int stringify_macro_arg(const char *in, char *out, size_t outsz)
{
    const char *p=in, *end=in+strlen(in);
    size_t w=0;
    int pending_space=0;
    while(p<end && isspace((unsigned char)*p)) p++;
    while(end>p && isspace((unsigned char)end[-1])) end--;
    if(outsz<3) return 0;
    out[w++]='"';
    while(p<end) {
        unsigned char ch=(unsigned char)*p++;
        if(isspace(ch)) { pending_space=1; continue; }
        if(pending_space && w>1) { if(w+2>=outsz)return 0; out[w++]=' '; }
        pending_space=0;
        if(ch=='\\' || ch=='"') { if(w+2>=outsz)return 0; out[w++]='\\'; }
        if(w+2>=outsz)return 0;
        out[w++]=(char)ch;
    }
    out[w++]='"';
    out[w]=0;
    return 1;
}

static int expand_macro_text(const char *in, char *out, size_t outsz,
                             ObjectMacro *macros, int nmac,
                             FunctionMacro *fmacros, int nfmac, int depth,
                             const char *disabled)
{
    size_t r=0,w=0;
    if (depth < 0 || depth > 32) {
        fprintf(stderr,"x86-cc: pp rescan depth exceeded near %.120s [disabled=%s]\n",
                in, disabled ? disabled : "");
        return 0;
    }
    while (in[r]) {
        if(in[r]=='/' && in[r+1]=='/') { while(in[r] && in[r]!='\n'){if(w+2>=outsz)return 0;out[w++]=in[r++];} continue; }
        if(in[r]=='/' && in[r+1]=='*') { if(w+3>=outsz)return 0;out[w++]=in[r++];out[w++]=in[r++];while(in[r]&&!(in[r]=='*'&&in[r+1]=='/')){if(w+2>=outsz)return 0;out[w++]=in[r++];}if(in[r]){if(w+3>=outsz)return 0;out[w++]=in[r++];out[w++]=in[r++];}continue; }
        if (in[r]=='"' || in[r]=='\'') {
            int q=(unsigned char)in[r];
            do {
                if(w+2>=outsz)return 0;
                out[w++]=in[r];
                if(in[r]=='\\' && in[r+1]) { r++; if(w+2>=outsz)return 0; out[w++]=in[r]; }
                r++;
            } while(in[r] && in[r-1]!=q);
            continue;
        }
        if (isalpha((unsigned char)in[r]) || in[r]=='_') {
            size_t j=r+1, k; int m,oh=-1,fh=-1;
            while(isalnum((unsigned char)in[j])||in[j]=='_')j++;
            for(m=nfmac-1;m>=0;m--) if(strlen(fmacros[m].name)==j-r&&!strncmp(in+r,fmacros[m].name,j-r) && !macro_disabled(disabled,in+r,j-r)){fh=m;break;}
            k=j; while(isspace((unsigned char)in[k]))k++;
            if(fh>=0 && in[k]=='(') {
                char (*raw)[4096]=g_pp_raw[depth];
                char (*expa)[4096]=g_pp_expa[depth];
                char *repl=g_pp_repl[depth], *resc=g_pp_resc[depth];
                size_t a=k+1,as=a,rw=0; int dep=1,aq=0,na=0,ai;
                while(in[a]&&dep) {
                    int ch=(unsigned char)in[a];
                    if(aq){if(ch=='\\'&&in[a+1]){a+=2;continue;}if(ch==aq)aq=0;a++;continue;}
                    if(ch=='"'||ch=='\''){aq=ch;a++;continue;}
                    if(ch=='(')dep++;
                    else if(ch==')'){dep--;if(!dep)break;}
                    else if(ch==','&&dep==1){
                        size_t z=a-as;while(z&&isspace((unsigned char)in[as+z-1]))z--;while(z&&isspace((unsigned char)in[as])){as++;z--;}
                        if(na>=32||z>=sizeof(raw[0]))return 0;
                        memcpy(raw[na],in+as,z);
                        raw[na][z]=0;
                        na++;
                        as=a+1;
                    }
                    a++;
                }
                if(dep)return 0;
                if(a>as||fmacros[fh].nparams){size_t z=a-as;while(z&&isspace((unsigned char)in[as+z-1]))z--;while(z&&isspace((unsigned char)in[as])){as++;z--;}if(na>=32||z>=sizeof(raw[0]))return 0;memcpy(raw[na],in+as,z);raw[na][z]=0;na++;}
                {int fixed=fmacros[fh].nparams-(fmacros[fh].variadic?1:0);if((!fmacros[fh].variadic&&na!=fixed)||(fmacros[fh].variadic&&na<fixed)){fprintf(stderr,"x86-cc: pp macro %s expects %d%s args, got %d near %.80s\n",fmacros[fh].name,fixed,fmacros[fh].variadic?"+":"",na,in+r);return 0;}}
                for(ai=0;ai<na;ai++)if(!expand_macro_text(raw[ai],expa[ai],sizeof(expa[ai]),macros,nmac,fmacros,nfmac,depth+1,disabled))return 0;
                { const char *rv=fmacros[fh].value; size_t x=0;
                  while(rv[x]) {
                    if(rv[x]=='#'&&rv[x+1]=='#') {
                        while(rw&&isspace((unsigned char)repl[rw-1]))rw--;
                        x+=2;
                        while(isspace((unsigned char)rv[x]))x++;
                        if(isalpha((unsigned char)rv[x])||rv[x]=='_') {
                            size_t t=x+1,z;int ph=-1;while(isalnum((unsigned char)rv[t])||rv[t]=='_')t++;
                            for(ai=0;ai<fmacros[fh].nparams;ai++)if(strlen(fmacros[fh].params[ai])==t-x&&!strncmp(rv+x,fmacros[fh].params[ai],t-x)){ph=ai;break;}
                            if(ph>=0){z=strlen(raw[ph]);if(rw+z+1>=16384)return 0;memcpy(repl+rw,raw[ph],z);rw+=z;x=t;continue;}
                        }
                        continue;
                    }
                    if(rv[x]=='#') {
                        size_t y=x+1;while(isspace((unsigned char)rv[y]))y++;
                        if(isalpha((unsigned char)rv[y])||rv[y]=='_') {
                            size_t t=y+1,z;int ph=-1;while(isalnum((unsigned char)rv[t])||rv[t]=='_')t++;
                            for(ai=0;ai<fmacros[fh].nparams;ai++)if(strlen(fmacros[fh].params[ai])==t-y&&!strncmp(rv+y,fmacros[fh].params[ai],t-y)){ph=ai;break;}
                            if(ph>=0){char *sq=g_pp_str[depth];if(!stringify_macro_arg(raw[ph],sq,8192))return 0;z=strlen(sq);if(rw+z+1>=16384)return 0;memcpy(repl+rw,sq,z);rw+=z;x=t;continue;}
                        }
                    }
                    if(isalpha((unsigned char)rv[x])||rv[x]=='_') {
                        size_t t=x+1,z;int ph=-1;while(isalnum((unsigned char)rv[t])||rv[t]=='_')t++;
                        for(ai=0;ai<fmacros[fh].nparams;ai++)if(strlen(fmacros[fh].params[ai])==t-x&&!strncmp(rv+x,fmacros[fh].params[ai],t-x)){ph=ai;break;}
                        if(ph>=0){
                            int pasted=(x>=2&&rv[x-1]=='#'&&rv[x-2]=='#')||(rv[t]=='#'&&rv[t+1]=='#');
                            if(fmacros[fh].variadic && ph==fmacros[fh].nparams-1) {
                                int vi, fixed=fmacros[fh].nparams-1;
                                for(vi=fixed;vi<na;vi++) {
                                    const char *av=pasted?raw[vi]:expa[vi];
                                    z=strlen(av);
                                    if(vi>fixed) { if(rw+2>=16384)return 0; repl[rw++]=','; }
                                    if(rw+z+1>=16384)return 0;
                                    memcpy(repl+rw,av,z); rw+=z;
                                }
                            } else {
                                const char *av=pasted?raw[ph]:expa[ph];
                                z=strlen(av);if(rw+z+1>=16384)return 0;memcpy(repl+rw,av,z);rw+=z;
                            }
                            x=t;continue;
                        }
