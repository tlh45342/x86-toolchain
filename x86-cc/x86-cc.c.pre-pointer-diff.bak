static int alias_find(const char *name) {
    int i;
    for (i = 0; i < g_alias_count; i++) if (!strcmp(g_aliases[i].name, name)) return i;
    return -1;
}

static int alias_add(const char *name, int is_char, int width) {
    int i = alias_find(name);
    if (i >= 0) return g_aliases[i].is_char == is_char && g_aliases[i].width == width;
    if (g_alias_count >= 512) return 0;
    snprintf(g_aliases[g_alias_count].name, sizeof(g_aliases[g_alias_count].name), "%s", name);
    g_aliases[g_alias_count].is_char = is_char;
    g_aliases[g_alias_count].width = width;
    g_aliases[g_alias_count].struct_tag[0] = 0;
    g_alias_count++;
    return 1;
}

static int alias_add_struct(const char *name, const char *tag) {
    int i = alias_find(name);
    if (i >= 0) return !strcmp(g_aliases[i].struct_tag, tag);
    if (g_alias_count >= 512) return 0;
    snprintf(g_aliases[g_alias_count].name, sizeof(g_aliases[g_alias_count].name), "%s", name);
    g_aliases[g_alias_count].is_char = 0;
    g_aliases[g_alias_count].width = 0; /* resolved after struct definitions are scanned */
    snprintf(g_aliases[g_alias_count].struct_tag, sizeof(g_aliases[g_alias_count].struct_tag), "%s", tag);
    g_alias_count++;
    return 1;
}

static void splice_backslash_newlines(char *s) {
    char *r=s, *w=s;
    while (*r) {
        if (r[0]=='\\' && r[1]=='\r' && r[2]=='\n') { r+=3; continue; }
        if (r[0]=='\\' && r[1]=='\n') { r+=2; continue; }
        *w++=*r++;
    }
    *w=0;
}

static void flatten_paren_newlines(char *s) {
    char *p=s; int depth=0, quote=0, block=0;
    while(*p) {
        if(block){ if(p[0]=='*'&&p[1]=='/'){block=0;p+=2;continue;} p++;continue; }
        if(quote){ if(*p=='\\'&&p[1]){p+=2;continue;} if(*p==quote)quote=0; p++;continue; }
        if(p[0]=='/'&&p[1]=='*'){block=1;p+=2;continue;}
        if(*p=='"'||*p=='\''){quote=(unsigned char)*p;p++;continue;}
        if(*p=='(')depth++;
        else if(*p==')'&&depth>0)depth--;
        else if((*p=='\n'||*p=='\r')&&depth>0)*p=' ';
        p++;
    }
}

static int preprocess_object_macros(char **psrc) {
