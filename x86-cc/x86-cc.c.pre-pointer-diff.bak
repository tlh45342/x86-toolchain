                bytes=g_structs[b->locals[idx].struct_id].size_bytes;
                fprintf(b->out,"    mov si, ax\n");
                emit_local_address(b->out,b->locals[idx].offset); fprintf(b->out,"    mov bx, ax\n");
                for(off=0;off+1<bytes;off+=2)fprintf(b->out,"    mov ax, [si+%d]\n    mov [bx+%d], ax\n",off,off);
                if(bytes&1)fprintf(b->out,"    mov al, [si+%d]\n    mov [bx+%d], al\n",bytes-1,bytes-1);
