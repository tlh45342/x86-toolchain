                if (cop == '+') fprintf(b->out, "    add ax, cx\n");
                else if (cop == '-') fprintf(b->out, "    sub ax, cx\n");
                else if (cop == '*') fprintf(b->out, "    mul cx\n");
                else if (cop == '^') fprintf(b->out, "    xor ax, cx\n");
                else if (cop == '&') fprintf(b->out, "    and ax, cx\n");
                else if (cop == '|') fprintf(b->out, "    or ax, cx\n");
                else { fprintf(b->out, "    xor dx, dx\n    div cx\n"); if (cop == '%') fprintf(b->out, "    mov ax, dx\n"); }
                }
            } else {
                if (*b->p != '=') {
                    b->p = statement_start;
                    b->ok = 1;
                    goto expression_statement;
                }
                b->p++;
                if (lv_struct_id >= 0 && !lv_is_pointer) {
                    const char *rhs_save=b->p; char rhs_name[64]; int ri,rgi,bytes;
                    body_ws(b);
                    if(body_ident(b,rhs_name,sizeof(rhs_name))){
                        ri=local_find(b,rhs_name); rgi=global_find(rhs_name);
                        body_ws(b);
                        if((*b->p=='[' || *b->p=='.' || !strncmp(b->p,"->",2))) {
                            int rp=0,rc=0,rs=-1;
                            b->p=rhs_save;
                            if(!cg_lvalue_address(b,&rp,&rc,&rs) || rp || rs!=lv_struct_id){b->ok=0;return;}
                            body_ws(b);if(*b->p!=';'){b->ok=0;return;}
                            bytes=g_structs[lv_struct_id].size_bytes;
                        } else if((ri>=0 && b->locals[ri].struct_id==lv_struct_id && !b->locals[ri].is_pointer && !b->locals[ri].array_len) ||
                                  (ri<0 && rgi>=0 && g_globals[rgi].struct_id==lv_struct_id && !g_globals[rgi].is_pointer && !g_globals[rgi].array_len)){
                            if(*b->p!=';'){b->ok=0;return;}
                            bytes=g_structs[lv_struct_id].size_bytes;
                            if(ri>=0)emit_local_address(b->out,b->locals[ri].offset);else fprintf(b->out,"    mov ax, .G_%s\n",rhs_name);
                        } else { b->p=rhs_save; goto aggregate_rhs_failed; }
                        fprintf(b->out,"    mov si, ax\n    pop bx\n");
                        {
                            int copyoff;
                            for(copyoff=0;copyoff+1<bytes;copyoff+=2)fprintf(b->out,"    mov ax, [si+%d]\n    mov [bx+%d], ax\n",copyoff,copyoff);
                            if(bytes&1)fprintf(b->out,"    mov al, [si+%d]\n    mov [bx+%d], al\n",bytes-1,bytes-1);
                        }
                        b->p++;return;
aggregate_rhs_failed:
                        ;
                    }
                    b->p=rhs_save;
                }
                cg_expr(b);
            }
            if (!b->ok ||
                (lv_is_pointer ? (b->expr_is_pointer != lv_is_pointer && !(b->expr_is_pointer == 0 && b->expr_is_null_constant))
                               : b->expr_is_pointer != 0) ||
                (lv_is_pointer && b->expr_is_pointer && !pointer_char_compatible(lv_is_char, b->expr_pointer_char)) ||
                (lv_struct_id >= 0 && b->expr_is_pointer && b->expr_struct_id != lv_struct_id)) { b->ok = 0; return; }
            fprintf(b->out, "    pop bx\n");
            if (lv_is_char && !lv_is_pointer) fprintf(b->out, lv_is_far ? "    mov [es:bx], al\n" : "    mov [bx], al\n");
            else if (!lv_is_pointer && lv_width == 4) {
                if (b->expr_width != 4) fprintf(b->out, "    xor dx, dx\n");
                if (lv_is_far) fprintf(b->out, "    mov [es:bx], ax\n    mov [es:bx+2], dx\n");
                else fprintf(b->out, "    mov [bx], ax\n    mov [bx+2], dx\n");
            } else fprintf(b->out, lv_is_far ? "    mov [es:bx], ax\n" : "    mov [bx], ax\n");
            body_ws(b);
            if (*b->p == ',') { b->p++; cg_statement(b, saw_return); return; }
            if (*b->p != ';') { b->ok = 0; return; }
            b->p++;
            return;
        }
    }
    b->p = statement_start;
    b->ok = 1;

expression_statement:
    /* Expression statements are ordinary C too: function calls and casts
     * need not be disguised as assignments merely to discard their value. */
    {
        const char *expr_start = b->p;
        b->ok = 1;
        cg_expr(b);
        if (b->ok) {
            body_ws(b);
            if (*b->p == ',') { b->p++; cg_statement(b, saw_return); return; }
            if (*b->p == ';') {
                b->p++;
                return;
            }
        }
        b->p = expr_start;
    }
    b->ok = 0;
}

static int emit_locals_program(FILE *out, const char *input, const char *body) {
    BodyParser b;
    int frame = count_local_slots(body) * 2;
    int saw_return = 0;

    g_string_count = 0;
    memset(&b, 0, sizeof(b));
    b.expr_struct_id = -1;
    b.p = body;
    b.ok = 1;
    b.out = out;

    fprintf(out, "; generated by x86-cc %s from %s\n", X86CC_VERSION, input);
    fprintf(out, "cpu 8086\nbits 16\norg 0x1000\n\n_start:\n");
    fprintf(out, "    push bp\n    mov bp, sp\n");
    { int i; for (i = 0; i < frame / 2; i++) fprintf(out, "    push ax\n"); }

    while (b.ok) {
        body_ws(&b);
        if (*b.p == '}') break;
        if (*b.p == '\0') { b.ok = 0; break; }
        cg_statement(&b, &saw_return);
    }

    if (!b.ok || !saw_return || b.total_locals != frame / 2) {
        fprintf(stderr, "x86-cc: error: invalid Phase 5B statement or expression\n");
        return 0;
    }
    fprintf(out, ".Lreturn:\n");
    fprintf(out, "    mov sp, bp\n    pop bp\n    hlt\n");
    emit_string_pool(out);
    return 1;
}


static int scan_global_objects(const char *src) {
    const char *p = src;
    int depth = 0, paren_depth = 0;
    g_global_count = 0;
    while (*p) {
        const char *q;
        int is_char = 0, type_width = 0, type_struct_id = -1, type_far = 0;
        if (p[0]=='/' && p[1]=='*') { const char *ce=strstr(p+2,"*/"); if(!ce)return 0; p=ce+2; continue; }
        if (p[0]=='/' && p[1]=='/') { while(*p && *p!='\n')p++; continue; }
        if (*p=='\"' || *p=='\'') { int qc=*p++,esc=0; while(*p){ if(esc)esc=0;else if(*p=='\\')esc=1;else if(*p==qc){p++;break;}p++; } continue; }
        if (*p == '(') { paren_depth++; p++; continue; }
        if (*p == ')') { if (paren_depth) paren_depth--; p++; continue; }
        if (*p == '{') { depth++; p++; continue; }
        if (*p == '}') { if (depth) depth--; p++; continue; }
        if (depth || paren_depth) { p++; continue; }
        q=p;
        { int is_extern_decl=0;
        if (!strncmp(q,"extern",6) && isspace((unsigned char)q[6])) is_extern_decl=1;
        while ((!strncmp(q,"static",6) && isspace((unsigned char)q[6])) ||
               (!strncmp(q,"extern",6) && isspace((unsigned char)q[6])) ||
               (!strncmp(q,"const",5) && isspace((unsigned char)q[5])) ||
               (!strncmp(q,"inline",6) && isspace((unsigned char)q[6])) ||
               (!strncmp(q,"volatile",8) && isspace((unsigned char)q[8]))) {
            if (!strncmp(q,"extern",6)) { is_extern_decl=1; q+=6; }
            else if (!strncmp(q,"const",5)) q+=5; else if(!strncmp(q,"volatile",8)) q+=8; else q+=6;
            while(isspace((unsigned char)*q))q++;
        }
        if ((!strncmp(q,"unsigned",8) && isspace((unsigned char)q[8])) || (!strncmp(q,"signed",6) && isspace((unsigned char)q[6]))) {
            q += !strncmp(q,"unsigned",8) ? 8 : 6; while(isspace((unsigned char)*q))q++;
        }
        if (!strncmp(q, "int", 3) && isspace((unsigned char)q[3])) { q += 3; type_width=2; }
        else if (!strncmp(q, "short", 5) && isspace((unsigned char)q[5])) { q += 5; while(isspace((unsigned char)*q))q++; if(!strncmp(q,"int",3) && !(isalnum((unsigned char)q[3])||q[3]=='_'))q+=3; type_width=2; }
        else if (!strncmp(q, "char", 4) && isspace((unsigned char)q[4])) { q += 4; is_char = 1; type_width=1; }
        else if (!strncmp(q, "long", 4) && isspace((unsigned char)q[4])) { q += 4; while(isspace((unsigned char)*q))q++; if(!strncmp(q,"int",3) && !(isalnum((unsigned char)q[3])||q[3]=='_')) q+=3; type_width=4; }
        else if (!strncmp(q, "float", 5) && isspace((unsigned char)q[5])) { q += 5; type_width=4; }
        else if (!strncmp(q, "double", 6) && isspace((unsigned char)q[6])) { q += 6; type_width=8; }
        else if (!strncmp(q, "bool", 4) && isspace((unsigned char)q[4])) { q += 4; type_width=1; }
        else if (!strncmp(q, "_Bool", 5) && isspace((unsigned char)q[5])) { q += 5; type_width=1; }
        else if (!strncmp(q, "void", 4) && isspace((unsigned char)q[4])) { q += 4; type_width=0; }
        else if (!strncmp(q, "enum", 4) && isspace((unsigned char)q[4])) { q+=4; while(isspace((unsigned char)*q))q++; while(isalnum((unsigned char)*q)||*q=='_')q++; type_width=2; }
        else if (!strncmp(q, "struct", 6) && isspace((unsigned char)q[6])) { char tag[64];size_t tn=0;int si;q+=6;while(isspace((unsigned char)*q))q++;while((isalnum((unsigned char)*q)||*q=='_')&&tn+1<sizeof(tag))tag[tn++]=*q++;tag[tn]=0;si=struct_find(tag);if(si<0){p++;continue;}type_width=g_structs[si].size_bytes; type_struct_id=si; }
        else if (isalpha((unsigned char)*q) || *q=='_') {
            char tname[64]; size_t tn=0; int ai; while((isalnum((unsigned char)*q)||*q=='_')&&tn+1<sizeof(tname)) tname[tn++]=*q++;
            tname[tn]=0; ai=alias_find(tname); if(ai<0){p++;continue;}
            is_char=g_aliases[ai].is_char; type_width=g_aliases[ai].width;
            if(g_aliases[ai].struct_tag[0]) { int si=struct_find(g_aliases[ai].struct_tag); type_width=(si>=0)?g_structs[si].size_bytes:0; type_struct_id=si; }
        } else { p++; continue; }
        /* Once a declaration prefix was recognized, this pass owns it.
         * Do not let the outer character scanner rediscover the same
         * declaration after its storage-class specifier. */
        while (isspace((unsigned char)*q)) q++;
        while ((!strncmp(q,"const",5) && !(isalnum((unsigned char)q[5])||q[5]=='_')) ||
               (!strncmp(q,"volatile",8) && !(isalnum((unsigned char)q[8])||q[8]=='_')) ||
               (!strncmp(q,"restrict",8) && !(isalnum((unsigned char)q[8])||q[8]=='_'))) {
            if (!strncmp(q,"const",5)) q+=5; else q+=8;
            while (isspace((unsigned char)*q)) q++;
        }
        if (!strncmp(q,"far",3) && !(isalnum((unsigned char)q[3])||q[3]=='_')) {
            type_far=1; q+=3; while(isspace((unsigned char)*q))q++;
        }
        /* Type definitions are owned by the aggregate/enum scanners, not by
         * the global-object pass.  Skip their balanced body and trailing ';'. */
        if (*q == '{') {
            int bd=1; q++;
            while (*q && bd) { if(*q=='{')bd++; else if(*q=='}')bd--; q++; }
            if (!bd) {
                /* Aggregate/enum scanners own the definition.  A typedef may
                   have a trailing declarator between the closing brace and ;. */
                while (*q && *q!=';') q++;
                if (*q==';') { p=q+1; continue; }
            }
            fprintf(stderr,"x86-cc: global: malformed type definition near %.140s\n",p); return 0;
        }
        {
            const char *probe=q; while (*probe=='*') { probe++; while(isspace((unsigned char)*probe)) probe++; }
            while (isalnum((unsigned char)*probe)||*probe=='_') probe++;
            for (;;) {
                while (isspace((unsigned char)*probe)) probe++;
                if (probe[0]=='/' && probe[1]=='*') {
                    const char *ce=strstr(probe+2,"*/"); if(!ce)return 0; probe=ce+2; continue;
                }
                break;
            }
            if (*probe=='(') {
                int pd=1; probe++;
                while (*probe && pd) { if(*probe=='(') pd++; else if(*probe==')') pd--; probe++; }
                if (!pd) {
                    while (isspace((unsigned char)*probe)) probe++;
                    if (*probe == '{') {
                        int bd=1; probe++;
                        while (*probe && bd) {
                            if (probe[0]=='/'&&probe[1]=='*'){const char *ce=strstr(probe+2,"*/");if(!ce)return 0;probe=ce+2;continue;}
                            if (*probe=='\"'||*probe=='\''){int qc=*probe++,esc=0;while(*probe){if(esc)esc=0;else if(*probe=='\\')esc=1;else if(*probe==qc){probe++;break;}probe++;}continue;}
                            if(*probe=='{')bd++;else if(*probe=='}')bd--;probe++;
                        }
                        if (bd) return 0;
                    } else if (*probe==';') probe++;
                    p=probe; continue;
                }
                fprintf(stderr,"x86-cc: global: unbalanced function declarator near %.140s\n",p); return 0;
            }
        }
        if (type_width == 0) { fprintf(stderr,"x86-cc: global: non-object void declaration near %.140s\n",p); return 0; }
        for (;;) {
            int ptr=0, array_len=0, has_init=0; long init_value=0;
            char name[64]; size_t n=0;
            while (isspace((unsigned char)*q)) q++;
            while (*q=='*') { ptr++; q++; while(isspace((unsigned char)*q)) q++; }
            if (type_far && ptr != 1) { fprintf(stderr,"x86-cc: global: far currently requires exactly one pointer level near %.100s\n",q); return 0; }
            if (ptr>2 || !(isalpha((unsigned char)*q)||*q=='_')) { fprintf(stderr,"x86-cc: global: expected declarator near %.100s\n",q); return 0; }
            while ((isalnum((unsigned char)*q)||*q=='_') && n+1<sizeof(name)) name[n++]=*q++;
            name[n]=0; while(isspace((unsigned char)*q)) q++;
            if (*q=='[') {
                char *ep; long v; q++; while(isspace((unsigned char)*q)) q++;
                if (*q==']') {
                    q++; array_len=-1; /* extern incomplete, or definition completed by initializer */
                } else {
                    errno=0; v=strtol(q,&ep,0);
                    if(ep==q||errno||v<=0||v>32767) { fprintf(stderr,"x86-cc: global: unsupported array bound near %.100s\n",q); return 0; }
                    q=ep; while(isspace((unsigned char)*q)) q++;
                    if(*q++!=']') { fprintf(stderr,"x86-cc: global: missing ] after %s near %.100s\n",name,q); return 0; }
                    array_len=(int)v;
                }
                while(isspace((unsigned char)*q)) q++;
            }
            if (array_len < 0 && *q!='=' && !is_extern_decl) {
                fprintf(stderr,"x86-cc: global: incomplete array definition requires initializer near %s\n",name); return 0;
            }
            if (*q=='=') {
                char *ep;
                q++; while(isspace((unsigned char)*q)) q++;
                if (type_far && *q=='(') {
                    /* First far-pointer constant form: (T far *)0xSSSSOOOO.
                     * The 32-bit object stores offset in the low word and
                     * segment in the high word. */
                    const char *rp=strchr(q,')'); unsigned long long uv; char *ue;
                    if(!rp || !strstr(q,"far") || !memchr(q,'*',(size_t)(rp-q))) {
                        fprintf(stderr,"x86-cc: global: malformed far-pointer cast for %s near %.100s\n",name,q); return 0;
                    }
                    q=rp+1; while(isspace((unsigned char)*q))q++;
                    errno=0; uv=strtoull(q,&ue,0);
                    if(ue==q || errno || uv>0xFFFFFFFFULL) {
                        fprintf(stderr,"x86-cc: global: invalid far-pointer constant for %s near %.100s\n",name,q); return 0;
                    }
                    init_value=(long)(uint32_t)uv; has_init=1; q=ue;
                    while(*q=='u'||*q=='U'||*q=='l'||*q=='L')q++;
                    while(isspace((unsigned char)*q))q++;
                } else if (*q=='"' && !ptr && is_char && array_len) {
                    const char *sp=q;
                    int sid=intern_string_literal(&sp);
                    int ic,j,nbytes;
                    if(sid<0){fprintf(stderr,"x86-cc: global: invalid string initializer for %s near %.100s\n",name,q);return 0;}
                    nbytes=(int)g_strings[sid].len;
                    if(array_len<0) array_len=nbytes;
                    if(array_len<nbytes-1){fprintf(stderr,"x86-cc: global: string initializer too long for %s\n",name);return 0;}
                    ic=nbytes;
                    if(ic>array_len) ic=array_len; /* exact-size char a[N] may omit terminating NUL */
                    if(ic>64){fprintf(stderr,"x86-cc: global: initializer too large for %s\n",name);return 0;}
                    for(j=0;j<ic;j++) g_globals[g_global_count].init_values[j]=g_strings[sid].bytes[j];
                    g_globals[g_global_count].init_count=ic; has_init=1; q=sp;
                    while(isspace((unsigned char)*q))q++;
                } else if (*q=='{') {
                    int ic=0; q++;
                    if(ptr || type_width>4) { fprintf(stderr,"x86-cc: global: aggregate initializer type not yet supported for %s\n",name); return 0; }
                    for (;;) {
                        while(isspace((unsigned char)*q))q++;
                        if(*q=='}'){q++;break;}
                        if(ic>=64){fprintf(stderr,"x86-cc: global: initializer too large for %s\n",name);return 0;}
                        if (*q=='\'') {
                            const char *cp=q+1; int cv;
                            if (*cp=='\\') {
                                cp++;
                                if (*cp=='n') cv='\n';
                                else if (*cp=='r') cv='\r';
                                else if (*cp=='t') cv='\t';
                                else if (*cp=='0') cv=0;
                                else if (*cp=='\\') cv='\\';
                                else if (*cp=='\'') cv='\'';
                                else if (*cp=='\"') cv='\"';
                                else { fprintf(stderr,"x86-cc: global: unsupported character escape for %s near %.100s\n",name,q); return 0; }
                                cp++;
                            } else {
                                if (!*cp || *cp=='\'') { fprintf(stderr,"x86-cc: global: empty character constant for %s\n",name); return 0; }
                                cv=(unsigned char)*cp++;
                            }
                            if (*cp!='\'') { fprintf(stderr,"x86-cc: global: malformed character constant for %s near %.100s\n",name,q); return 0; }
                            init_value=cv; ep=(char *)(cp+1);
                        } else {
                            errno=0; init_value=strtol(q,&ep,0);
                            if(ep==q||errno){fprintf(stderr,"x86-cc: global: non-integer aggregate initializer for %s near %.100s\n",name,q);return 0;}
                        }
                        g_globals[g_global_count].init_values[ic++]=init_value; q=ep;
                        while(isspace((unsigned char)*q))q++;
                        if(*q==','){q++;continue;}
                        if(*q=='}'){q++;break;}
                        fprintf(stderr,"x86-cc: global: expected comma/} in initializer for %s\n",name);return 0;
                    }
                    if(array_len<0) array_len=ic;
                    if(array_len<ic){fprintf(stderr,"x86-cc: global: too many initializers for %s\n",name);return 0;}
                    g_globals[g_global_count].init_count=ic; has_init=1;
                    while(isspace((unsigned char)*q))q++;
                } else {
                    if (ptr && (isalpha((unsigned char)*q)||*q=='_')) {
                        size_t sn=0; long add=0;
                        while ((isalnum((unsigned char)*q)||*q=='_') && sn+1<sizeof(g_globals[g_global_count].init_symbol))
                            g_globals[g_global_count].init_symbol[sn++]=*q++;
                        g_globals[g_global_count].init_symbol[sn]=0;
                        while(isspace((unsigned char)*q))q++;
                        while (*q=='+' || *q=='-') {
                            int neg=(*q++=='-'); long v;
                            while(isspace((unsigned char)*q))q++;
                            errno=0; v=strtol(q,&ep,0);
                            if(ep==q||errno){fprintf(stderr,"x86-cc: global: bad pointer initializer addend for %s near %.100s\n",name,q);return 0;}
                            add += neg ? -v : v; q=ep; while(isspace((unsigned char)*q))q++;
                        }
                        g_globals[g_global_count].init_addend=add; has_init=1;
                    } else {
                        if(array_len || ptr || type_width > 2) { fprintf(stderr,"x86-cc: global: initializer not yet supported for %s near %.120s\n",name,q); return 0; }
                        if (!strncmp(q,"false",5) && !(isalnum((unsigned char)q[5])||q[5]=='_')) { init_value=0; q+=5; }
                        else if (!strncmp(q,"true",4) && !(isalnum((unsigned char)q[4])||q[4]=='_')) { init_value=1; q+=4; }
                        else { errno=0; init_value=strtol(q,&ep,0); if(ep==q||errno) { fprintf(stderr,"x86-cc: global: non-integer initializer for %s near %.120s\n",name,q); return 0; } q=ep; }
                        has_init=1; while(isspace((unsigned char)*q)) q++;
                    }
                }
            }
            if(is_extern_decl && !has_init) {
                if(g_global_count>=MAX_GLOBALS) { fprintf(stderr,"x86-cc: global: object table full at extern %s\n",name); return 0; }
                if(global_find(name)<0) {
                    snprintf(g_globals[g_global_count].name,sizeof(g_globals[g_global_count].name),"%s",name);
                    g_globals[g_global_count].is_pointer=ptr; g_globals[g_global_count].is_far=type_far; g_globals[g_global_count].is_char=is_char;
                    g_globals[g_global_count].width=type_far ? 4 : (ptr ? 2 : type_width);
                    g_globals[g_global_count].struct_id=type_struct_id; g_globals[g_global_count].array_len=array_len;
                    g_globals[g_global_count].has_init=0; g_globals[g_global_count].init_count=0; g_global_count++;
                }
                if(*q==',') { q++; continue; }
                if(*q!=';') { fprintf(stderr,"x86-cc: global: expected comma/semicolon after extern %s near %.100s\n",name,q); return 0; }
                p=q+1; break;
            }
            if(g_global_count>=MAX_GLOBALS) { fprintf(stderr,"x86-cc: global: object table full at %s\n",name); return 0; }
            if(global_find(name)>=0) { fprintf(stderr,"x86-cc: global: duplicate object %s near %.120s\n",name,p); return 0; }
            snprintf(g_globals[g_global_count].name,sizeof(g_globals[g_global_count].name),"%s",name);
            g_globals[g_global_count].is_pointer=ptr; g_globals[g_global_count].is_far=type_far; g_globals[g_global_count].is_char=is_char;
            g_globals[g_global_count].width=type_far ? 4 : (ptr ? 2 : type_width);
            g_globals[g_global_count].struct_id=type_struct_id;
            g_globals[g_global_count].array_len=array_len; g_globals[g_global_count].has_init=has_init;
            g_globals[g_global_count].init_value=init_value;
            if(!has_init) g_globals[g_global_count].init_count=0;
            g_global_count++;
            if(*q==',') { q++; continue; }
            if(*q!=';') { fprintf(stderr,"x86-cc: global: expected comma/semicolon after %s near %.100s [context %.140s]\n",name,q,p); return 0; }
            p=q+1; break;
        }
        }
    }
    return 1;
}

static void emit_global_pool(FILE *out) {
    int i;
    if (!g_global_count) return;
    fprintf(out, "\n; Phase 6B global/static storage\n");
    for (i = 0; i < g_global_count; i++) {
        int bytes = g_globals[i].array_len ? g_globals[i].array_len * g_globals[i].width : g_globals[i].width;
        fprintf(out, ".G_%s:\n", g_globals[i].name);
        if (g_globals[i].has_init) {
            if (g_globals[i].init_count) {
                int j;
                for(j=0;j<g_globals[i].init_count;j++) {
                    if(g_globals[i].width==1) fprintf(out,"    db %ld\n",g_globals[i].init_values[j]&255L);
                    else if(g_globals[i].width==2) fprintf(out,"    dw %ld\n",g_globals[i].init_values[j]&65535L);
                    else fprintf(out,"    dd %ld\n",g_globals[i].init_values[j]);
                }
                if(g_globals[i].array_len>g_globals[i].init_count)
                    fprintf(out,"    times %d db 0\n",(g_globals[i].array_len-g_globals[i].init_count)*g_globals[i].width);
            } else if (g_globals[i].init_symbol[0]) {
                fprintf(out, "    dw .G_%s", g_globals[i].init_symbol);
                if (g_globals[i].init_addend > 0) fprintf(out, " + %ld", g_globals[i].init_addend);
                else if (g_globals[i].init_addend < 0) fprintf(out, " - %ld", -g_globals[i].init_addend);
                fprintf(out, "\n");
            } else if (g_globals[i].is_far) { unsigned long fv=(unsigned long)(uint32_t)g_globals[i].init_value; fprintf(out, "    dw 0x%04lX\n    dw 0x%04lX\n", fv&0xFFFFUL, (fv>>16)&0xFFFFUL); }
            else if (g_globals[i].is_char) fprintf(out, "    db %ld\n", g_globals[i].init_value & 255L);
            else fprintf(out, "    dw %ld\n", g_globals[i].init_value & 65535L);
        } else {
            fprintf(out, "    times %d db 0\n", bytes);
        }
    }
}

typedef struct {
    char name[64];
    char params[16][64];
    int param_is_pointer[16];
    int param_is_char[16];
    int param_width[16];
    int param_struct_id[16]; /* Phase 5E: preserve named struct type on pointer parameters */
    int return_width;
    int return_pointer;
    int return_char;
    int return_struct_id;
    int nparams;
    int is_variadic;
    int is_definition;
    int is_naked;
    const char *body_start;
    const char *body_end;
} FunctionDecl;

/* Phase 3D introduces a tiny function-symbol pass.  A translation unit may
 * contain compatible prototypes and one definition for a function.  Since
 * the current compiler still emits one standalone flat image, any function
 * that is actually called must also have a definition in this translation
 * unit; separate-object resolution arrives with later ELF/linker work. */
static int scan_decl_type(const char **pp, int *is_char, int *width) {
    const char *p = *pp; char name[64]; size_t n = 0; int a, is_unsigned = 0;
    while (isspace((unsigned char)*p)) p++;
    while ((!strncmp(p,"const",5) && !(isalnum((unsigned char)p[5])||p[5]=='_')) ||
           (!strncmp(p,"volatile",8) && !(isalnum((unsigned char)p[8])||p[8]=='_')) ||
           (!strncmp(p,"restrict",8) && !(isalnum((unsigned char)p[8])||p[8]=='_'))) {
        p += !strncmp(p,"const",5) ? 5 : 8;
        while(isspace((unsigned char)*p))p++;
    }
    if (!strncmp(p,"unsigned",8) && !(isalnum((unsigned char)p[8])||p[8]=='_')) { is_unsigned=1; p+=8; while(isspace((unsigned char)*p))p++; }
    else if (!strncmp(p,"signed",6) && !(isalnum((unsigned char)p[6])||p[6]=='_')) { p+=6; while(isspace((unsigned char)*p))p++; }
    (void)is_unsigned;
    if (!strncmp(p, "int", 3) && !(isalnum((unsigned char)p[3]) || p[3]=='_')) { *is_char=0; *width=2; p+=3; }
    else if (!strncmp(p, "short", 5) && !(isalnum((unsigned char)p[5]) || p[5]=='_')) { *is_char=0; *width=2; p+=5; while(isspace((unsigned char)*p))p++; if(!strncmp(p,"int",3) && !(isalnum((unsigned char)p[3])||p[3]=='_')) p+=3; }
    else if (!strncmp(p, "char", 4) && !(isalnum((unsigned char)p[4]) || p[4]=='_')) { *is_char=1; *width=1; p+=4; }
    else if (!strncmp(p, "long", 4) && !(isalnum((unsigned char)p[4]) || p[4]=='_')) { *is_char=0; *width=4; p+=4; while(isspace((unsigned char)*p))p++; if(!strncmp(p,"int",3) && !(isalnum((unsigned char)p[3])||p[3]=='_')) p+=3; }
    else if (!strncmp(p, "void", 4) && !(isalnum((unsigned char)p[4]) || p[4]=='_')) { *is_char=0; *width=0; p+=4; }
    else if (!strncmp(p, "struct", 6) && !(isalnum((unsigned char)p[6]) || p[6]=='_')) {
        int si=-1; p+=6; while(isspace((unsigned char)*p))p++; n=0;
        if (*p=='{') {
            int bd=1; p++;
            while(*p && bd) { if(*p=='{')bd++; else if(*p=='}')bd--; p++; }
            if(bd) return 0;
        } else {
            while((isalnum((unsigned char)*p)||*p=='_')&&n+1<sizeof(name))name[n++]=*p++;
            name[n]=0; si=struct_find(name);
        }
        *is_char=0; *width=(si>=0)?g_structs[si].size_bytes:0;
    }
    else {
        if (!(isalpha((unsigned char)*p) || *p=='_')) return 0;
        while ((isalnum((unsigned char)*p) || *p=='_') && n+1<sizeof(name)) name[n++]=*p++;
        name[n]=0; a=alias_find(name); if (a<0) return 0;
        *is_char=g_aliases[a].is_char; *width=g_aliases[a].width;
        if(g_aliases[a].struct_tag[0]) { int si=struct_find(g_aliases[a].struct_tag); *width=(si>=0)?g_structs[si].size_bytes:0; }
    }
    while(isspace((unsigned char)*p))p++;
    while ((!strncmp(p,"const",5) && !(isalnum((unsigned char)p[5])||p[5]=='_')) ||
           (!strncmp(p,"volatile",8) && !(isalnum((unsigned char)p[8])||p[8]=='_')) ||
           (!strncmp(p,"restrict",8) && !(isalnum((unsigned char)p[8])||p[8]=='_'))) {
        p += !strncmp(p,"const",5) ? 5 : 8;
        while(isspace((unsigned char)*p))p++;
    }
    *pp=p; return 1;
}

static int scan_function_decls(const char *src, FunctionDecl *f, int maxf) {
    const char *p = src;
    int n = 0;
    while (*p) {
        char name[64];
        char parsed_params[16][64] = {{0}};
        int parsed_param_pointer[16] = {0};
        int parsed_param_char[16] = {0};
        int parsed_param_width[16] = {0};
        int parsed_param_struct[16];
        size_t nn = 0;
        const char *q;
        int np = 0, is_def = 0, is_variadic = 0, oldstyle = 0, is_naked = 0, parsed_return_width = 0, parsed_return_pointer = 0, parsed_return_char = 0, parsed_return_struct = -1;
        { int psi; for (psi = 0; psi < 16; psi++) parsed_param_struct[psi] = -1; }

        while (isspace((unsigned char)*p)) p++;
        if (p[0]=='/' && p[1]=='*') {
            const char *ce=strstr(p+2,"*/");
            if(!ce) return -1;
            p=ce+2; continue;
        }
        if (p[0]=='/' && p[1]=='/') {
            while(*p && *p!='\n')p++;
            continue;
        }
        if (*p=='\"' || *p=='\'') {
            int qc=*p++,esc=0;
            while(*p){ if(esc)esc=0; else if(*p=='\\')esc=1; else if(*p==qc){p++;break;} p++; }
            continue;
        }
        if (!strncmp(p, "struct", 6) && !(isalnum((unsigned char)p[6]) || p[6] == '_')) {
            const char *sq = p + 6;
            while (isspace((unsigned char)*sq)) sq++;
            while (isalnum((unsigned char)*sq) || *sq == '_') sq++;
            while (isspace((unsigned char)*sq)) sq++;
            if (*sq == '{') {
                int depth = 1; sq++;
                while (*sq && depth) { if (*sq == '{') depth++; else if (*sq == '}') depth--; sq++; }
                while (isspace((unsigned char)*sq)) sq++;
                if (*sq == ';') sq++;
                p = sq;
                continue;
            }
        }
        q = p;
        if (!strncmp(q, "__naked", 7) && !(isalnum((unsigned char)q[7]) || q[7] == '_')) {
            is_naked = 1;
            q += 7;
            while (isspace((unsigned char)*q)) q++;
        }
        { int ret_char=0;
          const char *rt=p;
          while(isspace((unsigned char)*rt))rt++;
          if(!strncmp(rt,"struct",6) && isspace((unsigned char)rt[6])) {
              char tag[64]; size_t z=0; rt+=6; while(isspace((unsigned char)*rt))rt++;
              while((isalnum((unsigned char)*rt)||*rt=='_') && z+1<sizeof(tag)) tag[z++]=*rt++;
              tag[z]=0; parsed_return_struct=struct_find(tag);
          }
          if (!scan_decl_type(&q, &ret_char, &parsed_return_width)) { p++; continue; }
          parsed_return_char = ret_char;
        }
        while (isspace((unsigned char)*q)) q++;
        while (*q == '*') { parsed_return_pointer++; q++; while (isspace((unsigned char)*q)) q++; }
        if (parsed_return_pointer && parsed_return_width == 0) parsed_return_char = -1;
        if (parsed_return_pointer > 1) { p++; continue; }
        if (!(isalpha((unsigned char)*q) || *q == '_')) { p++; continue; }
        while ((isalnum((unsigned char)*q) || *q == '_') && nn + 1 < sizeof(name))
            name[nn++] = *q++;
        name[nn] = 0;
        while (isspace((unsigned char)*q)) q++;
        if (*q++ != '(') { p++; continue; }
        while (isspace((unsigned char)*q)) q++;

        /* C89/K&R definition head: f(a,b) followed by parameter declarations. */
        { const char *oq=q; char oname[64]; size_t oz=0; int oa;
          while((isalnum((unsigned char)*oq)||*oq=='_')&&oz+1<sizeof(oname))oname[oz++]=*oq++;
          oname[oz]=0; oa=oz?alias_find(oname):-1;
          while(isspace((unsigned char)*oq))oq++;
          if(oz && (*oq==',' || *oq==')') && oa<0 && strncmp(oname,"int",4) && strncmp(oname,"char",5) && strncmp(oname,"void",5)) {
            oldstyle=1;
            for(;;) {
              size_t pn=0;
              if(np>=16)return -1;
              while(isspace((unsigned char)*q))q++;
              if(!(isalpha((unsigned char)*q)||*q=='_'))return -1;
              while((isalnum((unsigned char)*q)||*q=='_')&&pn+1<sizeof(parsed_params[0]))parsed_params[np][pn++]=*q++;
              parsed_params[np][pn]=0; parsed_param_width[np]=2; parsed_param_char[np]=0; parsed_param_pointer[np]=0; np++;
              while(isspace((unsigned char)*q))q++;
              if(*q==','){q++;continue;} break;
            }
          }
        }
        if (!oldstyle && !strncmp(q, "void", 4) && !(isalnum((unsigned char)q[4]) || q[4] == '_')) {
            const char *vq = q + 4;
            while (isspace((unsigned char)*vq)) vq++;
            if (*vq == ')') q = vq;
            else goto parse_parameters;
        } else if (!oldstyle && *q != ')') {
parse_parameters:
            for (;;) {
                size_t pn = 0;
                { int pw = 0;
                  const char *type_start = q;
                  while (isspace((unsigned char)*type_start)) type_start++;
                  if (!strncmp(type_start,"struct",6) && isspace((unsigned char)type_start[6])) {
                      char stag[64]; size_t stn=0; const char *stp=type_start+6;
                      while(isspace((unsigned char)*stp))stp++;
                      while((isalnum((unsigned char)*stp)||*stp=='_')&&stn+1<sizeof(stag))stag[stn++]=*stp++;
                      stag[stn]=0; parsed_param_struct[np]=struct_find(stag);
                  }
                  if (!scan_decl_type(&q, &parsed_param_char[np], &pw)) { fprintf(stderr,"x86-cc: function scan: unsupported parameter type in %s near %.120s\n",name,q); return -1; }
                  while (isspace((unsigned char)*q)) q++;
                  while (*q == '*') {
                      parsed_param_pointer[np]++;
                      q++;
                      while (isspace((unsigned char)*q)) q++;
                      while ((!strncmp(q,"const",5) && !(isalnum((unsigned char)q[5])||q[5]=='_')) ||
                             (!strncmp(q,"volatile",8) && !(isalnum((unsigned char)q[8])||q[8]=='_')) ||
                             (!strncmp(q,"restrict",8) && !(isalnum((unsigned char)q[8])||q[8]=='_'))) {
                          q += !strncmp(q,"const",5) ? 5 : 8;
                          while (isspace((unsigned char)*q)) q++;
                      }
                  }
                  if (pw == 0 && parsed_param_pointer[np] == 0) { fprintf(stderr,"x86-cc: function scan: incomplete non-pointer parameter type in %s near %.100s\n",name,q); return -1; }
                  if (pw == 0 && parsed_param_pointer[np] > 0) parsed_param_char[np] = -1; /* void *: generic object pointer */
                  parsed_param_width[np] = parsed_param_pointer[np] ? 2 : pw;
                }
                while (isspace((unsigned char)*q)) q++;
                if (parsed_param_pointer[np] > 2) { fprintf(stderr,"x86-cc: function scan: pointer depth >2 in %s near %.100s\n",name,q); return -1; }
                if (isalpha((unsigned char)*q) || *q == '_') {
                    while ((isalnum((unsigned char)*q) || *q == '_') && pn + 1 < sizeof(parsed_params[0]))
                        parsed_params[np][pn++] = *q++;
                    parsed_params[np][pn] = 0;
                }
                while (isspace((unsigned char)*q)) q++;
                if (*q=='[') {
                    q++; while(isspace((unsigned char)*q))q++;
                    while(isdigit((unsigned char)*q))q++;
                    while(isspace((unsigned char)*q))q++;
                    if(*q!=']') { fprintf(stderr,"x86-cc: function scan: unsupported array parameter in %s near %.100s\n",name,q); return -1; }
                    q++;
                    if(parsed_param_pointer[np]==0) parsed_param_pointer[np]=1;
                    parsed_param_width[np]=2;
                }
                if (np >= 16) return -1;
                if (parsed_params[np][0]) {
                    int k;
                    for (k = 0; k < np; k++)
                        if (parsed_params[k][0] && !strcmp(parsed_params[k], parsed_params[np])) return -1;
                }
                np++;
                while (isspace((unsigned char)*q)) q++;
                if (*q == ',') {
                    q++;
                    while (isspace((unsigned char)*q)) q++;
                    if (!strncmp(q, "...", 3)) { is_variadic = 1; q += 3; while (isspace((unsigned char)*q)) q++; break; }
                    continue;
                }
                break;
            }
        }
        if (*q++ != ')') { fprintf(stderr,"x86-cc: function scan: expected ) in %s near %.120s\n",name,q-1); return -1; }
        while (isspace((unsigned char)*q)) q++;
        if (oldstyle) {
            while (*q && *q!='{') {
                int dc=0,dw=0,dp=0,k=-1; char dn[64]; size_t dz=0;
                if(!scan_decl_type(&q,&dc,&dw))return -1;
                while(isspace((unsigned char)*q))q++;
                while(*q=='*'){dp++;q++;while(isspace((unsigned char)*q))q++;}
                while((isalnum((unsigned char)*q)||*q=='_')&&dz+1<sizeof(dn))dn[dz++]=*q++;
                dn[dz]=0;
                for(k=0;k<np;k++)if(!strcmp(parsed_params[k],dn))break;
                if(k>=np||dp>2)return -1;
                parsed_param_pointer[k]=dp; parsed_param_char[k]=(dw==0&&dp)?-1:dc; parsed_param_width[k]=dp?2:dw;
                while(isspace((unsigned char)*q))q++;
                if(*q!=';')return -1;
                q++;
                while(isspace((unsigned char)*q))q++;
            }
        }
        if (*q == '{') is_def = 1;
        else if (*q == ';') is_def = 0;
        else { fprintf(stderr,"x86-cc: function scan: expected body/prototype terminator after %s near %.120s\n",name,q); return -1; }

        if (n >= maxf) { fprintf(stderr,"x86-cc: function scan: function table full at %s (%d entries)\n",name,n); return -1; }
        {
            int k;
            for (k = 0; k < n; k++) {
                if (!strcmp(f[k].name, name)) {
                    int t;
                    if (f[k].nparams != np || f[k].is_variadic != is_variadic) { fprintf(stderr,"x86-cc: function scan: incompatible redeclaration of %s (%d vs %d params)\n",name,f[k].nparams,np); return -1; }
                    for (t = 0; t < np; t++)
                        if (f[k].param_is_pointer[t] != parsed_param_pointer[t] ||
                            f[k].param_is_char[t] != parsed_param_char[t] ||
                            f[k].param_width[t] != parsed_param_width[t] ||
                            f[k].param_struct_id[t] != parsed_param_struct[t] ||
                            f[k].return_width != (parsed_return_pointer ? 2 : parsed_return_width) ||
                            f[k].return_pointer != parsed_return_pointer ||
                            f[k].return_char != parsed_return_char) { fprintf(stderr,"x86-cc: function scan: incompatible type redeclaration of %s parameter %d\n",name,t+1); return -1; }
                    if (is_def && f[k].is_definition) { fprintf(stderr,"x86-cc: function scan: duplicate definition of %s\n",name); return -1; }
                }
            }
        }
        snprintf(f[n].name, sizeof(f[n].name), "%s", name);
        f[n].nparams = np;
        f[n].is_variadic = is_variadic;
        f[n].return_width = parsed_return_pointer ? 2 : parsed_return_width;
        f[n].return_pointer = parsed_return_pointer;
        f[n].return_char = parsed_return_char;
        f[n].return_struct_id = parsed_return_struct;
        f[n].is_definition = is_def;
        f[n].is_naked = is_naked;
        {
            int k;
            for (k = 0; k < np; k++) {
                snprintf(f[n].params[k], sizeof(f[n].params[k]), "%.63s", parsed_params[k]);
                f[n].param_is_pointer[k] = parsed_param_pointer[k];
                f[n].param_is_char[k] = parsed_param_char[k];
                f[n].param_width[k] = parsed_param_width[k];
                f[n].param_struct_id[k] = parsed_param_struct[k];
            }
        }

        if (is_def) {
            const char *bs;
            int depth = 1;
            int k;
            /* A function definition needs names for each parameter so the
             * body can refer to the parameter objects. */
            for (k = 0; k < np; k++) if (!f[n].params[k][0]) { fprintf(stderr,"x86-cc: function scan: unnamed parameter %d in definition %s\n",k+1,name); return -1; }
            bs = ++q;
            while (*q && depth) {
                if (*q == '{') depth++;
                else if (*q == '}') depth--;
                q++;
            }
            if (depth) { fprintf(stderr,"x86-cc: function scan: unbalanced body for %s\n",name); return -1; }
            f[n].body_start = bs;
            f[n].body_end = q - 1;
            n++;
            p = q;
        } else {
            f[n].body_start = NULL;
            f[n].body_end = NULL;
            n++;
            p = q + 1;
        }
    }
    return n;
}

static int emit_functions_program(FILE *out, const char *input, const char *src) {
    FunctionDecl decls[MAX_FUNCTIONS];
    FunctionDecl defs[MAX_FUNCTIONS];
    int nd, ndefs = 0, i, j, have_main = 0;

    g_string_count = 0;
    nd = scan_function_decls(src, decls, MAX_FUNCTIONS);
    if (nd < 0) {
        fprintf(stderr, "x86-cc: error: too many or invalid function declarations (limit %d)\n", MAX_FUNCTIONS);
        return 0;
    }

    g_function_count = 0;
    for (i = 0; i < nd; i++) {
        int sym = -1;
        for (j = 0; j < g_function_count; j++)
            if (!strcmp(g_function_names[j], decls[i].name)) { sym = j; break; }
        if (sym < 0) {
            if (g_function_count >= MAX_FUNCTIONS) {
                fprintf(stderr, "x86-cc: error: too many distinct functions/prototypes (limit %d)\n", MAX_FUNCTIONS);
                return 0;
            }
            sym = g_function_count++;
            snprintf(g_function_names[sym], sizeof(g_function_names[sym]), "%.63s", decls[i].name);
            g_function_arity[sym] = decls[i].nparams;
            g_function_variadic[sym] = decls[i].is_variadic;
            g_function_defined[sym] = 0;
            g_function_return_width[sym] = decls[i].return_width;
            g_function_return_pointer[sym] = decls[i].return_pointer;
            g_function_return_struct[sym] = decls[i].return_struct_id;
            g_function_return_char[sym] = decls[i].return_char;
            for (j = 0; j < decls[i].nparams; j++) {
                g_function_param_pointer[sym][j] = decls[i].param_is_pointer[j];
                g_function_param_char[sym][j] = decls[i].param_is_char[j];
                g_function_param_width[sym][j] = decls[i].param_width[j];
            }
        }
        if (decls[i].is_definition) {
            g_function_defined[sym] = 1;
            defs[ndefs++] = decls[i];
            if (!strcmp(decls[i].name, "main")) {
                have_main = 1;
                if (!(decls[i].nparams == 0 ||
                      (decls[i].nparams == 2 && decls[i].param_is_pointer[0] == 0 &&
                       decls[i].param_width[0] == 2 && decls[i].param_is_pointer[1] == 2 &&
                       decls[i].param_is_char[1]))) return 0;
            }
        }
    }
    if (!have_main && !g_translation_unit_only) return 0;

    if (g_relocatable_output) {
        for (i = 0; i < g_function_count; i++)
            fprintf(out, "%s %s\n", g_function_defined[i] ? "global" : "extern", g_function_names[i]);
    }

    fprintf(out, "; generated by x86-cc %s from %s\n", X86CC_VERSION, input);
    if (g_blackjack_target) {
        int main_args = 0;
        for (i = 0; i < ndefs; i++) if (!strcmp(defs[i].name, "main")) main_args = defs[i].nparams;
        fprintf(out, "cpu 8086\nbits 16\norg 0\n\n_start:\n");
        if (main_args == 2) {
            fprintf(out, "    ; Blackjack entry: SI=raw tail, DI=invoked pathname.\n");
            fprintf(out, "    push di\n    push si\n    call .Lcrt0_argv\n    pop si\n    pop di\n");
            fprintf(out, "    push ax\n    push bx\n    call main\n    pop bx\n    pop bx\n");
        } else fprintf(out, "    call main\n");
        fprintf(out, "    mov bx, ax\n    mov ax, 1\n    int 0x60\n.Lhalt:\n    jmp .Lhalt\n\n");
        if (main_args == 2) {
            fprintf(out, ".Lcrt0_argv:\n    ; IN: [sp+2]=tail, [sp+4]=argv0; OUT: AX=argc, BX=argv.\n");
            fprintf(out, "    pop dx\n    pop si\n    pop di\n    mov bp, sp\n    mov bx, 0xF200\n    mov [bx], di\n    mov word [bx+2], 0\n    mov ax, 1\n");
            fprintf(out, ".Lcrt0_skip:\n    mov cl, [si]\n    cmp cl, 0\n    je .Lcrt0_done\n    cmp cl, ' '\n    jne .Lcrt0_arg\n    inc si\n    jmp .Lcrt0_skip\n");
            fprintf(out, ".Lcrt0_arg:\n    mov di, ax\n    shl di, 1\n    mov [bx+di], si\n    inc ax\n    add di, 2\n    mov word [bx+di], 0\n.Lcrt0_scan:\n    mov cl, [si]\n    cmp cl, 0\n    je .Lcrt0_done\n    cmp cl, ' '\n    je .Lcrt0_split\n    inc si\n    jmp .Lcrt0_scan\n");
            fprintf(out, ".Lcrt0_split:\n    mov byte [si], 0\n    inc si\n    jmp .Lcrt0_skip\n.Lcrt0_done:\n    push di\n    push si\n    push dx\n    ret\n\n");
        }
    }
    else if (have_main)
        fprintf(out, "cpu 8086\nbits 16\norg 0x1000\n\n_start:\n    call main\n    hlt\n\n");
    else
        fprintf(out, "cpu 8086\nbits 16\n\n; translation unit: no synthetic entry point\n\n");

    for (i = 0; i < ndefs; i++) {
        size_t len = (size_t)(defs[i].body_end - defs[i].body_start);
        char *body = (char *)malloc(len + 2);
        BodyParser b;
        int saw = 0, frame;
        if (!body) return 0;
        memcpy(body, defs[i].body_start, len);
        body[len] = '}';
        body[len + 1] = 0;
        frame = count_local_slots(body) * 2;
        memset(&b, 0, sizeof(b));
        b.p = body;
        b.ok = 1;
        b.out = out;
        b.next_label = i * 1000;
        b.is_variadic_function = defs[i].is_variadic;
        b.fixed_param_bytes = 0;
        for (j = 0; j < defs[i].nparams; j++) b.fixed_param_bytes += (defs[i].param_width[j] == 4 && !defs[i].param_is_pointer[j]) ? 4 : 2;
        for (j = 0; j < defs[i].nparams; j++) {
            int k, after_bytes = 0;
            snprintf(b.locals[j].name, sizeof(b.locals[j].name), "%s", defs[i].params[j]);
            for (k = 0; k < j; k++)
                after_bytes += (defs[i].param_width[k] == 4 && !defs[i].param_is_pointer[k]) ? 4 : 2;
            b.locals[j].offset = 4 + after_bytes;
            b.locals[j].is_pointer = defs[i].param_is_pointer[j];
            b.locals[j].is_char = defs[i].param_is_char[j];
            b.locals[j].width = defs[i].param_is_pointer[j] ? 2 : defs[i].param_width[j];
            b.locals[j].array_len = 0;
            b.locals[j].struct_id = defs[i].param_struct_id[j];
        }
        b.nlocals = defs[i].nparams;
        snprintf(b.return_label, sizeof(b.return_label), ".Lreturn_%.63s", defs[i].name);
        fprintf(out, "%s:\n", defs[i].name);
        if (!defs[i].is_naked) {
            fprintf(out, "    push bp\n    mov bp, sp\n");
            for (j = 0; j < frame / 2; j++) fprintf(out, "    push ax\n");
        } else if (defs[i].nparams || frame) {
            fprintf(stderr, "x86-cc: error: __naked function %s may not have parameters or local variables\n", defs[i].name);
            free(body);
            return 0;
        }
        while (b.ok) {
            body_ws(&b);
            if (*b.p == '}') break;
            if (!*b.p) { b.ok = 0; break; }
            cg_statement(&b, &saw);
        }
        if (!b.ok || (defs[i].return_width != 0 && !saw) || b.total_locals != frame / 2) {
            fprintf(stderr, "x86-cc: error: invalid Phase 5A function body near: %.80s\n", b.p);
            free(body);
            return 0;
        }
        if (!defs[i].is_naked)
            fprintf(out, "%s:\n    mov sp, bp\n    pop bp\n    ret\n\n", b.return_label);
        free(body);
    }
    if (g_blackjack_target) {
        fprintf(out, "; Blackjack userspace runtime\n");
        fprintf(out, "uname:\n    push bp\n    mov bp, sp\n    mov bx, [bp+4]\n    mov ax, 122\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "write:\n    push bp\n    mov bp, sp\n    mov bx, [bp+4]\n    mov cx, [bp+6]\n    mov dx, [bp+8]\n    mov ax, 4\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "open:\n    push bp\n    mov bp, sp\n    mov bx, [bp+4]\n    mov cx, [bp+6]\n    mov ax, 5\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "creat:\n    push bp\n    mov bp, sp\n    mov bx, [bp+6]\n    mov cx, [bp+4]\n    mov ax, 8\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "mkdir:\n    push bp\n    mov bp, sp\n    mov bx, [bp+6]\n    mov cx, [bp+4]\n    mov ax, 39\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "read:\n    push bp\n    mov bp, sp\n    mov bx, [bp+4]\n    mov cx, [bp+6]\n    mov dx, [bp+8]\n    mov ax, 3\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "close:\n    push bp\n    mov bp, sp\n    mov bx, [bp+4]\n    mov ax, 6\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        /* Linux i386 socketcall ABI.  Keep socket mechanics out of applications. */
        fprintf(out, "socket:\n    push bp\n    mov bp, sp\n    push word [bp+8]\n    push word [bp+6]\n    push word [bp+4]\n    mov cx, sp\n    mov bx, 1\n    mov ax, 102\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "sendto:\n    push bp\n    mov bp, sp\n    push word [bp+14]\n    push word [bp+12]\n    push word [bp+10]\n    push word [bp+8]\n    push word [bp+6]\n    push word [bp+4]\n    mov cx, sp\n    mov bx, 11\n    mov ax, 102\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "recvfrom:\n    push bp\n    mov bp, sp\n    push word [bp+14]\n    push word [bp+12]\n    push word [bp+10]\n    push word [bp+8]\n    push word [bp+6]\n    push word [bp+4]\n    mov cx, sp\n    mov bx, 12\n    mov ax, 102\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        /* Legacy string helper.  New userspace must use POSIX write(fd,buf,count). */
        fprintf(out, "bj_write:\n    push bp\n    mov bp, sp\n    mov si, [bp+4]\n    push si\n    xor cx, cx\n.bj_write_len:\n    cmp byte [si], 0\n    je .bj_write_go\n    inc si\n    inc cx\n    jmp .bj_write_len\n.bj_write_go:\n    pop si\n    mov bx, 1\n    mov ax, 1\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_mem_kb:\n    mov ax, 0x8002\n    int 0x60\n    ret\n\n");
        fprintf(out, "bj_mem_used_kb:\n    mov ax, 0x8008\n    int 0x60\n    ret\n\n");
        fprintf(out, "bj_shutdown:\n    mov ax, 0x8003\n    int 0x60\n    xor ax, ax\n    ret\n\n");
        fprintf(out, "bj_date:\n    mov ax, 0x8004\n    int 0x60\n    mov ax, cx\n    ret\n\n");
        fprintf(out, "bj_time:\n    mov ax, 0x8005\n    int 0x60\n    mov ax, cx\n    ret\n\n");
        fprintf(out, "bj_date_md:\n    mov ax, 0x8004\n    int 0x60\n    mov ax, dx\n    ret\n\n");
        fprintf(out, "bj_time_sec:\n    mov ax, 0x8005\n    int 0x60\n    mov ax, dx\n    mov al, ah\n    xor ah, ah\n    ret\n\n");
        fprintf(out, "bj_args:\n    mov ax, 0xF000\n    ret\n\n");
        fprintf(out, "bj_netif_get:\n    push bp\n    mov bp, sp\n    xor bx, bx\n    mov cx, [bp+4]\n    mov ax, 0x8009\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_netif_get_eth0:\n    push bp\n    mov bp, sp\n    mov bx, 1\n    mov cx, [bp+4]\n    mov ax, 0x8009\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_netif_up:\n    push bp\n    mov bp, sp\n    mov bx, 1\n    mov cx, [bp+4]\n    mov ax, 0x800B\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_netif_down:\n    push bp\n    mov bp, sp\n    xor bx, bx\n    mov cx, [bp+4]\n    mov ax, 0x800B\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_route_get:\n    push bp\n    mov bp, sp\n    xor bx, bx\n    mov cx, [bp+4]\n    mov ax, 0x800A\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_sleep_ms:\n    push bp\n    mov bp, sp\n    mov bx, [bp+4]\n    mov ax, 0x8006\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_process_get:\n    push bp\n    mov bp, sp\n    mov bx, [bp+6]\n    mov cx, [bp+4]\n    mov ax, 0x800E\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_open:\n    push bp\n    mov bp, sp\n    mov si, [bp+4]\n    xor bx, bx\n    mov ax, 5\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_read:\n    push bp\n    mov bp, sp\n    mov bx, [bp+8]\n    mov di, [bp+6]\n    mov cx, [bp+4]\n    mov ax, 6\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_close:\n    push bp\n    mov bp, sp\n    mov bx, [bp+4]\n    mov ax, 7\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_file_save:\n    push bp\n    mov bp, sp\n    mov bx, [bp+8]\n    mov si, [bp+6]\n    mov cx, [bp+4]\n    mov ax, 16\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_create:\n    push bp\n    mov bp, sp\n    mov si, [bp+4]\n    mov ax, 18\n    int 0x60\n    mov sp, bp\n    pop bp\n    ret\n\n");
        fprintf(out, "bj_getch:\n    sub sp, 2\n    mov di, sp\n    xor bx, bx\n    mov cx, 1\n    mov ax, 6\n    int 0x60\n    xor ax, ax\n    mov al, [ss:di]\n    add sp, 2\n    ret\n\n");
    }
    emit_global_pool(out);
    emit_string_pool(out);
    return 1;
}

static int source_has_logical_operator(const char *src) {
    const char *p;
    if (strstr(src, "&&") || strstr(src, "||")) return 1;
    for (p = src; *p; p++) {
        if (*p == '!' && p[1] != '=') return 1;
    }
    return 0;
}

static int emit_asm(FILE *out, const char *input, const char *src) {
    char expr[256];
    int ok = 0;
    int alias_in_body = 0;
    long value;
    const char *body;

    if (!scan_struct_defs(src)) {
        fprintf(stderr, "x86-cc: error: invalid Phase 5A struct definition\n");
        return 0;
    }
    if (!scan_global_objects(src)) {
        fprintf(stderr, "x86-cc: error: invalid Phase 6B global declaration\n");
        return 0;
    }

    { FunctionDecl fd[256]; int nfd = scan_function_decls(src, fd, 256), k, defs = 0, protos = 0; if (nfd < 0) { fprintf(stderr, "x86-cc: error: invalid Phase 4H function declaration\n"); return 0; } for (k = 0; k < nfd; k++) { if (fd[k].is_definition) defs++; else protos++; } if (g_blackjack_target || (g_translation_unit_only && defs > 0) || defs >= 2 || protos > 0 || g_global_count > 0) return emit_functions_program(out, input, src); }

    if (!strstr(src, "int main(")) {
        fprintf(stderr, "x86-cc: error: v%s requires int main(...)\n", X86CC_VERSION);
        return 0;
    }

    body = strstr(src, "int main(");
    if (body) body = strchr(body, '{');
    if (!body) {
        fprintf(stderr, "x86-cc: error: missing function body\n");
        return 0;
    }
    body++;
    { int ai; const char *bend = strchr(body, '}');
      for (ai=0; ai<g_alias_count; ai++) { const char *hit=strstr(body,g_aliases[ai].name); if(hit && (!bend || hit<bend)) { alias_in_body=1; break; } }
    }

    /* Phase 1C+ stack-backed/statement path. Phase 2B routes control flow here
     * even when no local declaration is present. */
    if ((alias_in_body ||
         ((strstr(body, "int ") && strstr(body, "int ") < strchr(body, '}')) ||
         (strstr(body, "char ") && strstr(body, "char ") < strchr(body, '}')) ||
         (strstr(body, "struct ") && strstr(body, "struct ") < strchr(body, '}')))) ||
        strstr(body, "if") || strstr(body, "while") || strstr(body, "for") ||
        strstr(body, "break") || strstr(body, "continue") ||
        source_has_logical_operator(body))
        return emit_locals_program(out, input, body);

    /* Preserve Phase 0/1A/1B constant-only output byte-for-byte. */
    if (!find_return_expr(src, expr, sizeof(expr))) {
        fprintf(stderr, "x86-cc: error: v%s requires a return expression\n", X86CC_VERSION);
        return 0;
    }
    value = parse_return_expression(expr, &ok);
    if (!ok || value < -32768 || value > 65535) {
        fprintf(stderr,
                "x86-cc: error: v%s return expression supports constant arithmetic, relational, and equality expressions\n",
                X86CC_VERSION);
        return 0;
    }
    fprintf(out, "; generated by x86-cc %s from %s\n", X86CC_VERSION, input);
    fprintf(out, "cpu 8086\nbits 16\norg 0x1000\n\n_start:\n");
    fprintf(out, "    mov ax, 0x%04lX\n", value & 0xFFFFL);
    fprintf(out, "    hlt\n");
    return 1;
}

#include "peephole.h"
#include "long_branches.h"

static void usage(FILE *f) {
    fprintf(f,
        "x86-cc %s\n"
        "usage: x86-cc [-S|-c] [-O0|-O1] [--blackjack] input.c -o output\n"
        "       x86-cc --version\n"
        "\n"
        "v%s includes aggregate, pointer, preprocessor, include, and ABI work through the current regression corpus.\n"
        "AX is the return-value register. Without -S, x86-as must be available in PATH.\n",
        X86CC_VERSION, X86CC_VERSION);
}

int main(int argc, char **argv) {
    const char *input = NULL;
    const char *output = NULL;
    int emit_only = 0;
    int preprocess_only = 0;
    int object_only = 0;
    int i;
    char *src = NULL;
    char tmp_path[1024] = {0};
    FILE *out = NULL;
    int rc = 1;

    /* X86CC_DEFAULT_INCLUDEDIR is the installation contract.  Do not replace
       it merely because argv[0] contains a path: installed binaries live in
       bin/, while their headers live in lib/x86-cc/include.  Development
       trees can select another location with -I or at build time. */

    if (argc == 2 && (!strcmp(argv[1], "--version") || !strcmp(argv[1], "-v"))) {
        printf("x86-cc %s\n", X86CC_VERSION);
        return 0;
    }
    if (argc == 2 && (!strcmp(argv[1], "--help") || !strcmp(argv[1], "-h"))) {
        usage(stdout);
        return 0;
    }

    for (i = 1; i < argc; i++) {
        if (!strncmp(argv[i], "-I", 2)) {
            const char *ip = argv[i] + 2;
            if (!*ip) { if (++i >= argc) { usage(stderr); return 2; } ip = argv[i]; }
            if (g_user_include_count >= 8) { fprintf(stderr, "x86-cc: error: too many -I paths\n"); return 2; }
            snprintf(g_user_include_dirs[g_user_include_count++], 512, "%s", ip);
        } else if (!strcmp(argv[i], "-O0") || !strcmp(argv[i], "-O1")) {
            g_optimization_level = argv[i][2] - '0';
        } else if (!strcmp(argv[i], "-S")) {
            emit_only = 1;
        } else if (!strcmp(argv[i], "-E")) {
            preprocess_only = 1;
        } else if (!strcmp(argv[i], "-c")) {
            object_only = 1;
            g_relocatable_output = 1;
        } else if (!strcmp(argv[i], "--blackjack")) {
            g_blackjack_target = 1;
        } else if (!strcmp(argv[i], "-o")) {
            if (++i >= argc) { usage(stderr); return 2; }
            output = argv[i];
        } else if (argv[i][0] == '-') {
            fprintf(stderr, "x86-cc: error: unsupported option: %s\n", argv[i]);
            return 2;
        } else if (!input) {
            input = argv[i];
        } else {
            fprintf(stderr, "x86-cc: error: only one input file is supported\n");
            return 2;
        }
    }

    if (!input || (!output && !preprocess_only)) {
        usage(stderr);
        return 2;
    }

    { const char *s1=strrchr(input,'/'), *s2=strrchr(input,'\\'), *s=s1; size_t n;
      if(!s || (s2 && s2>s)) s=s2;
      if(s) { n=(size_t)(s-input); if(n<sizeof(g_source_dir)) { memcpy(g_source_dir,input,n); g_source_dir[n]=0; } }
    }
    src = read_file(input);
    if (!src) {
        fprintf(stderr, "x86-cc: error: cannot read %s\n", input);
        goto done;
    }
    g_inc_macro_count = 0;
    if (!expand_includes_text(&src, g_source_dir, 0)) {
        fprintf(stderr, "x86-cc: error: invalid or unreadable Phase 6I include\n");
        goto done;
    }
    splice_backslash_newlines(src);
    flatten_paren_newlines(src);
    if (!preprocess_object_macros(&src)) {
        fprintf(stderr, "x86-cc: error: invalid Phase 6C preprocessor directive near: %s\n", g_pp_context);
        goto done;
    }
    if (preprocess_only) {
        FILE *pf = output ? fopen(output, "wb") : stdout;
        if (!pf) { fprintf(stderr, "x86-cc: error: cannot create %s\n", output); goto done; }
        fwrite(src, 1, strlen(src), pf);
        if (output && fclose(pf) != 0) goto done;
        rc = 0;
        goto done;
    }
    /* Preserve integer suffixes: expression codegen needs U/L width. */
    normalize_decl_qualifiers(src);
    compact_ws(src);

    if (emit_only) {
        g_translation_unit_only = (strstr(src, "int main(") == NULL);
        out = fopen(output, "wb");
        if (!out) {
            fprintf(stderr, "x86-cc: error: cannot create %s\n", output);
            goto done;
        }
        if (!emit_asm(out, input, src)) goto done;
        if (fclose(out) != 0) { out = NULL; goto done; }
        out = NULL;
        if (!peephole_optimize_file(output, g_optimization_level)) goto done;
        if (!x86cc_expand_conditional_branches(output)) goto done;
        printf("compiled %s -> %s (assembly)\n", input, output);
        rc = 0;
        goto done;
    }

    if (object_only) g_translation_unit_only = 1;
    snprintf(tmp_path, sizeof(tmp_path), "%s.x86cc.asm", output);
    out = fopen(tmp_path, "wb");
    if (!out) {
        fprintf(stderr, "x86-cc: error: cannot create temporary assembly\n");
        goto done;
    }
    if (!emit_asm(out, input, src)) goto done;
    if (fclose(out) != 0) { out = NULL; goto done; }
    out = NULL;
    if (!peephole_optimize_file(tmp_path, g_optimization_level)) goto done;
    if (!x86cc_expand_conditional_branches(tmp_path)) goto done;

    {
        char cmd[4096];
        int status;
        snprintf(cmd, sizeof(cmd), object_only ? "x86-as -f bjobj \"%s\" -o \"%s\"" : "x86-as -f bin \"%s\" -o \"%s\"", tmp_path, output);
        status = system(cmd);
        if (status != 0) {
            fprintf(stderr, "x86-cc: error: x86-as failed\n");
            goto done;
        }
    }
    remove(tmp_path);
    printf("compiled %s -> %s\n", input, output);
    rc = 0;

done:
    if (out) fclose(out);
    if (rc != 0 && !emit_only && tmp_path[0]) remove(tmp_path);
    free(src);
    return rc;
}
