                const char *ps = ++v, *pe; int np = 0;
                if (nfmac >= 256) { fprintf(stderr,"x86-cc: preprocessor: function macro table full (256) at %.*s\n",(int)(end-line),line); free(out); return 0; }
                memcpy(fmacros[nfmac].name,q,nn); fmacros[nfmac].name[nn]=0;
                fmacros[nfmac].variadic=0;
                while (ps < end && *ps != ')') {
                    size_t pn;
                    while (ps < end && isspace((unsigned char)*ps)) ps++;
                    if(end-ps>=3 && ps[0]=='.' && ps[1]=='.' && ps[2]=='.') {
                        if(np>=32){free(out);return 0;}
                        strcpy(fmacros[nfmac].params[np++],"__VA_ARGS__");
                        fmacros[nfmac].variadic=1; ps+=3;
                    } else {
                        pe = ps; while (pe < end && (isalnum((unsigned char)*pe) || *pe == '_')) pe++;
                        pn = (size_t)(pe-ps);
                        if (!pn || np >= 32 || pn >= sizeof(fmacros[0].params[0])) { fprintf(stderr,"x86-cc: preproc: unsupported macro parameters: %.*s\n",(int)(end-line),line); free(out); return 0; }
                        memcpy(fmacros[nfmac].params[np],ps,pn); fmacros[nfmac].params[np][pn]=0; np++;
                        ps=pe;
                    }
                    while(ps<end&&isspace((unsigned char)*ps))ps++;
                    if(ps<end&&*ps==',') { ps++; continue; }
                    if(ps>=end||*ps!=')') { free(out); return 0; }
                }
                if(ps>=end||*ps!=')') { free(out); return 0; }
                fmacros[nfmac].nparams=np;
                v=ps+1; while (v<end && isspace((unsigned char)*v)) v++;
                vn=(size_t)(end-v); while(vn && isspace((unsigned char)v[vn-1])) vn--;
                if (vn>=sizeof(fmacros[0].value)) { fprintf(stderr,"x86-cc: preproc: macro body too large: %.*s\n",(int)(end-line),line); free(out); return 0; }
                memcpy(fmacros[nfmac].value,v,vn); fmacros[nfmac].value[vn]=0; nfmac++;
            } else {
                if (nmac >= 1024) { free(out); return 0; }
                memcpy(macros[nmac].name, q, nn); macros[nmac].name[nn] = 0;
                while (v < end && isspace((unsigned char)*v)) v++;
                vn = (size_t)(end - v); while (vn && isspace((unsigned char)v[vn-1])) vn--;
                if (vn >= sizeof(macros[0].value)) { free(out); return 0; }
                memcpy(macros[nmac].value, v, vn); macros[nmac].value[vn] = 0; nmac++;
            }
        } else {
            size_t i = 0; int quote = 0;
            while (i < len) {
                if (block_comment) {
                    if (i + 1 < len && p[i] == '*' && p[i+1] == '/') block_comment = 0;
                    if (w+2 >= cap) { free(out); return 0; } out[w++] = p[i++];
                    continue;
                }
                if (quote) {
                    if (w+2 >= cap) { free(out); return 0; }
                    out[w++] = p[i];
                    if (p[i] == '\\' && i + 1 < len) { out[w++] = p[++i]; i++; continue; }
                    if (p[i] == quote) quote = 0;
                    i++; continue;
                }
                if (i + 1 < len && p[i] == '/' && p[i+1] == '*') block_comment = 1;
                if (i + 1 < len && p[i] == '/' && p[i+1] == '/') {
                    if (w + (len-i) + 2 >= cap) { free(out); return 0; }
                    memcpy(out+w, p+i, len-i); w += len-i; i=len; continue;
                }
                if (p[i] == '\"' || p[i] == '\'') { quote = (unsigned char)p[i]; out[w++] = p[i++]; continue; }
                if (!block_comment && (isalpha((unsigned char)p[i]) || p[i] == '_')) {
                    size_t j = i + 1; int m, hit = -1, fhit = -1;
                    while (j < len && (isalnum((unsigned char)p[j]) || p[j] == '_')) j++;
                    for (m = nfmac - 1; m >= 0; m--) if (strlen(fmacros[m].name)==j-i && !strncmp(p+i,fmacros[m].name,j-i)) { fhit=m; break; }
                    { size_t fj=j; while(fj<len && isspace((unsigned char)p[fj]))fj++;
                    if (fhit >= 0 && fj < len && p[fj] == '(') {
                        size_t a1=fj+1, seglen, z; int dep=1, aq=0;
                        char invocation[16384], expanded[16384];
                        while (a1<len && dep) {
                            int ch=(unsigned char)p[a1];
                            if(aq) { if(ch=='\\'&&a1+1<len){a1+=2;continue;} if(ch==aq)aq=0; a1++; continue; }
                            if(ch=='"'||ch=='\''){aq=ch;a1++;continue;}
                            if(ch=='(')dep++;
                            else if(ch==')'){dep--;if(!dep)break;}
                            a1++;
                        }
                        if(dep){free(out);return 0;}
                        seglen=a1+1-i;
                        if(seglen>=sizeof(invocation)){free(out);return 0;}
                        memcpy(invocation,p+i,seglen); invocation[seglen]=0;
                        if(!expand_macro_text(invocation,expanded,sizeof(expanded),macros,nmac,fmacros,nfmac,0,"")){free(out);return 0;}
                        z=strlen(expanded); if(w+z+2>=cap){free(out);return 0;}
                        memcpy(out+w,expanded,z); w+=z;
                        i=a1+1;
                    } else {
                        for (m = nmac - 1; m >= 0; m--) if (strlen(macros[m].name) == j-i && !strncmp(p+i, macros[m].name, j-i)) { hit = m; break; }
                        if (hit >= 0) { char expanded[4096]; size_t z; if(!expand_macro_text(macros[hit].value,expanded,sizeof(expanded),macros,nmac,fmacros,nfmac,0,macros[hit].name)){free(out);return 0;} z=strlen(expanded); if (w+z+2 >= cap) { free(out); return 0; } memcpy(out+w, expanded, z); w += z; }
                        else { if (w+j-i+2 >= cap) { free(out); return 0; } memcpy(out+w,p+i,j-i); w += j-i; }
                        i = j;
                    }
                    }
                } else { if (w+2 >= cap) { free(out); return 0; } out[w++] = p[i++]; }
