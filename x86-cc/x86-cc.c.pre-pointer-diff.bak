        if(!expand_macro_text(out,resc,cap,macros,nmac,fmacros,nfmac,0,"")){fprintf(stderr,"x86-cc: preprocessor: final macro rescan failed near %.160s\n",g_pp_context);free(resc);free(out);return 0;}
        free(out); out=resc;
    }
    free(src); *psrc = out; return 1;
}

static void normalize_decl_qualifiers(char *s) {
    char *p = s;
    int quote = 0;
    while (*p) {
        char *q;
        if (quote) {
            if (*p == '\\' && p[1]) { p += 2; continue; }
            if (*p == quote) quote = 0;
            p++;
            continue;
        }
        if (*p == '"' || *p == '\'') { quote = (unsigned char)*p++; continue; }
        q = p;
        while (*q && (isalnum((unsigned char)*q) || *q == '_')) q++;
        if (q > p && ((q - p == 6 && !strncmp(p, "static", 6)) ||
                      (q - p == 5 && !strncmp(p, "const", 5)))) {
            while (p < q) *p++ = ' ';
        } else if (q > p) {
            p = q;
        } else {
            p++;
        }
    }
}

static void compact_ws(char *s) {
    char *r = s, *w = s;
    int pending_space = 0;

    while (*r) {
        /* Inline assembly is intentionally line-sensitive x86-as source.
         * Preserve it byte-for-byte while compacting ordinary C whitespace. */
        if (!strncmp(r, "asm", 3) &&
            (r == s || !(isalnum((unsigned char)r[-1]) || r[-1] == '_')) &&
            !(isalnum((unsigned char)r[3]) || r[3] == '_')) {
            char *q = r + 3;
            int depth = 0;
            while (isspace((unsigned char)*q)) q++;
            if (*q == '{') {
                if (pending_space && w != s) *w++ = ' ';
                pending_space = 0;
                while (r <= q) *w++ = *r++;
                depth = 1;
                while (*r && depth) {
                    char ch = *r++;
                    *w++ = ch;
                    if (ch == '{') depth++;
                    else if (ch == '}') depth--;
                }
                continue;
            }
        }
        if (isspace((unsigned char)*r)) {
            pending_space = 1;
            r++;
            continue;
        }
        if (pending_space && w != s && w[-1] != '{' && w[-1] != ';' &&
            *r != '}' && *r != ';' && *r != '(' && w[-1] != '(') {
            *w++ = ' ';
        }
        pending_space = 0;
        *w++ = *r++;
    }
    *w = '\0';
}

static int find_return_expr(const char *src, char *expr, size_t exprsz) {
    const char *p = src;
    const char *q;
    size_t n;

    while ((p = strstr(p, "return")) != NULL) {
        unsigned char before = (p == src) ? 0 : (unsigned char)p[-1];
        unsigned char after = (unsigned char)p[6];
        if ((p == src || !(isalnum(before) || before == '_')) &&
            !(isalnum(after) || after == '_')) {
            break;
        }
        p += 6;
    }
    if (!p) return 0;

    p += 6;
    while (isspace((unsigned char)*p)) p++;
    q = strchr(p, ';');
    if (!q) return 0;
    n = (size_t)(q - p);
    if (n + 1 > exprsz) return 0;
    memcpy(expr, p, n);
    expr[n] = '\0';
    return 1;
}

#define MAX_STRUCT_TYPES 64
#define MAX_STRUCT_MEMBERS 32

typedef struct {
    char name[64];
    char member_name[MAX_STRUCT_MEMBERS][64];
    int member_pointer[MAX_STRUCT_MEMBERS]; /* Phase 5C: 0 scalar, 1 pointer */
    int member_function_pointer[MAX_STRUCT_MEMBERS]; /* function-pointer object */
    int member_char[MAX_STRUCT_MEMBERS];    /* scalar/pointee base type */
    int member_width[MAX_STRUCT_MEMBERS];
    int member_array_len[MAX_STRUCT_MEMBERS]; /* 0 scalar, >0 fixed-size member array */
    int member_struct_id[MAX_STRUCT_MEMBERS]; /* nested aggregate type, -1 scalar */
    int member_offset[MAX_STRUCT_MEMBERS];  /* byte offset from struct base */
    int member_count;
    int size_bytes;
} StructType;

static StructType g_structs[MAX_STRUCT_TYPES];
static int g_struct_count;

static int struct_find(const char *name) {
    int i;
    for (i = 0; i < g_struct_count; i++)
        if (!strcmp(g_structs[i].name, name)) return i;
    return -1;
}

static int struct_member_find(int sid, const char *name) {
    int i;
    if (sid < 0 || sid >= g_struct_count) return -1;
    for (i = 0; i < g_structs[sid].member_count; i++)
        if (!strcmp(g_structs[sid].member_name[i], name)) return i;
    return -1;
}

/* Phase 5C: members now carry type and byte layout metadata.  The current
 * aggregate fence supports int, char, int *, and char * members.  Layout is
 * deliberately packed and deterministic: char consumes one byte, while int
 * and pointers consume two.  Nested structs, member arrays, and T ** members
 * remain later work. */
static int scan_struct_defs(const char *src) {
    const char *p = src;
    g_struct_count = 0;
    while (*p) {
        const char *q;
        char sname[64];
        size_t sn = 0;
        int sid, members = 0, size_bytes = 0;
        while (isspace((unsigned char)*p)) p++;
        if (p[0]=='/' && p[1]=='*') { const char *ce=strstr(p+2,"*/"); if(!ce)return 0; p=ce+2; continue; }
        if (p[0]=='/' && p[1]=='/') { while(*p && *p!='\n')p++; continue; }
        if (strncmp(p, "struct", 6) || (isalnum((unsigned char)p[6]) || p[6] == '_')) {
            p++;
            continue;
        }
        q = p + 6;
        while (isspace((unsigned char)*q)) q++;
        /* Anonymous struct/union typedefs are not named struct definitions.
         * Leave them for the declaration parser instead of rejecting the TU. */
        if (*q == '{') { p++; continue; }
        if (!(isalpha((unsigned char)*q) || *q == '_')) return 0;
        while ((isalnum((unsigned char)*q) || *q == '_') && sn + 1 < sizeof(sname)) sname[sn++] = *q++;
        sname[sn] = 0;
        while (isspace((unsigned char)*q)) q++;
        if (*q != '{') { p++; continue; } /* local/reference use, not a definition */
        if (struct_find(sname) >= 0 || g_struct_count >= MAX_STRUCT_TYPES) { fprintf(stderr,"x86-cc: struct: duplicate/overflow %s\n",sname); return 0; }
        sid = g_struct_count;
        snprintf(g_structs[sid].name, sizeof(g_structs[sid].name), "%s", sname);
        q++;
        while (1) {
            char mname[64]; size_t mn = 0; int k, is_char = 0, width = 2, pointer_depth = 0;
            while (1) {
                while (isspace((unsigned char)*q)) q++;
                if (q[0]=='/' && q[1]=='*') {
                    const char *ce=strstr(q+2,"*/");
                    if(!ce){fprintf(stderr,"x86-cc: struct: unterminated comment in %s\n",sname);return 0;}
                    q=ce+2; continue;
                }
                if (q[0]=='/' && q[1]=='/') { while(*q && *q!='\n')q++; continue; }
                break;
            }
            if (*q == '}') { q++; break; }
            if (!strncmp(q,"union",5) && isspace((unsigned char)q[5])) {
                const char *uq=q+5; char uname[64]; size_t un=0; int usid,um=0,usize=0;
                while(isspace((unsigned char)*uq))uq++;
                if(*uq!='{') { fprintf(stderr,"x86-cc: union: named/reference union unsupported in %s near %.80s\n",sname,uq); return 0; }
                if(g_struct_count+1>=MAX_STRUCT_TYPES)return 0;
                usid=g_struct_count+1; snprintf(uname,sizeof(uname),"__anon_union_%d_%d",sid,members);
                snprintf(g_structs[usid].name,sizeof(g_structs[usid].name),"%s",uname); uq++;
                while(1){ char n[64];size_t nn=0;int w2=2,c2=0,pd=0,al=0;
                    while(1){ while(isspace((unsigned char)*uq))uq++; if(uq[0]=='/'&&uq[1]=='*'){const char *ce=strstr(uq+2,"*/");if(!ce)return 0;uq=ce+2;continue;} break; }
                    if(*uq=='}'){uq++;break;}
                    if(!strncmp(uq,"int",3)&&isspace((unsigned char)uq[3]))uq+=3;
                    else if(!strncmp(uq,"char",4)&&isspace((unsigned char)uq[4])){uq+=4;c2=1;w2=1;}
                    else { fprintf(stderr,"x86-cc: union: unsupported member type in %s near %.80s\n",sname,uq); return 0; } while(isspace((unsigned char)*uq))uq++; while(*uq=='*'){pd++;uq++;while(isspace((unsigned char)*uq))uq++;}
                    while((isalnum((unsigned char)*uq)||*uq=='_')&&nn+1<sizeof(n))
                        n[nn++]=*uq++;
                    n[nn]=0;
                    if(!nn)return 0;
                    while(isspace((unsigned char)*uq))uq++;
                    if(*uq=='['){char *ep;long z;uq++;z=strtol(uq,&ep,0);if(ep==uq||z<=0)return 0;uq=ep;while(isspace((unsigned char)*uq))uq++;if(*uq!=']')return 0;uq++;al=(int)z;while(isspace((unsigned char)*uq))uq++;}
                    if(*uq!=';'||um>=MAX_STRUCT_MEMBERS)return 0;
                    snprintf(g_structs[usid].member_name[um],64,"%s",n);
                    g_structs[usid].member_pointer[um]=pd;
                    g_structs[usid].member_char[um]=c2;
                    g_structs[usid].member_width[um]=pd?2:w2;
                    g_structs[usid].member_array_len[um]=al;
                    g_structs[usid].member_struct_id[um]=-1;
                    g_structs[usid].member_offset[um]=0;
                    {int z=(pd?2:w2)*(al?al:1);if(z>usize)usize=z;}
                    um++;
                    uq++;
                }
                while(isspace((unsigned char)*uq))uq++;
                while((isalnum((unsigned char)*uq)||*uq=='_')&&un+1<sizeof(mname))
                    mname[un++]=*uq++;
                mname[un]=0;
                if(!un)return 0;
                while(isspace((unsigned char)*uq))uq++;
                if(*uq!=';')return 0;
                g_structs[usid].member_count=um;g_structs[usid].size_bytes=usize;g_struct_count++;
                snprintf(g_structs[sid].member_name[members],64,"%s",mname);g_structs[sid].member_pointer[members]=0;g_structs[sid].member_char[members]=0;g_structs[sid].member_width[members]=usize;g_structs[sid].member_array_len[members]=0;g_structs[sid].member_struct_id[members]=usid;g_structs[sid].member_offset[members]=size_bytes;size_bytes+=usize;members++;q=uq+1;continue;
            }
            while ((!strncmp(q, "const", 5) && isspace((unsigned char)q[5])) ||
                   (!strncmp(q, "volatile", 8) && isspace((unsigned char)q[8])) ||
                   (!strncmp(q, "restrict", 8) && isspace((unsigned char)q[8]))) {
                if (!strncmp(q, "const", 5)) q += 5; else q += 8;
                while (isspace((unsigned char)*q)) q++;
            }
            if (!strncmp(q, "unsigned", 8) && isspace((unsigned char)q[8])) {
                q+=8; while(isspace((unsigned char)*q))q++;
                if(!strncmp(q,"int",3) && !(isalnum((unsigned char)q[3]) || q[3]=='_')){q+=3;width=2;}
                else if(!strncmp(q,"short",5) && !(isalnum((unsigned char)q[5]) || q[5]=='_')){q+=5;while(isspace((unsigned char)*q))q++;if(!strncmp(q,"int",3)&&!(isalnum((unsigned char)q[3])||q[3]=='_'))q+=3;width=2;}
                else if(!strncmp(q,"long",4) && !(isalnum((unsigned char)q[4]) || q[4]=='_')){q+=4;width=4;}
                else if(!strncmp(q,"char",4) && !(isalnum((unsigned char)q[4]) || q[4]=='_')){q+=4;is_char=1;width=1;}
                else { width=2; }
            }
            else if (!strncmp(q, "int", 3) && !(isalnum((unsigned char)q[3]) || q[3] == '_')) { q += 3; width = 2; }
            else if (!strncmp(q, "short", 5) && !(isalnum((unsigned char)q[5]) || q[5] == '_')) { q += 5; while(isspace((unsigned char)*q))q++; if(!strncmp(q,"int",3)&&!(isalnum((unsigned char)q[3])||q[3]=='_'))q+=3; width=2; }
            else if (!strncmp(q, "char", 4) && !(isalnum((unsigned char)q[4]) || q[4] == '_')) { q += 4; is_char = 1; width = 1; }
            else if (!strncmp(q, "long", 4) && !(isalnum((unsigned char)q[4]) || q[4] == '_')) { q += 4; while(isspace((unsigned char)*q))q++; if(!strncmp(q,"int",3)&&!(isalnum((unsigned char)q[3])||q[3]=='_'))q+=3; width = 4; }
            else if (!strncmp(q, "float", 5) && isspace((unsigned char)q[5])) { q += 5; width = 4; }
            else if (!strncmp(q, "double", 6) && isspace((unsigned char)q[6])) { q += 6; width = 8; }
            else if (!strncmp(q, "bool", 4) && isspace((unsigned char)q[4])) { q += 4; width = 1; }
            else if (!strncmp(q, "enum", 4) && isspace((unsigned char)q[4])) {
                q += 4; while (isspace((unsigned char)*q)) q++;
                if (!(isalpha((unsigned char)*q) || *q == '_')) return 0;
                while (isalnum((unsigned char)*q) || *q == '_') q++;
                width = 2;
            }
            else if (!strncmp(q, "struct", 6) && isspace((unsigned char)q[6])) {
                char tag[64]; size_t tn=0; int nested_sid;
                q += 6; while (isspace((unsigned char)*q)) q++;
                while ((isalnum((unsigned char)*q)||*q=='_') && tn+1<sizeof(tag)) tag[tn++]=*q++;
                tag[tn]=0; nested_sid=struct_find(tag);
                if (!tn) return 0;
                if (nested_sid < 0 && !strcmp(tag, sname)) nested_sid = sid; /* incomplete self type */
                if (nested_sid < 0) { fprintf(stderr,"x86-cc: struct: unknown nested struct %s in %s\n",tag,sname); return 0; }
                width = (nested_sid == sid) ? 0 : g_structs[nested_sid].size_bytes;
                /* Stash aggregate identity; a self object by value is rejected below,
                 * but a pointer to the incomplete current type is valid C. */
                is_char = -(nested_sid + 2);
            }
            else if (isalpha((unsigned char)*q) || *q == '_') {
                char tname[64]; size_t tn=0; int aid;
                while((isalnum((unsigned char)*q)||*q=='_')&&tn+1<sizeof(tname))tname[tn++]=*q++;
                tname[tn]=0; aid=alias_find(tname); if(aid<0){fprintf(stderr,"x86-cc: struct: unsupported member type %s near %.80s\n",tname,q);return 0;}
                is_char=g_aliases[aid].is_char; width=g_aliases[aid].width;
            } else { fprintf(stderr,"x86-cc: struct: unsupported member syntax in %s near %.80s\n",sname,q); return 0; }
            while (isspace((unsigned char)*q)) q++;
            while ((!strncmp(q, "const", 5) && !isalnum((unsigned char)q[5]) && q[5] != '_') ||
                   (!strncmp(q, "volatile", 8) && !isalnum((unsigned char)q[8]) && q[8] != '_') ||
                   (!strncmp(q, "restrict", 8) && !isalnum((unsigned char)q[8]) && q[8] != '_')) {
                if (!strncmp(q, "const", 5)) q += 5; else q += 8;
                while (isspace((unsigned char)*q)) q++;
            }
            /* One declaration-specifier sequence may introduce several declarators:
             * int a, *b, c[4];  Parse the base type once, then loop here. */
            parse_struct_declarator:
            mn = 0; pointer_depth = 0;
            /* Function-pointer member: int (*fn)(...).  For the 16-bit ABI the
             * stored object is one near code pointer (2 bytes).  Parameter type
             * checking for indirect calls is intentionally deferred; this pass
             * records the declarator shape and layout. */
            if (*q == '(') {
                const char *fq = q + 1;
                while (isspace((unsigned char)*fq)) fq++;
                if (*fq == '*') {
                    fq++; while (isspace((unsigned char)*fq)) fq++;
                    if (!(isalpha((unsigned char)*fq) || *fq == '_')) return 0;
                    while ((isalnum((unsigned char)*fq) || *fq == '_') && mn + 1 < sizeof(mname)) mname[mn++] = *fq++;
                    mname[mn] = 0;
                    while (isspace((unsigned char)*fq)) fq++;
                    if (*fq != ')') return 0;
                    fq++; while (isspace((unsigned char)*fq)) fq++;
                    if (*fq != '(') return 0;
                    { int depth=1; fq++; while (*fq && depth) { if (*fq=='(') depth++; else if (*fq==')') depth--; fq++; } if(depth) return 0; }
                    while (isspace((unsigned char)*fq)) fq++;
                    if (*fq != ';' || members >= MAX_STRUCT_MEMBERS) return 0;
                    for (k=0;k<members;k++) if(!strcmp(g_structs[sid].member_name[k],mname)) return 0;
                    snprintf(g_structs[sid].member_name[members],64,"%s",mname);
                    g_structs[sid].member_pointer[members]=1;
                    g_structs[sid].member_function_pointer[members]=1;
                    g_structs[sid].member_char[members]=0;
                    g_structs[sid].member_width[members]=2;
                    g_structs[sid].member_array_len[members]=0;
                    g_structs[sid].member_struct_id[members]=-1;
                    g_structs[sid].member_offset[members]=size_bytes;
                    size_bytes+=2; members++; q=fq+1; continue;
                }
            }
            while (*q == '*') { pointer_depth++; q++; while (isspace((unsigned char)*q)) q++; }
            if (pointer_depth > 1) { fprintf(stderr,"x86-cc: struct: pointer depth %d in %s near %.80s\n",pointer_depth,sname,q); return 0; }
            if (is_char == -(sid + 2) && pointer_depth == 0) { fprintf(stderr,"x86-cc: struct: incomplete self member by value in %s\n",sname); return 0; }
            if (!(isalpha((unsigned char)*q) || *q == '_')) { fprintf(stderr,"x86-cc: struct: missing member name in %s near %.80s\n",sname,q); return 0; }
            while ((isalnum((unsigned char)*q) || *q == '_') && mn + 1 < sizeof(mname)) mname[mn++] = *q++;
            mname[mn] = 0;
            while (isspace((unsigned char)*q)) q++;
            { int array_len=0;
              if(*q==':'){ int depth=0; q++; while(isspace((unsigned char)*q))q++; while(*q && !(*q==';'&&depth==0)){ if(*q=='(')depth++; else if(*q==')'&&depth>0)depth--; q++; } if(*q!=';')return 0; /* Width is compile-time-only for current uses. */ }
              if(*q=='['){ char *ep; long n; q++; while(isspace((unsigned char)*q))q++; n=strtol(q,&ep,0); if(ep==q||n<=0||n>32767)return 0; q=ep; while(isspace((unsigned char)*q))q++; if(*q!=']')return 0; q++; while(isspace((unsigned char)*q))q++; array_len=(int)n; }
            if ((*q != ';' && *q != ',') || members >= MAX_STRUCT_MEMBERS) { fprintf(stderr,"x86-cc: struct: unsupported declarator for %s.%s near %.100s\n",sname,mname,q); return 0; }
            g_structs[sid].member_array_len[members]=array_len;
            g_structs[sid].member_struct_id[members]=(is_char < 0) ? (-is_char - 2) : -1;
            for (k = 0; k < members; k++) if (!strcmp(g_structs[sid].member_name[k], mname)) return 0;
            snprintf(g_structs[sid].member_name[members], 64, "%s", mname);
            g_structs[sid].member_pointer[members] = pointer_depth;
            g_structs[sid].member_function_pointer[members] = 0;
            g_structs[sid].member_char[members] = (is_char == 1);
            g_structs[sid].member_width[members] = pointer_depth ? 2 : width;
            g_structs[sid].member_offset[members] = size_bytes;
            size_bytes += (pointer_depth ? 2 : width) * (array_len ? array_len : 1);
            members++;
            if (*q == ',') {
                q++; while (isspace((unsigned char)*q)) q++;
                goto parse_struct_declarator;
            }
            q++;
            }
        }
        if (members == 0) { fprintf(stderr,"x86-cc: struct: empty definition %s\n",sname); return 0; }
        while (isspace((unsigned char)*q)) q++;
        /* A definition may also declare objects: struct S { ... } x, y;.
         * Layout scanning only needs the type; skip the trailing declaration
         * (including an initializer) to its top-level semicolon. */
        if (*q != ';') {
            int brace=0, bracket=0, paren=0, quote=0, esc=0;
            while (*q) {
                char c=*q;
                if (quote) { if (esc) esc=0; else if (c=='\\') esc=1; else if (c==quote) quote=0; q++; continue; }
                if (c=='\"' || c=='\'') { quote=c; q++; continue; }
                if (c=='{') brace++; else if(c=='}'&&brace>0) brace--;
                else if(c=='[') bracket++; else if(c==']'&&bracket>0) bracket--;
                else if(c=='(') paren++; else if(c==')'&&paren>0) paren--;
                else if(c==';'&&brace==0&&bracket==0&&paren==0) break;
                q++;
            }
            if (*q != ';') { fprintf(stderr,"x86-cc: struct: unterminated trailing declarator for %s\n",sname); return 0; }
        }
        q++;
        g_structs[sid].member_count = members;
        g_structs[sid].size_bytes = size_bytes;
        g_struct_count++;
        p = q;
    }
    return 1;
}

#define MAX_LOCALS 1024 /* Phase 5E: permit aggregate frames beyond 1 KiB */
#define MAX_GLOBALS 128

typedef struct {
    char name[64];
    int is_pointer;
    int is_far;     /* 16-bit x86 far pointer: segment:offset, stored as 4 bytes */
    int is_char;
    int width;
    int array_len;
    int has_init;
    long init_value;
    char init_symbol[64];
    long init_addend;
    int init_count;
    long init_values[64];
    int struct_id;
} GlobalObject;

static GlobalObject g_globals[MAX_GLOBALS];
static int g_global_count;

static int global_find(const char *name) {
    int i;
    for (i = 0; i < g_global_count; i++)
        if (!strcmp(g_globals[i].name, name)) return i;
    return -1;
}

typedef struct {
    char name[64];
    int offset; /* signed BP displacement: locals negative, parameters positive */
    int is_pointer; /* Phase 4I: pointer depth (0, 1, or 2) */
    int is_far;     /* Blackjack16 far pointer: 32-bit segment:offset object */
    int is_char;    /* Phase 4F: char object, or char element/pointee when pointer/array */
    int array_len;  /* >0 for local array objects */
    int struct_id;  /* Phase 5A: >=0 for a local struct object */
    int width;      /* scalar object width in bytes; pointers remain 2 */
    int pointee_width; /* element width for typed near pointers */
} Local;

typedef struct {
    const char *p;
    int ok;
    FILE *out;
    Local locals[MAX_LOCALS];
    int nlocals;
    int total_locals;
    int scope_depth;
    int scope_base[32];
    int next_label;
    int loop_depth;
    int break_label[32];
    int continue_label[32];
    int loop_kind[32]; /* 0=while, 1=for, 2=do */
    int switch_depth;
    int switch_end_label[16];
    int switch_case_base[16];
    int switch_case_index[16];
    int switch_outer_loop_depth[16];
    char return_label[80];
    int expr_is_pointer; /* Phase 4I: pointer depth of most recent expression */
    int expr_pointer_char; /* base type is char when pointer depth > 0 */
    int expr_struct_id; /* Phase 5B: >=0 when expression is pointer to named struct */
    int expr_width; /* scalar result width: 1/2/4 */
    int expr_is_null_constant; /* integer constant expression 0, valid null pointer constant */
    int lvalue_far; /* most recent lvalue address is through a far segment (ES:AX) */
    int lvalue_width; /* byte width of the object addressed by the most recent lvalue */
    int is_variadic_function;
    int fixed_param_bytes;
} BodyParser;

static void body_ws(BodyParser *b) {
    for (;;) {
        while (isspace((unsigned char)*b->p)) b->p++;
        if (b->p[0] == '/' && b->p[1] == '*') {
            const char *end = strstr(b->p + 2, "*/");
            if (!end) { b->ok = 0; return; }
            b->p = end + 2;
            continue;
        }
        if (b->p[0] == '/' && b->p[1] == '/') {
            b->p += 2;
            while (*b->p && *b->p != '\n') b->p++;
            continue;
        }
        return;
    }
}

static int body_ident(BodyParser *b, char *name, size_t namesz) {
    const char *start;
    size_t n;
    body_ws(b);
    if (!(isalpha((unsigned char)*b->p) || *b->p == '_')) return 0;
    start = b->p++;
    while (isalnum((unsigned char)*b->p) || *b->p == '_') b->p++;
    n = (size_t)(b->p - start);
    if (n + 1 > namesz) { b->ok = 0; return 0; }
    memcpy(name, start, n);
    name[n] = '\0';
    return 1;
}

static int body_kw(BodyParser *b, const char *kw) {
    size_t n = strlen(kw);
    body_ws(b);
    if (strncmp(b->p, kw, n) != 0) return 0;
    if (isalnum((unsigned char)b->p[n]) || b->p[n] == '_') return 0;
    b->p += n;
    return 1;
}

static int local_find(BodyParser *b, const char *name) {
    int i;
    /* Search innermost declarations first so a block-local may shadow an
     * outer declaration without changing expression code generation. */
    for (i = b->nlocals - 1; i >= 0; i--)
        if (!strcmp(b->locals[i].name, name)) return i;
    return -1;
}

static int local_find_current_scope(BodyParser *b, const char *name) {
    int i;
    int base = b->scope_depth > 0 ? b->scope_base[b->scope_depth - 1] : 0;
    for (i = b->nlocals - 1; i >= base; i--)
        if (!strcmp(b->locals[i].name, name)) return i;
    return -1;
}

static void scope_enter(BodyParser *b) {
    if (b->scope_depth >= 32) { b->ok = 0; return; }
    b->scope_base[b->scope_depth++] = b->nlocals;
}

static void scope_leave(BodyParser *b) {
    if (b->scope_depth <= 0) { b->ok = 0; return; }
    b->nlocals = b->scope_base[--b->scope_depth];
}

static int local_add_typed(BodyParser *b, const char *name, int is_pointer, int is_char, int pointee_width) {
    Local *l;
    if (b->nlocals >= MAX_LOCALS || b->total_locals >= MAX_LOCALS ||
        local_find_current_scope(b, name) >= 0) {
        b->ok = 0;
        return -1;
    }
    l = &b->locals[b->nlocals];
    snprintf(l->name, sizeof(l->name), "%s", name);
    /* Keep each declaration on a distinct preallocated frame slot.  Scope
     * exit removes the name from lookup, not the already reserved storage. */
    l->offset = -2 * (b->total_locals + 1);
    l->is_pointer = is_pointer;
    l->is_far = 0;
    l->is_char = is_char;
    l->array_len = 0;
    l->struct_id = -1;
    l->width = is_pointer ? 2 : (is_char ? 1 : 2);
    l->pointee_width = pointee_width;
    b->total_locals++;
    return b->nlocals++;
}

static int local_add_far_pointer(BodyParser *b, const char *name, int is_char) {
    Local *l;
    int slots = 2;

    if (b->nlocals >= MAX_LOCALS || b->total_locals + slots > MAX_LOCALS ||
        local_find_current_scope(b, name) >= 0) {
        b->ok = 0;
        return -1;
    }

    l = &b->locals[b->nlocals];
    snprintf(l->name, sizeof(l->name), "%s", name);
    l->offset = -2 * (b->total_locals + slots);
    l->is_pointer = 1;
    l->is_far = 1;
    l->is_char = is_char;
    l->array_len = 0;
    l->struct_id = -1;
    l->width = 4;
    b->total_locals += slots;
    return b->nlocals++;
}

static int local_add_wide(BodyParser *b, const char *name, int width) {
    Local *l;
    int slots = (width + 1) / 2;
    if (width <= 2) return local_add_typed(b, name, 0, width == 1, width);
    if (width != 4 || b->nlocals >= MAX_LOCALS || b->total_locals + slots > MAX_LOCALS ||
        local_find_current_scope(b, name) >= 0) { b->ok = 0; return -1; }
    l = &b->locals[b->nlocals];
    snprintf(l->name, sizeof(l->name), "%s", name);
    l->offset = -2 * (b->total_locals + slots);
    l->is_pointer = 0; l->is_char = 0; l->array_len = 0; l->struct_id = -1; l->width = width;
    b->total_locals += slots;
    return b->nlocals++;
}

static int local_add_array(BodyParser *b, const char *name, int array_len, int is_char, int element_pointer_depth, int element_width) {
    Local *l;
    int byte_width = element_pointer_depth ? 2 : element_width;
    int slots_needed = (array_len * byte_width + 1) / 2;
    if (array_len <= 0 || byte_width < 1 || byte_width > 4 || b->nlocals >= MAX_LOCALS ||
        b->total_locals + slots_needed > MAX_LOCALS ||
        local_find_current_scope(b, name) >= 0) {
        b->ok = 0;
        return -1;
    }
    l = &b->locals[b->nlocals];
    snprintf(l->name, sizeof(l->name), "%s", name);
    /* Arrays are contiguous. int elements occupy two bytes; char elements one. */
    {
        int slots = slots_needed;
        l->offset = -2 * (b->total_locals + slots);
        b->total_locals += slots;
    }
    l->is_pointer = element_pointer_depth;
    l->is_char = is_char;
    l->array_len = array_len;
    l->struct_id = -1;
    l->width = byte_width;
    return b->nlocals++;
}

static int local_add_struct(BodyParser *b, const char *name, int sid) {
    Local *l;
    int slots;
    if (sid < 0 || sid >= g_struct_count) { b->ok = 0; return -1; }
    slots = (g_structs[sid].size_bytes + 1) / 2;
    if (b->nlocals >= MAX_LOCALS || b->total_locals + slots > MAX_LOCALS ||
        local_find_current_scope(b, name) >= 0) { b->ok = 0; return -1; }
    l = &b->locals[b->nlocals];
    snprintf(l->name, sizeof(l->name), "%s", name);
    l->offset = -2 * (b->total_locals + slots);
    l->is_pointer = 0;
    l->is_char = 0;
    l->array_len = 0;
    l->struct_id = sid;
    b->total_locals += slots;
    return b->nlocals++;
}

static int local_add_struct_pointer(BodyParser *b, const char *name, int sid) {
    Local *l;
    if (sid < 0 || sid >= g_struct_count) { b->ok = 0; return -1; }
    if (b->nlocals >= MAX_LOCALS || b->total_locals >= MAX_LOCALS ||
        local_find_current_scope(b, name) >= 0) { b->ok = 0; return -1; }
    l = &b->locals[b->nlocals];
    snprintf(l->name, sizeof(l->name), "%s", name);
    l->offset = -2 * (b->total_locals + 1);
    l->is_pointer = 1;
    l->is_char = 0;
    l->array_len = 0;
    l->struct_id = sid;
    b->total_locals++;
    return b->nlocals++;
}



#define MAX_FUNCTIONS 256
static int g_function_count;
static char g_function_names[MAX_FUNCTIONS][64];
static int g_function_arity[MAX_FUNCTIONS];
static int g_function_variadic[MAX_FUNCTIONS];
static int g_function_defined[MAX_FUNCTIONS];
static int g_function_param_pointer[MAX_FUNCTIONS][8];
static int g_function_param_char[MAX_FUNCTIONS][8];
static int g_function_param_width[MAX_FUNCTIONS][8];
static int g_function_return_width[MAX_FUNCTIONS];
static int g_function_return_pointer[MAX_FUNCTIONS];
static int g_function_return_struct[MAX_FUNCTIONS];
static int g_function_return_char[MAX_FUNCTIONS];

static int function_arity(const char *name) {
    int i;
    for (i = 0; i < g_function_count; i++)
        if (!strcmp(g_function_names[i], name)) return g_function_arity[i];
    return -1;
}

static int function_variadic(const char *name) {
    int i;
    for (i = 0; i < g_function_count; i++)
        if (!strcmp(g_function_names[i], name)) return g_function_variadic[i];
    return 0;
}

static int function_defined(const char *name) {
    int i;
    for (i = 0; i < g_function_count; i++)
        if (!strcmp(g_function_names[i], name)) {
            if (g_function_defined[i]) return 1;
            if (g_relocatable_output) return 1;
            if (g_blackjack_target && (!strcmp(name, "write") || !strcmp(name, "open") || !strcmp(name, "creat") || !strcmp(name, "mkdir") || !strcmp(name, "read") || !strcmp(name, "close") || !strcmp(name, "socket") || !strcmp(name, "sendto") || !strcmp(name, "recvfrom") || !strcmp(name, "bj_write") || !strcmp(name, "bj_mem_kb") || !strcmp(name, "bj_mem_used_kb") || !strcmp(name, "bj_shutdown") || !strcmp(name, "bj_date") || !strcmp(name, "bj_time") || !strcmp(name, "bj_sleep_ms") || !strcmp(name, "bj_open") || !strcmp(name, "bj_read") || !strcmp(name, "bj_close") || !strcmp(name, "bj_file_save") || !strcmp(name, "bj_create") || !strcmp(name, "bj_getch") || !strcmp(name, "bj_args") || !strcmp(name, "bj_netif_get") || !strcmp(name, "bj_netif_get_eth0") || !strcmp(name, "bj_netif_up") || !strcmp(name, "bj_netif_down") || !strcmp(name, "bj_route_get") || !strcmp(name, "bj_process_get") || !strcmp(name, "bj_date_md") || !strcmp(name, "bj_time_sec") || !strcmp(name, "time") || !strcmp(name, "localtime") || !strcmp(name, "printf"))) return 1;
            return 0;
        }
    return 0;
}

static int function_param_is_pointer(const char *name, int index) {
    int i;
    for (i = 0; i < g_function_count; i++) {
        if (!strcmp(g_function_names[i], name)) {
            if (index < 0 || index >= g_function_arity[i]) return -1;
            return g_function_param_pointer[i][index];
        }
    }
    return -1;
}


static int function_param_width(const char *name, int index) {
    int i;
    for (i = 0; i < g_function_count; i++) {
        if (!strcmp(g_function_names[i], name)) {
            if (index < 0 || index >= g_function_arity[i]) return -1;
            return g_function_param_width[i][index];
        }
    }
    return -1;
}

static int function_return_width(const char *name) {
    int i;
    for (i = 0; i < g_function_count; i++)
        if (!strcmp(g_function_names[i], name)) return g_function_return_width[i];
    return -1;
}

static int function_return_pointer(const char *name) {
    int i;
    for (i = 0; i < g_function_count; i++)
        if (!strcmp(g_function_names[i], name)) return g_function_return_pointer[i];
    return 0;
}
static int function_return_struct(const char *name) {
    int i;
    for (i = 0; i < g_function_count; i++)
        if (!strcmp(g_function_names[i], name)) return g_function_return_struct[i];
    return -1;
}

static int function_return_char(const char *name) {
    int i;
    for (i = 0; i < g_function_count; i++)
        if (!strcmp(g_function_names[i], name)) return g_function_return_char[i];
    return 0;
}

static int pointer_char_compatible(int a, int b) {
    return a < 0 || b < 0 || a == b;
}

static int function_param_is_char(const char *name, int index) {
    int i;
    for (i = 0; i < g_function_count; i++) {
        if (!strcmp(g_function_names[i], name)) {
            if (index < 0 || index >= g_function_arity[i]) return -1;
            return g_function_param_char[i][index];
        }
    }
    return -1;
}
static void emit_bp_load(FILE *out, int offset) {
    if (offset >= 0) fprintf(out, "    mov ax, [bp+%d]\n", offset);
    else fprintf(out, "    mov ax, [bp-%d]\n", -offset);
}

static void emit_bp_store(FILE *out, int offset) {
    if (offset >= 0) fprintf(out, "    mov [bp+%d], ax\n", offset);
    else fprintf(out, "    mov [bp-%d], ax\n", -offset);
}

static void emit_bp_store_dx(FILE *out, int offset) {
    if (offset >= 0) fprintf(out, "    mov [bp+%d], dx\n", offset);
    else fprintf(out, "    mov [bp-%d], dx\n", -offset);
}

static void emit_bp_load_char(FILE *out, int offset) {
    if (offset >= 0) fprintf(out, "    mov al, [bp+%d]\n", offset);
    else fprintf(out, "    mov al, [bp-%d]\n", -offset);
    fprintf(out, "    mov ah, 0\n");
}

static void emit_bp_store_char(FILE *out, int offset) {
    if (offset >= 0) fprintf(out, "    mov [bp+%d], al\n", offset);
    else fprintf(out, "    mov [bp-%d], al\n", -offset);
}

static void cg_expr(BodyParser *b);
static void cg_unary(BodyParser *b);

static int g_optimization_level = 1;
static void emit_local_address(FILE *out, int offset) {
    fprintf(out, "    mov ax, bp\n");
    if (offset == 0) return;
    if (g_optimization_level == 0) {
        fprintf(out, "    mov bx, %d\n", offset < 0 ? -offset : offset);
        fprintf(out, offset < 0 ? "    sub ax, bx\n" : "    add ax, bx\n");
    } else {
        fprintf(out, offset < 0 ? "    sub ax, %d\n" : "    add ax, %d\n", offset < 0 ? -offset : offset);
    }
}

/* Phase 4B: generate the address of an assignable expression instead of
 * immediately loading its value.  This is the compiler's first explicit
 * lvalue path.  The current type system has only int and int *, so an lvalue
 * is either an int object or an int * object. */
static int cg_lvalue_address(BodyParser *b, int *lvalue_is_pointer, int *lvalue_is_char, int *lvalue_struct_id) {
    char name[64];
    int idx;
    body_ws(b);
    b->lvalue_far = 0;
    b->lvalue_width = 2;

    if (*b->p == '*') {
        b->p++;
        /* Remember the pointee width for a simple typed local pointer. */
        {
            const char *q = b->p;
            char pn[64]; size_t k = 0;
            while (isspace((unsigned char)*q)) q++;
            while ((isalnum((unsigned char)*q) || *q == '_') && k + 1 < sizeof(pn)) pn[k++] = *q++;
            pn[k] = 0;
            idx = local_find(b, pn);
            if (idx >= 0 && b->locals[idx].is_pointer == 1)
                b->lvalue_width = b->locals[idx].pointee_width;
        }
        /* For *E, E supplies the address.  Do not perform the load here. */
        cg_unary(b);
        if (!b->ok || b->expr_is_pointer <= 0) { b->ok = 0; return 0; }
        *lvalue_is_pointer = b->expr_is_pointer - 1;
        *lvalue_is_char = b->expr_pointer_char;
        *lvalue_struct_id = b->expr_struct_id;
        b->expr_is_pointer = 1; /* internal: AX is the lvalue address */
        return 1;
    }

    if (!body_ident(b, name, sizeof(name))) { b->ok = 0; return 0; }
    idx = local_find(b, name);
    if (idx < 0) {
        int gi = global_find(name);
        if (gi < 0) { b->ok = 0; return 0; }
        body_ws(b);
        if (g_globals[gi].struct_id >= 0 && g_globals[gi].is_pointer == 0 && *b->p == '.') {
            char member[64]; int mid; b->p++;
            if (!body_ident(b, member, sizeof(member))) { b->ok=0; return 0; }
            mid=struct_member_find(g_globals[gi].struct_id,member); if(mid<0){b->ok=0;return 0;}
            fprintf(b->out, "    mov ax, .G_%s\n", name);
            if(g_structs[g_globals[gi].struct_id].member_offset[mid]) fprintf(b->out,"    mov bx, %d\n    add ax, bx\n",g_structs[g_globals[gi].struct_id].member_offset[mid]);
            *lvalue_is_pointer=g_structs[g_globals[gi].struct_id].member_pointer[mid]; *lvalue_is_char=g_structs[g_globals[gi].struct_id].member_char[mid]; *lvalue_struct_id=g_structs[g_globals[gi].struct_id].member_struct_id[mid]; b->lvalue_width=g_structs[g_globals[gi].struct_id].member_width[mid];
            b->expr_is_pointer=1; b->expr_pointer_char=*lvalue_is_char; b->expr_struct_id=*lvalue_struct_id; return 1;
        }
        if (!strncmp(b->p, "->", 2)) {
            char member[64]; int mid;
            if (g_globals[gi].struct_id < 0 || g_globals[gi].is_pointer != 1) { b->ok=0; return 0; }
            b->p += 2;
            if (!body_ident(b, member, sizeof(member))) { b->ok=0; return 0; }
            mid=struct_member_find(g_globals[gi].struct_id,member); if(mid<0){b->ok=0;return 0;}
            fprintf(b->out, "    mov ax, [.G_%s]\n", name);
            if(g_structs[g_globals[gi].struct_id].member_offset[mid]) fprintf(b->out,"    mov bx, %d\n    add ax, bx\n",g_structs[g_globals[gi].struct_id].member_offset[mid]);
            *lvalue_is_pointer=g_structs[g_globals[gi].struct_id].member_pointer[mid];
            *lvalue_is_char=g_structs[g_globals[gi].struct_id].member_char[mid];
            *lvalue_struct_id=g_structs[g_globals[gi].struct_id].member_struct_id[mid];
            body_ws(b);
            while (*lvalue_is_pointer == 1 && *lvalue_struct_id >= 0 && !strncmp(b->p, "->", 2)) {
                int sid = *lvalue_struct_id;
                b->p += 2;
                if (!body_ident(b, member, sizeof(member))) { b->ok=0; return 0; }
                mid=struct_member_find(sid,member); if(mid<0){b->ok=0;return 0;}
                fprintf(b->out, "    mov bx, ax\n    mov ax, [bx]\n");
                if(g_structs[sid].member_offset[mid]) fprintf(b->out,"    mov bx, %d\n    add ax, bx\n",g_structs[sid].member_offset[mid]);
                *lvalue_is_pointer=g_structs[sid].member_pointer[mid];
                *lvalue_is_char=g_structs[sid].member_char[mid];
                *lvalue_struct_id=g_structs[sid].member_struct_id[mid];
                body_ws(b);
            }
            b->expr_is_pointer=1; b->expr_pointer_char=*lvalue_is_char; b->expr_struct_id=*lvalue_struct_id; return 1;
        }
        if (*b->p == '[') {
            int element_is_char = g_globals[gi].is_char;
            int element_pointer_depth = g_globals[gi].array_len ? g_globals[gi].is_pointer :
                                        (g_globals[gi].is_pointer ? g_globals[gi].is_pointer - 1 : 0);
            int base_is_array = g_globals[gi].array_len > 0;
            if (!base_is_array && !g_globals[gi].is_pointer) { b->ok = 0; return 0; }
            b->p++; cg_expr(b);
            if (!b->ok || b->expr_is_pointer) { b->ok = 0; return 0; }
            body_ws(b); if (*b->p != ']') { b->ok = 0; return 0; } b->p++;
            if (base_is_array && g_globals[gi].struct_id >= 0 && !g_globals[gi].is_pointer) {
                int ew = g_structs[g_globals[gi].struct_id].size_bytes;
                if (ew == 2) fprintf(b->out, "    add ax, ax\n");
                else if (ew != 1) fprintf(b->out, "    mov bx, %d\n    mul bx\n", ew);
            } else if (g_globals[gi].width == 4 && element_pointer_depth == 0)
                fprintf(b->out, "    add ax, ax\n    add ax, ax\n");
            else if (!(element_is_char && element_pointer_depth == 0)) fprintf(b->out, "    add ax, ax\n");
            if (base_is_array) fprintf(b->out, "    mov bx, .G_%s\n", name);
            else if (g_globals[gi].is_far) {
                fprintf(b->out, "    mov bx, [.G_%s]\n", name);
                fprintf(b->out, "    mov dx, [.G_%s+2]\n", name);
                fprintf(b->out, "    mov es, dx\n");
                b->lvalue_far = 1;
            } else fprintf(b->out, "    mov bx, [.G_%s]\n", name);
            fprintf(b->out, "    add ax, bx\n");
            *lvalue_is_pointer = element_pointer_depth;
            *lvalue_is_char = element_is_char;
            b->lvalue_width = element_pointer_depth ? 2 : g_globals[gi].width;
            if (base_is_array && g_globals[gi].struct_id >= 0 && !g_globals[gi].is_pointer) {
                char member[64]; int mid;
                *lvalue_struct_id = g_globals[gi].struct_id;
                body_ws(b);
                if (*b->p == '.') {
                    b->p++;
                    if (!body_ident(b, member, sizeof(member))) { b->ok=0; return 0; }
                    mid=struct_member_find(g_globals[gi].struct_id,member); if(mid<0){b->ok=0;return 0;}
                    if(g_structs[g_globals[gi].struct_id].member_offset[mid]) fprintf(b->out,"    mov bx, %d\n    add ax, bx\n",g_structs[g_globals[gi].struct_id].member_offset[mid]);
                    *lvalue_is_pointer=g_structs[g_globals[gi].struct_id].member_pointer[mid];
                    *lvalue_is_char=g_structs[g_globals[gi].struct_id].member_char[mid];
                    *lvalue_struct_id=g_structs[g_globals[gi].struct_id].member_struct_id[mid];
                    b->lvalue_width=g_structs[g_globals[gi].struct_id].member_width[mid];
                    body_ws(b);
                    while (*lvalue_struct_id >= 0 && !*lvalue_is_pointer && *b->p == '.') {
                        int sid=*lvalue_struct_id;
                        b->p++;
                        if(!body_ident(b,member,sizeof(member))){b->ok=0;return 0;}
                        mid=struct_member_find(sid,member);if(mid<0){b->ok=0;return 0;}
                        if(g_structs[sid].member_offset[mid])fprintf(b->out,"    mov bx, %d\n    add ax, bx\n",g_structs[sid].member_offset[mid]);
                        *lvalue_is_pointer=g_structs[sid].member_pointer[mid];
                        *lvalue_is_char=g_structs[sid].member_char[mid];
                        *lvalue_struct_id=g_structs[sid].member_struct_id[mid];
                        b->lvalue_width=g_structs[sid].member_width[mid];
                        body_ws(b);
                    }
                }
            }
        } else {
            if (g_globals[gi].array_len) { b->ok = 0; return 0; }
            fprintf(b->out, "    mov ax, .G_%s\n", name);
            *lvalue_is_pointer = g_globals[gi].is_pointer;
            *lvalue_is_char = g_globals[gi].is_char;
            b->lvalue_width = g_globals[gi].width;
        }
        if (!(g_globals[gi].array_len > 0 && g_globals[gi].struct_id >= 0 && !g_globals[gi].is_pointer))
            *lvalue_struct_id = g_globals[gi].struct_id;
        b->expr_is_pointer = 1;
        b->expr_pointer_char = *lvalue_is_char;
        b->expr_struct_id = g_globals[gi].struct_id;
        return 1;
    }
    body_ws(b);
    if (!strncmp(b->p, "->", 2)) {
        char member[64];
        int mid;
        if (b->locals[idx].struct_id < 0 || b->locals[idx].is_pointer != 1 || b->locals[idx].array_len > 0) {
            b->ok = 0; return 0;
        }
        b->p += 2;
        if (!body_ident(b, member, sizeof(member))) { b->ok = 0; return 0; }
        mid = struct_member_find(b->locals[idx].struct_id, member);
        if (mid < 0) { b->ok = 0; return 0; }
        emit_bp_load(b->out, b->locals[idx].offset);
        if (g_structs[b->locals[idx].struct_id].member_offset[mid]) {
            if (g_optimization_level > 0)
                fprintf(b->out, "    add ax, %d\n", g_structs[b->locals[idx].struct_id].member_offset[mid]);
            else {
                fprintf(b->out, "    mov bx, %d\n", g_structs[b->locals[idx].struct_id].member_offset[mid]);
                fprintf(b->out, "    add ax, bx\n");
            }
        }
        *lvalue_is_pointer = g_structs[b->locals[idx].struct_id].member_pointer[mid];
        *lvalue_is_char = g_structs[b->locals[idx].struct_id].member_char[mid];
        *lvalue_struct_id = g_structs[b->locals[idx].struct_id].member_struct_id[mid];
        b->lvalue_width = g_structs[b->locals[idx].struct_id].member_width[mid];
        body_ws(b);
        while (*lvalue_struct_id >= 0) {
            int sid = *lvalue_struct_id;
            if (*lvalue_is_pointer == 1 && !strncmp(b->p, "->", 2)) {
                b->p += 2;
                if (!body_ident(b, member, sizeof(member))) { b->ok = 0; return 0; }
                mid = struct_member_find(sid, member);
                if (mid < 0) { b->ok = 0; return 0; }
                fprintf(b->out, "    mov bx, ax\n    mov ax, [bx]\n");
            } else if (*lvalue_is_pointer == 0 && *b->p == '.') {
                b->p++;
                if (!body_ident(b, member, sizeof(member))) { b->ok = 0; return 0; }
                mid = struct_member_find(sid, member);
                if (mid < 0) { b->ok = 0; return 0; }
            } else break;
            if (g_structs[sid].member_offset[mid]) {
                if (g_optimization_level > 0)
                    fprintf(b->out, "    add ax, %d\n", g_structs[sid].member_offset[mid]);
                else
                    fprintf(b->out, "    mov bx, %d\n    add ax, bx\n", g_structs[sid].member_offset[mid]);
            }
            *lvalue_is_pointer = g_structs[sid].member_pointer[mid];
            *lvalue_is_char = g_structs[sid].member_char[mid];
            *lvalue_struct_id = g_structs[sid].member_struct_id[mid];
            b->lvalue_width = g_structs[sid].member_width[mid];
            body_ws(b);
        }
        /* Phase 5E: an array member is an addressable array object.  Compose
         * arrow-member addressing with the ordinary subscript operation. */
        body_ws(b);
        if (g_structs[b->locals[idx].struct_id].member_array_len[mid] > 0 && *b->p == '[') {
            int elem_width = g_structs[b->locals[idx].struct_id].member_width[mid];
            fprintf(b->out, "    push ax\n");
            b->p++; cg_expr(b);
            if (!b->ok || b->expr_is_pointer) { b->ok = 0; return 0; }
            body_ws(b); if (*b->p != ']') { b->ok = 0; return 0; } b->p++;
            if (elem_width == 2) fprintf(b->out, "    add ax, ax\n");
            else if (elem_width == 4) fprintf(b->out, "    add ax, ax\n    add ax, ax\n");
            else if (elem_width != 1) { b->ok = 0; return 0; }
            fprintf(b->out, "    pop bx\n    add ax, bx\n");
            *lvalue_is_pointer = g_structs[b->locals[idx].struct_id].member_pointer[mid];
        } else if (g_structs[b->locals[idx].struct_id].member_array_len[mid] > 0) {
            /* Sentinel consumed by primary-expression handling: the address
             * already in AX is the decayed pointer value; do not load it. */
            *lvalue_struct_id = -2;
        }
        b->expr_is_pointer = 1;
        b->expr_pointer_char = *lvalue_is_char;
        b->expr_struct_id = *lvalue_struct_id;
        return 1;
    }
    if (*b->p == '.') {
        char member[64];
        int mid;
        if (b->locals[idx].struct_id < 0 || b->locals[idx].is_pointer != 0) { b->ok = 0; return 0; }
        b->p++;
        if (!body_ident(b, member, sizeof(member))) { b->ok = 0; return 0; }
        mid = struct_member_find(b->locals[idx].struct_id, member);
        if (mid < 0) { b->ok = 0; return 0; }
        emit_local_address(b->out, b->locals[idx].offset);
        if (g_structs[b->locals[idx].struct_id].member_offset[mid]) {
            if (g_optimization_level > 0)
                fprintf(b->out, "    add ax, %d\n", g_structs[b->locals[idx].struct_id].member_offset[mid]);
            else {
                fprintf(b->out, "    mov bx, %d\n", g_structs[b->locals[idx].struct_id].member_offset[mid]);
                fprintf(b->out, "    add ax, bx\n");
            }
        }
        *lvalue_is_pointer = g_structs[b->locals[idx].struct_id].member_pointer[mid];
        *lvalue_is_char = g_structs[b->locals[idx].struct_id].member_char[mid];
        *lvalue_struct_id = g_structs[b->locals[idx].struct_id].member_struct_id[mid];
        b->lvalue_width = g_structs[b->locals[idx].struct_id].member_width[mid];
        body_ws(b);
        while (*lvalue_struct_id >= 0) {
            int sid=*lvalue_struct_id;
            if (*lvalue_is_pointer == 1 && !strncmp(b->p, "->", 2)) {
                b->p+=2;
                if(!body_ident(b,member,sizeof(member))){b->ok=0;return 0;}
                mid=struct_member_find(sid,member);if(mid<0){b->ok=0;return 0;}
                fprintf(b->out,"    mov bx, ax\n    mov ax, [bx]\n");
            } else if (*lvalue_is_pointer == 0 && *b->p == '.') {
                b->p++;
                if(!body_ident(b,member,sizeof(member))){b->ok=0;return 0;}
                mid=struct_member_find(sid,member);if(mid<0){b->ok=0;return 0;}
            } else break;
            if(g_structs[sid].member_offset[mid])fprintf(b->out,"    mov bx, %d\n    add ax, bx\n",g_structs[sid].member_offset[mid]);
            *lvalue_is_pointer=g_structs[sid].member_pointer[mid];
            *lvalue_is_char=g_structs[sid].member_char[mid];
            *lvalue_struct_id=g_structs[sid].member_struct_id[mid];
            b->lvalue_width=g_structs[sid].member_width[mid];
            body_ws(b);
        }
        if (g_structs[b->locals[idx].struct_id].member_array_len[mid] > 0 && *b->p == '[') {
            int elem_width = g_structs[b->locals[idx].struct_id].member_width[mid];
            fprintf(b->out, "    push ax\n");
            b->p++; cg_expr(b);
            if (!b->ok || b->expr_is_pointer) { b->ok = 0; return 0; }
            body_ws(b); if (*b->p != ']') { b->ok = 0; return 0; } b->p++;
            if (elem_width == 2) fprintf(b->out, "    add ax, ax\n");
            else if (elem_width == 4) fprintf(b->out, "    add ax, ax\n    add ax, ax\n");
            else if (elem_width != 1) { b->ok = 0; return 0; }
            fprintf(b->out, "    pop bx\n    add ax, bx\n");
        } else if (g_structs[b->locals[idx].struct_id].member_array_len[mid] > 0) {
            *lvalue_struct_id = -2;
        }
        b->expr_is_pointer = 1;
        b->expr_pointer_char = *lvalue_is_char;
        b->expr_struct_id = -1;
        return 1;
    }
    if (*b->p == '[') {
        int base_is_array = b->locals[idx].array_len > 0;
        int base_is_pointer = b->locals[idx].is_pointer;
        int element_is_char = b->locals[idx].is_char;
        int element_pointer_depth = base_is_array ? base_is_pointer : (base_is_pointer ? base_is_pointer - 1 : 0);
        if (!base_is_array && !base_is_pointer) { b->ok = 0; return 0; }
        b->p++;
        cg_expr(b);
        if (!b->ok || b->expr_is_pointer) { b->ok = 0; return 0; }
        body_ws(b);
        if (*b->p != ']') { b->ok = 0; return 0; }
        b->p++;
        /* Phase 4H: a[i] and p[i] share one indexed-lvalue path. AX holds
         * the scalar index. Scale by the pointee size, then add either the
         * local array base address or the pointer value loaded from its slot. */
        if ((base_is_array ? b->locals[idx].width : b->locals[idx].pointee_width) == 4)
            fprintf(b->out, "    add ax, ax\n    add ax, ax\n");
        else if (!((base_is_array && base_is_pointer == 0 && element_is_char) ||
                   (!base_is_array && base_is_pointer == 1 && element_is_char)))
            fprintf(b->out, "    add ax, ax\n");
        fprintf(b->out, "    push ax\n");
        if (base_is_array) {
            emit_local_address(b->out, b->locals[idx].offset);
        } else {
            emit_bp_load(b->out, b->locals[idx].offset);
            if (b->locals[idx].is_far) {
                if (b->locals[idx].offset + 2 >= 0)
                    fprintf(b->out, "    mov dx, [bp+%d]\n", b->locals[idx].offset + 2);
                else
                    fprintf(b->out, "    mov dx, [bp-%d]\n", -(b->locals[idx].offset + 2));
                fprintf(b->out, "    mov es, dx\n");
                b->lvalue_far = 1;
            }
        }
        fprintf(b->out, "    pop bx\n");
        fprintf(b->out, "    add ax, bx\n");
        b->lvalue_width = base_is_array ? b->locals[idx].width : b->locals[idx].pointee_width;
        *lvalue_is_pointer = element_pointer_depth;
        *lvalue_is_char = element_is_char;
        *lvalue_struct_id = -1;
        b->expr_is_pointer = 1; /* internal: AX is the element address */
        b->expr_pointer_char = element_is_char;
        return 1;
    }
    if (b->locals[idx].array_len > 0) { b->ok = 0; return 0; }
    emit_local_address(b->out, b->locals[idx].offset);
    *lvalue_is_pointer = b->locals[idx].is_pointer;
    *lvalue_is_char = b->locals[idx].is_char;
    *lvalue_struct_id = b->locals[idx].struct_id;
    b->expr_is_pointer = 1; /* internal: AX is the object address */
    b->expr_pointer_char = b->locals[idx].is_char;
    b->expr_struct_id = b->locals[idx].struct_id;
    return 1;
}

static int cg_indirect_call(BodyParser *b)
{
    char *arg_text[16] = {0};
    int argc=0, idx, arg_words=0;
    const char *as, *q;
    body_ws(b);
    if (*b->p != '(') return 0;

    /* AX is the address of the function-pointer object.  Keep the loaded
     * target in SI while argument expressions are evaluated. */
    fprintf(b->out, "    mov bx, ax\n    mov si, [bx]\n");
    b->p++; body_ws(b);
    as=b->p; q=b->p;
    if (*q != ')') for (;;) {
        const char *ae=q; size_t alen;
        int depth=0, in_string=0, in_char=0, escape=0;
        while (*q) {
            char ch=*q;
            if (escape) { escape=0; q++; continue; }
            if ((in_string||in_char) && ch=='\\') { escape=1; q++; continue; }
            if (!in_char && ch=='"') { in_string=!in_string; q++; continue; }
            if (!in_string && ch=='\'') { in_char=!in_char; q++; continue; }
            if (!in_string && !in_char) {
                if (ch=='(' || ch=='[') depth++;
                else if (ch==')' || ch==']') { if(ch==')' && depth==0) break; depth--; }
                else if (ch==',' && depth==0) break;
            }
            q++;
        }
        ae=q; while(ae>as && isspace((unsigned char)ae[-1])) ae--;
        while(as<ae && isspace((unsigned char)*as)) as++;
        alen=(size_t)(ae-as);
        if(!alen || argc>=16){b->ok=0;return 1;}
        arg_text[argc]=(char *)malloc(alen+1);
        if(!arg_text[argc]){b->ok=0;return 1;}
        memcpy(arg_text[argc],as,alen); arg_text[argc][alen]=0; argc++;
        if(*q==','){q++;as=q;continue;}
        break;
    }
    for(idx=argc-1;idx>=0;idx--) {
        BodyParser ab=*b;
        ab.p=arg_text[idx]; ab.ok=1; cg_expr(&ab); body_ws(&ab);
        if(!ab.ok || *ab.p){b->ok=0;return 1;}
        if(ab.expr_width==4 && !ab.expr_is_pointer) {
            fprintf(b->out,"    push dx\n    push ax\n"); arg_words+=2;
        } else {
            fprintf(b->out,"    push ax\n"); arg_words++;
        }
        free(arg_text[idx]); arg_text[idx]=NULL;
    }
    b->p=q; body_ws(b);
    if(*b->p!=')'){b->ok=0;return 1;}
    b->p++;
    fprintf(b->out,"    call si\n");
    while(arg_words-- > 0) fprintf(b->out,"    pop bx\n");
    b->expr_width=2; b->expr_is_pointer=0; b->expr_pointer_char=0; b->expr_struct_id=-1;
    return 1;
}

static void cg_primary(BodyParser *b) {
    char name[64];
    char *end = NULL;
    int idx;

    body_ws(b);
    if (*b->p == '\'') {
        unsigned char c;
        b->p++;
        if (*b->p == '\\') {
            b->p++;
            if (*b->p == 'n') c = '\n';
            else if (*b->p == 'r') c = '\r';
            else if (*b->p == 't') c = '\t';
            else if (*b->p == '0') c = 0;
            else c = (unsigned char)*b->p;
            if (*b->p) b->p++;
        } else c = (unsigned char)*b->p++;
        if (*b->p != '\'') { b->ok = 0; return; }
        b->p++;
        fprintf(b->out, "    mov ax, 0x%04X\n", (unsigned)c);
        b->expr_is_pointer = 0;
        b->expr_pointer_char = 0;
        b->expr_struct_id = -1;
        return;
    }
    if (*b->p == '"') {
        int string_id = intern_string_literal(&b->p);
        if (string_id < 0) { b->ok = 0; return; }
        fprintf(b->out, "    mov ax, .Lstr_%d\n", string_id);
        b->expr_is_pointer = 1;
        b->expr_pointer_char = 1;
        b->expr_struct_id = -1;
        return;
    }
    if (*b->p == '(') {
        b->p++;
        cg_expr(b);
        body_ws(b);
        if (*b->p != ')') { b->ok = 0; return; }
        b->p++;
        return;
    }
    if (isalpha((unsigned char)*b->p) || *b->p == '_') {
        const char *ident_start = b->p;
        if (!body_ident(b, name, sizeof(name))) { b->ok = 0; return; }
        body_ws(b);
        if (*b->p == '(') {
            int argc = 0, arg_words = 0, variadic = function_variadic(name);
            int arity = function_arity(name);
            char *arg_text[16] = {0};
            b->p++; body_ws(b);
            {
                /* One Blackjack/C ABI for every direct call: push arguments
                   right-to-left.  Prototype spelling (including variadic)
                   must not change the machine-level calling convention. */
                const char *as = b->p, *q = b->p;
                int depth = 0, in_string = 0, in_char = 0, escape = 0;
                if (*q != ')') for (;;) {
                    const char *ae = q; size_t alen;
                    while (*q) {
                        char ch = *q;
                        if (escape) { escape = 0; q++; continue; }
                        if ((in_string || in_char) && ch == '\\') { escape = 1; q++; continue; }
                        if (!in_char && ch == '"') { in_string = !in_string; q++; continue; }
                        if (!in_string && ch == '\'') { in_char = !in_char; q++; continue; }
                        if (!in_string && !in_char) {
                            if (ch == '(' || ch == '[') depth++;
                            else if (ch == ')' || ch == ']') { if (ch == ')' && depth == 0) break; depth--; }
                            else if (ch == ',' && depth == 0) break;
                        }
                        q++;
                    }
                    ae = q; while (ae > as && isspace((unsigned char)ae[-1])) ae--;
                    while (as < ae && isspace((unsigned char)*as)) as++;
                    alen = (size_t)(ae - as);
                    if (!alen || argc >= 16) { b->ok = 0; return; }
                    arg_text[argc] = (char *)malloc(alen + 1);
                    if (!arg_text[argc]) { b->ok = 0; return; }
                    memcpy(arg_text[argc], as, alen); arg_text[argc][alen] = 0; argc++;
                    if (*q == ',') { q++; as = q; continue; }
                    break;
                }
                if (arity < 0 || (variadic ? (argc < arity) : (argc != arity))) { b->ok = 0; return; }
                for (idx = argc - 1; idx >= 0; idx--) {
                    BodyParser ab = *b; int want_pointer, want_char, want_width;
                    ab.p = arg_text[idx]; ab.ok = 1; cg_expr(&ab); body_ws(&ab);
                    if (!ab.ok || *ab.p) { b->ok = 0; return; }
                    if (idx < arity) {
                        want_pointer = function_param_is_pointer(name, idx);
                        want_char = function_param_is_char(name, idx);
                        want_width = function_param_width(name, idx);
                        if (want_pointer < 0 || want_width < 0 || ab.expr_is_pointer != want_pointer ||
                            (want_pointer && !pointer_char_compatible(want_char, ab.expr_pointer_char))) { b->ok = 0; return; }
                    } else { want_pointer = ab.expr_is_pointer; want_width = ab.expr_width; }
                    if (want_width == 4 && !want_pointer) { if (ab.expr_width != 4) fprintf(b->out, "    xor dx, dx\n"); fprintf(b->out, "    push dx\n    push ax\n"); arg_words += 2; }
                    else { fprintf(b->out, "    push ax\n"); arg_words++; }
                    free(arg_text[idx]); arg_text[idx] = NULL;
                }
                b->p = q;
            }
            body_ws(b);
            if (*b->p != ')' || arity < 0 || (!variadic && argc != arity) || !function_defined(name)) { b->ok = 0; return; }
            b->p++;
            fprintf(b->out, "    call %s\n", name);
            while (arg_words-- > 0) fprintf(b->out, "    pop bx\n");
            b->expr_width = function_return_width(name);
            b->expr_is_pointer = function_return_pointer(name) || (g_blackjack_target && !strcmp(name, "bj_args"));
            b->expr_pointer_char = function_return_pointer(name) ? function_return_char(name) : b->expr_is_pointer;
            b->expr_struct_id = function_return_struct(name);
            return;
        }
        /* A function designator in value context decays to a near code
         * pointer.  This is required for callback tables such as ops.write=f. */
        if (function_defined(name)) {
            fprintf(b->out, "    mov ax, %s\n", name);
            b->expr_width = 2;
            b->expr_is_pointer = 1;
            b->expr_pointer_char = 0;
            b->expr_struct_id = -1;
            return;
        }
        idx = local_find(b, name);
        if (idx < 0) {
            int gi = global_find(name);
            int lv_is_pointer = 0, lv_is_char = 0, lv_struct_id = -1;
            if (gi < 0) { b->ok = 0; return; }
            if (g_globals[gi].is_pointer && *b->p != '[' && strncmp(b->p, "->", 2)) {
                fprintf(b->out, "    mov ax, [.G_%s]\n", name);
                b->expr_width = 2;
                b->expr_is_pointer = g_globals[gi].is_pointer;
                b->expr_pointer_char = g_globals[gi].is_char;
                b->expr_struct_id = g_globals[gi].struct_id;
                return;
            }
            if (g_globals[gi].width == 4 && !g_globals[gi].is_pointer && !g_globals[gi].array_len && *b->p != '[') {
                fprintf(b->out, "    mov ax, [.G_%s]\n    mov dx, [.G_%s+2]\n", name, name);
                b->expr_width = 4; b->expr_is_pointer = 0; b->expr_pointer_char = 0; b->expr_struct_id = -1;
                body_ws(b);
                if (!strncmp(b->p, "++", 2) || !strncmp(b->p, "--", 2)) {
                    int dec = b->p[0] == '-', lab = b->next_label++;
                    b->p += 2;
                    fprintf(b->out, "    mov bx, ax\n    mov cx, dx\n");
                    fprintf(b->out, dec ? "    dec bx\n    cmp bx, 0xFFFF\n    jne .Lgpost_%d\n    dec cx\n" :
                                          "    inc bx\n    cmp bx, 0\n    jne .Lgpost_%d\n    inc cx\n", lab);
                    fprintf(b->out, ".Lgpost_%d:\n    mov [.G_%s], bx\n    mov [.G_%s+2], cx\n", lab, name, name);
                }
                return;
            }
            if (g_globals[gi].width > 4 && g_globals[gi].struct_id < 0 && !(g_globals[gi].array_len && *b->p != '[')) { b->ok = 0; return; }
            if (g_globals[gi].struct_id >= 0 && g_globals[gi].is_pointer == 1 && !strncmp(b->p, "->", 2)) {
                int lv_is_pointer = 0, lv_is_char = 0, lv_struct_id = -1;
                b->p = ident_start;
                if (!cg_lvalue_address(b, &lv_is_pointer, &lv_is_char, &lv_struct_id)) { b->ok = 0; return; }
                body_ws(b);
                if (lv_is_pointer == 1 && *b->p == '(') {
                    if (cg_indirect_call(b)) return;
                }
                fprintf(b->out, "    mov bx, ax\n");
                if (lv_is_pointer == 0 && lv_is_char) fprintf(b->out, "    mov al, [bx]\n    mov ah, 0\n");
                else if (lv_is_pointer == 0 && b->lvalue_width == 4) fprintf(b->out, "    mov ax, [bx]\n    mov dx, [bx+2]\n");
                else fprintf(b->out, "    mov ax, [bx]\n");
                b->expr_width = lv_is_pointer ? 2 : b->lvalue_width;
                b->expr_is_pointer = lv_is_pointer;
                b->expr_pointer_char = lv_is_pointer ? lv_is_char : 0;
                b->expr_struct_id = lv_struct_id;
                return;
            }
            if (g_globals[gi].array_len && *b->p != '[') {
                fprintf(b->out, "    mov ax, .G_%s\n", name);
                b->expr_is_pointer = g_globals[gi].is_pointer + 1;
                b->expr_pointer_char = g_globals[gi].is_char;
                b->expr_struct_id = -1;
                return;
            }
            b->p = ident_start;
            if (!cg_lvalue_address(b, &lv_is_pointer, &lv_is_char, &lv_struct_id)) { b->ok = 0; return; }
            fprintf(b->out, "    mov bx, ax\n");
            if (lv_is_pointer == 0 && lv_is_char)
                fprintf(b->out, b->lvalue_far ?
                        "    mov al, [es:bx]\n    mov ah, 0\n" :
                        "    mov al, [bx]\n    mov ah, 0\n");
            else if (lv_is_pointer == 0 && b->lvalue_width == 4)
                fprintf(b->out, b->lvalue_far ?
                        "    mov ax, [es:bx]\n    mov dx, [es:bx+2]\n" :
                        "    mov ax, [bx]\n    mov dx, [bx+2]\n");
            else
                fprintf(b->out, b->lvalue_far ?
                        "    mov ax, [es:bx]\n" : "    mov ax, [bx]\n");
            b->expr_width = lv_is_pointer ? 2 : b->lvalue_width;
            b->expr_is_pointer = lv_is_pointer;
            b->expr_pointer_char = lv_is_pointer ? lv_is_char : 0;
            b->expr_struct_id = lv_struct_id;
            body_ws(b);
            if (lv_is_pointer == 0 && (!strncmp(b->p, "++", 2) || !strncmp(b->p, "--", 2))) {
                int dec = b->p[0] == '-';
                b->p += 2;
                fprintf(b->out, "    mov cx, ax\n");
                fprintf(b->out, dec ? "    dec ax\n" : "    inc ax\n");
                if (lv_is_char) fprintf(b->out, "    mov [bx], al\n");
                else fprintf(b->out, "    mov [bx], ax\n");
                fprintf(b->out, "    mov ax, cx\n");
            }
            return;
        }
        body_ws(b);
        if (*b->p == '[' || *b->p == '.' || !strncmp(b->p, "->", 2)) {
            int lv_is_pointer = 0, lv_is_char = 0, lv_struct_id = -1;
            /* Rewind to the identifier so the shared lvalue path computes a[i]. */
            b->p = ident_start;
            if (!cg_lvalue_address(b, &lv_is_pointer, &lv_is_char, &lv_struct_id)) { b->ok = 0; return; }
            body_ws(b);
            if (lv_is_pointer == 1 && *b->p == '(') {
                if (cg_indirect_call(b)) return;
            }
            if (lv_struct_id == -2) {
                /* Fixed member array in value context: C array-to-pointer decay. */
                b->expr_is_pointer = lv_is_pointer + 1;
                b->expr_pointer_char = lv_is_char;
                b->expr_struct_id = -1;
            } else {
                fprintf(b->out, "    mov bx, ax\n");
                if (lv_is_pointer == 0 && lv_is_char)
                    fprintf(b->out, b->lvalue_far ?
                            "    mov al, [es:bx]\n    mov ah, 0\n" :
                            "    mov al, [bx]\n    mov ah, 0\n");
                else if (lv_is_pointer == 0 && b->lvalue_width == 4)
                    fprintf(b->out, b->lvalue_far ?
                            "    mov ax, [es:bx]\n    mov dx, [es:bx+2]\n" :
                            "    mov ax, [bx]\n    mov dx, [bx+2]\n");
                else
                    fprintf(b->out, b->lvalue_far ?
                            "    mov ax, [es:bx]\n" : "    mov ax, [bx]\n");
                b->expr_width = lv_is_pointer ? 2 : b->lvalue_width;
                b->expr_is_pointer = lv_is_pointer;
                b->expr_pointer_char = lv_is_pointer ? lv_is_char : 0;
                b->expr_struct_id = lv_is_pointer ? lv_struct_id : -1;
            }
            body_ws(b);
            if (*b->p == '[' && b->expr_is_pointer > 0) {
                int outer_depth = b->expr_is_pointer;
                int outer_char = b->expr_pointer_char;
                b->p++;
                fprintf(b->out, "    push ax\n");
                cg_expr(b);
                if (!b->ok || b->expr_is_pointer) { b->ok = 0; return; }
                body_ws(b);
                if (*b->p != ']') { b->ok = 0; return; }
                b->p++;
                if (!(outer_depth == 1 && outer_char)) fprintf(b->out, "    add ax, ax\n");
                fprintf(b->out, "    pop bx\n    add ax, bx\n    mov bx, ax\n");
                if (outer_depth == 1 && outer_char) fprintf(b->out, "    mov al, [bx]\n    mov ah, 0\n");
                else fprintf(b->out, "    mov ax, [bx]\n");
                b->expr_is_pointer = outer_depth - 1;
                b->expr_pointer_char = b->expr_is_pointer ? outer_char : 0;
            }
            return;
        }
        if (b->locals[idx].struct_id >= 0 && b->locals[idx].is_pointer == 0) { b->ok = 0; return; }
        if (b->locals[idx].array_len > 0) {
            /* Array-to-pointer decay: bare local array expression yields &a[0]. */
            emit_local_address(b->out, b->locals[idx].offset);
            b->expr_is_pointer = b->locals[idx].is_pointer + 1;
            b->expr_pointer_char = b->locals[idx].is_char;
            return;
        }
        if (b->locals[idx].is_char && !b->locals[idx].is_pointer) emit_bp_load_char(b->out, b->locals[idx].offset);
        else {
            emit_bp_load(b->out, b->locals[idx].offset);
            if (b->locals[idx].is_far) {
                if (b->locals[idx].offset + 2 >= 0)
                    fprintf(b->out, "    mov dx, [bp+%d]\n", b->locals[idx].offset + 2);
                else
                    fprintf(b->out, "    mov dx, [bp-%d]\n", -(b->locals[idx].offset + 2));
            } else if (b->locals[idx].width == 4 && !b->locals[idx].is_pointer) {
                if (b->locals[idx].offset + 2 >= 0) fprintf(b->out, "    mov dx, [bp+%d]\n", b->locals[idx].offset + 2);
                else fprintf(b->out, "    mov dx, [bp-%d]\n", -(b->locals[idx].offset + 2));
            }
        }
        b->expr_width = b->locals[idx].is_far ? 4 :
                        (b->locals[idx].is_pointer ? 2 : b->locals[idx].width);
        b->expr_is_pointer = b->locals[idx].is_pointer;
        b->expr_pointer_char = b->locals[idx].is_pointer ? b->locals[idx].is_char : 0;
        b->expr_struct_id = b->locals[idx].is_pointer ? b->locals[idx].struct_id : -1;
        body_ws(b);
        if (b->locals[idx].is_pointer && b->locals[idx].array_len == 0 &&
            (!strncmp(b->p, "++", 2) || !strncmp(b->p, "--", 2))) {
            int dec = b->p[0] == '-';
            int step = (b->locals[idx].is_pointer == 1 && b->locals[idx].is_char) ? 1 : 2;
            b->p += 2;
            /* Postfix pointer ++/--: expression keeps the old pointer in AX,
             * while the stored pointer advances by one pointed-to object. */
            fprintf(b->out, "    mov bx, ax\n");
            fprintf(b->out, dec ? "    sub bx, %d\n" : "    add bx, %d\n", step);
            if (b->locals[idx].offset >= 0) fprintf(b->out, "    mov [bp+%d], bx\n", b->locals[idx].offset);
            else fprintf(b->out, "    mov [bp-%d], bx\n", -b->locals[idx].offset);
        } else if (!b->locals[idx].is_pointer && b->locals[idx].array_len == 0 &&
            (!strncmp(b->p, "++", 2) || !strncmp(b->p, "--", 2))) {
            int dec = b->p[0] == '-';
            b->p += 2;
            /* Postfix result remains in DX:AX; update storage through BX/CX. */
            fprintf(b->out, "    mov bx, ax\n");
            if (b->locals[idx].width == 4) fprintf(b->out, "    mov cx, dx\n");
            fprintf(b->out, dec ? "    dec bx\n" : "    inc bx\n");
            if (b->locals[idx].width == 4) {
                int lab = b->next_label++;
                fprintf(b->out, dec ? "    cmp bx, 0xFFFF\n    jne .Lpost_%d\n    dec cx\n" :
                                      "    cmp bx, 0\n    jne .Lpost_%d\n    inc cx\n", lab);
                fprintf(b->out, ".Lpost_%d:\n", lab);
                if (b->locals[idx].offset + 2 >= 0) fprintf(b->out, "    mov [bp+%d], cx\n", b->locals[idx].offset + 2);
                else fprintf(b->out, "    mov [bp-%d], cx\n", -(b->locals[idx].offset + 2));
            }
            if (b->locals[idx].is_char) {
                if (b->locals[idx].offset >= 0) fprintf(b->out, "    mov [bp+%d], bl\n", b->locals[idx].offset);
                else fprintf(b->out, "    mov [bp-%d], bl\n", -b->locals[idx].offset);
            } else {
                if (b->locals[idx].offset >= 0) fprintf(b->out, "    mov [bp+%d], bx\n", b->locals[idx].offset);
                else fprintf(b->out, "    mov [bp-%d], bx\n", -b->locals[idx].offset);
            }
        }
        return;
    }
    /* A 16-bit target still accepts 32-bit C integer constants.  Parse
     * their unsigned magnitude before applying C integer suffixes. */
    {
        unsigned long long magnitude;
        int has_u = 0;
        int has_l = 0;

        errno = 0;
        magnitude = strtoull(b->p, &end, 0);
        if (end == b->p || errno || magnitude > 0xFFFFFFFFULL) {
            b->ok = 0;
            return;
        }
        while (*end == 'u' || *end == 'U' || *end == 'l' || *end == 'L') {
            if (*end == 'u' || *end == 'U') {
                if (has_u) { b->ok = 0; return; }
                has_u = 1;
            } else {
                if (has_l) { b->ok = 0; return; }
                has_l = 1;
            }
            end++;
        }
        if (isalnum((unsigned char)*end) || *end == '_') {
            b->ok = 0;
            return;
        }
        b->p = end;
        if (has_l || magnitude > 65535ULL) {
            fprintf(b->out, "    mov ax, 0x%04lX\n    mov dx, 0x%04lX\n",
                    (unsigned long)(magnitude & 0xFFFFULL),
                    (unsigned long)((magnitude >> 16) & 0xFFFFULL));
            b->expr_width = 4;
        } else {
            fprintf(b->out, "    mov ax, 0x%04lX\n",
                    (unsigned long)(magnitude & 0xFFFFULL));
            b->expr_width = 2;
        }
        b->expr_is_null_constant = (magnitude == 0);
    }
    b->expr_is_pointer = 0;
    b->expr_pointer_char = 0;
    b->expr_struct_id = -1;
}

static void cg_unary(BodyParser *b) {
    body_ws(b);
    if (!strncmp(b->p, "__builtin_va_end", 16) && b->p[16] == '(') {
        char ap[64]; int ai;
        b->p += 16; body_ws(b); if (*b->p++ != '(' || !body_ident(b, ap, sizeof(ap))) { b->ok = 0; return; }
        body_ws(b); if (*b->p++ != ')') { b->ok = 0; return; }
        ai = local_find(b, ap); if (ai < 0 || b->locals[ai].is_pointer != 1) { b->ok = 0; return; }
        fprintf(b->out, "    xor ax, ax\n");
        b->expr_width = 0; b->expr_is_pointer = 0; b->expr_pointer_char = 0; b->expr_struct_id = -1;
        return;
    }
    if (!strncmp(b->p, "__builtin_va_start", 18) && b->p[18] == '(') {
        char ap[64], last[64]; int ai, li;
        if (!b->is_variadic_function) { b->ok = 0; return; }
        b->p += 18; body_ws(b); if (*b->p++ != '(') { b->ok = 0; return; }
        if (!body_ident(b, ap, sizeof(ap))) { b->ok = 0; return; }
        body_ws(b); if (*b->p++ != ',') { b->ok = 0; return; }
        if (!body_ident(b, last, sizeof(last))) { b->ok = 0; return; }
        body_ws(b); if (*b->p++ != ')') { b->ok = 0; return; }
        ai = local_find(b, ap); li = local_find(b, last);
        if (ai < 0 || li < 0 || b->locals[ai].is_pointer != 1) { b->ok = 0; return; }
        fprintf(b->out, "    mov ax, bp\n    add ax, %d\n", 4 + b->fixed_param_bytes);
        if (b->locals[ai].offset >= 0) fprintf(b->out, "    mov [bp+%d], ax\n", b->locals[ai].offset);
        else fprintf(b->out, "    mov [bp-%d], ax\n", -b->locals[ai].offset);
        b->expr_width = 0; b->expr_is_pointer = 0; b->expr_pointer_char = 0; b->expr_struct_id = -1;
        return;
    }
    if (!strncmp(b->p, "__builtin_va_arg", 16) && b->p[16] == '(') {
        char ap[64], tn[64]; int ai, ptr = 0, is_char = 0;
        b->p += 16; body_ws(b); if (*b->p++ != '(' || !body_ident(b, ap, sizeof(ap))) { b->ok = 0; return; }
        body_ws(b); if (*b->p++ != ',') { b->ok = 0; return; }
        if (!body_ident(b, tn, sizeof(tn))) { b->ok = 0; return; }
        body_ws(b); while (*b->p == '*') { ptr++; b->p++; body_ws(b); }
        if (*b->p++ != ')' || ptr > 1) { b->ok = 0; return; }
        ai = local_find(b, ap); if (ai < 0 || b->locals[ai].is_pointer != 1) { b->ok = 0; return; }
        if (!strcmp(tn, "char")) is_char = 1;
        else if (strcmp(tn, "int") && strcmp(tn, "void") && alias_find(tn) < 0) { b->ok = 0; return; }
        emit_bp_load(b->out, b->locals[ai].offset); fprintf(b->out, "    mov bx, ax\n    mov ax, [bx]\n    add bx, 2\n");
        if (b->locals[ai].offset >= 0) fprintf(b->out, "    mov [bp+%d], bx\n", b->locals[ai].offset); else fprintf(b->out, "    mov [bp-%d], bx\n", -b->locals[ai].offset);
        b->expr_width = ptr ? 2 : (is_char ? 1 : 2); b->expr_is_pointer = ptr; b->expr_pointer_char = ptr ? is_char : 0; b->expr_struct_id = -1; return;
    }
    if (!strncmp(b->p, "__builtin_va_arg_int", 20) && !(isalnum((unsigned char)b->p[20]) || b->p[20] == '_')) {
        char ap[64]; int ai;
        b->p += 20; body_ws(b); if (*b->p++ != '(' || !body_ident(b, ap, sizeof(ap))) { b->ok = 0; return; }
        body_ws(b); if (*b->p++ != ')') { b->ok = 0; return; }
        ai = local_find(b, ap); if (ai < 0 || b->locals[ai].is_pointer != 1) { b->ok = 0; return; }
        emit_bp_load(b->out, b->locals[ai].offset); fprintf(b->out, "    mov bx, ax\n    mov ax, [bx]\n    add bx, 2\n");
        if (b->locals[ai].offset >= 0) fprintf(b->out, "    mov [bp+%d], bx\n", b->locals[ai].offset); else fprintf(b->out, "    mov [bp-%d], bx\n", -b->locals[ai].offset);
        b->expr_width = 2; b->expr_is_pointer = 0; b->expr_pointer_char = 0; b->expr_struct_id = -1; return;
    }
    if (!strncmp(b->p, "__builtin_va_arg_ptr", 20) && !(isalnum((unsigned char)b->p[20]) || b->p[20] == '_')) {
        char ap[64]; int ai;
        b->p += 20; body_ws(b); if (*b->p++ != '(' || !body_ident(b, ap, sizeof(ap))) { b->ok = 0; return; }
        body_ws(b); if (*b->p++ != ')') { b->ok = 0; return; }
        ai = local_find(b, ap); if (ai < 0 || b->locals[ai].is_pointer != 1) { b->ok = 0; return; }
        emit_bp_load(b->out, b->locals[ai].offset); fprintf(b->out, "    mov bx, ax\n    mov ax, [bx]\n    add bx, 2\n");
        if (b->locals[ai].offset >= 0) fprintf(b->out, "    mov [bp+%d], bx\n", b->locals[ai].offset); else fprintf(b->out, "    mov [bp-%d], bx\n", -b->locals[ai].offset);
        b->expr_width = 2; b->expr_is_pointer = 1; b->expr_pointer_char = -1; b->expr_struct_id = -1; return;
    }

    if (!strncmp(b->p, "sizeof", 6) && !(isalnum((unsigned char)b->p[6]) || b->p[6] == '_')) {
        char sn[64]; int li, gi, bytes = 0, ptrdepth = 0, ai;
        b->p += 6; body_ws(b);
        if (*b->p != '(') { b->ok = 0; return; }
        b->p++;
        if (!body_ident(b, sn, sizeof(sn))) { b->ok = 0; return; }
        body_ws(b);
        if (!strcmp(sn, "struct")) {
            int sid;
            if (!body_ident(b, sn, sizeof(sn))) { b->ok = 0; return; }
            sid = struct_find(sn);
            if (sid < 0) { b->ok = 0; return; }
            body_ws(b);
            while (*b->p == '*') { ptrdepth++; b->p++; body_ws(b); }
            bytes = ptrdepth ? 2 : g_structs[sid].size_bytes;
        } else {
            while (*b->p == '*') { ptrdepth++; b->p++; body_ws(b); }
        }
        if (*b->p != ')') { b->ok = 0; return; }
        b->p++;
        if (!bytes && ptrdepth) bytes = 2;
        else if (!bytes && !strcmp(sn, "char")) bytes = 1;
        else if (!bytes && (!strcmp(sn, "int") || !strcmp(sn, "short"))) bytes = 2;
        else if (!bytes && !strcmp(sn, "long")) bytes = 4;
        else if (!bytes && (ai = alias_find(sn)) >= 0) bytes = g_aliases[ai].width;
        li = local_find(b, sn); gi = global_find(sn);
        if (!bytes && li >= 0) {
            if (b->locals[li].array_len > 0)
                bytes = b->locals[li].array_len * ((b->locals[li].is_char && !b->locals[li].is_pointer) ? 1 : 2);
            else bytes = b->locals[li].is_pointer ? 2 : b->locals[li].width;
        } else if (!bytes && gi >= 0) {
            if (g_globals[gi].array_len > 0)
                bytes = g_globals[gi].array_len * ((g_globals[gi].is_char && !g_globals[gi].is_pointer) ? 1 : 2);
            else bytes = g_globals[gi].is_pointer ? 2 : g_globals[gi].width;
        } else if (!bytes) { b->ok = 0; return; }
        fprintf(b->out, "    mov ax, %d\n", bytes);
        b->expr_width = 2; b->expr_is_pointer = 0; b->expr_pointer_char = 0; b->expr_struct_id = -1;
        return;
    }
    /* Ordinary scalar casts.  Keep this deliberately type-driven: a '(' is
     * only consumed here when what follows is a type name and ')'. */
    if (*b->p == '(') {
        const char *save = b->p;
        const char *q = b->p + 1;
        char tname[64];
        size_t tn = 0;
        int cast_width = 0, cast_void = 0, cast_struct_id = -1;
        while (isspace((unsigned char)*q)) q++;
        if (!strncmp(q, "void", 4) && !(isalnum((unsigned char)q[4]) || q[4] == '_')) {
            q += 4; cast_void = 1;
        } else if (!strncmp(q, "unsigned", 8) && isspace((unsigned char)q[8])) {
            q += 8; while (isspace((unsigned char)*q)) q++;
            if (!strncmp(q, "char", 4) && !(isalnum((unsigned char)q[4]) || q[4] == '_')) {
                q += 4; cast_width = 1;
            } else if (!strncmp(q, "short", 5) && !(isalnum((unsigned char)q[5]) || q[5] == '_')) {
                q += 5; cast_width = 2;
                while (isspace((unsigned char)*q)) q++;
                if (!strncmp(q,"int",3) && !(isalnum((unsigned char)q[3])||q[3]=='_')) q+=3;
            } else if (!strncmp(q, "int", 3) && !(isalnum((unsigned char)q[3]) || q[3] == '_')) {
                q += 3; cast_width = 2;
            }
        } else {
            while (isalnum((unsigned char)*q) || *q == '_') {
                if (tn + 1 < sizeof(tname)) tname[tn++] = *q;
                q++;
            }
            tname[tn] = 0;
            if (!strcmp(tname, "char")) { cast_width = 1; }
            else if (!strcmp(tname, "int")) cast_width = 2;
            else if (!strcmp(tname, "struct")) {
                char stag[64]; size_t sn = 0; int si;
                while (isspace((unsigned char)*q)) q++;
                while ((isalnum((unsigned char)*q) || *q == '_') && sn + 1 < sizeof(stag))
                    stag[sn++] = *q++;
                stag[sn] = 0;
                si = struct_find(stag);
                if (si >= 0) { cast_width = g_structs[si].size_bytes; cast_struct_id = si; }
            } else if (tn) {
                int ai = alias_find(tname);
                if (ai >= 0 && g_aliases[ai].width <= 4) {
                    cast_width = g_aliases[ai].width;
                    if (g_aliases[ai].struct_tag[0]) cast_struct_id = struct_find(g_aliases[ai].struct_tag);
                }
            }
        }
        while (isspace((unsigned char)*q)) q++;
        {
            int cast_ptr = 0;
            int cast_far = 0;
            if (!strncmp(q, "far", 3) &&
                !(isalnum((unsigned char)q[3]) || q[3] == '_')) {
                cast_far = 1;
                q += 3;
                while (isspace((unsigned char)*q)) q++;
            }
            while (*q == '*') { cast_ptr++; q++; while (isspace((unsigned char)*q)) q++; }
            if ((cast_void || cast_width) && cast_ptr <= 2 &&
                (!cast_far || cast_ptr == 1) && *q == ')') {
                b->p = q + 1;
                cg_unary(b);
                if (!b->ok) return;
                if (cast_ptr) {
                    /* Near pointers are 16-bit offsets.  A Blackjack far
                     * pointer is a 32-bit segment:offset object in DX:AX. */
                    if (b->expr_is_pointer > 0 || b->expr_width <= 4) {
                        if (cast_far && b->expr_width != 4)
                            fprintf(b->out, "    xor dx, dx\n");
                        b->expr_width = cast_far ? 4 : 2;
                        b->expr_is_pointer = cast_ptr;
                        b->expr_pointer_char = (cast_width == 1);
                        b->expr_struct_id = cast_struct_id;
                        return;
                    }
                    b->ok = 0; return;
                }
                if (!cast_void && b->expr_is_pointer) { b->ok = 0; return; }
                if (cast_width == 1) fprintf(b->out, "    and ax, 0x00FF\n");
                if (cast_width == 4 && b->expr_width != 4) fprintf(b->out, "    xor dx, dx\n");
                if (!cast_void) b->expr_width = cast_width;
                b->expr_is_pointer = 0;
                b->expr_pointer_char = 0;
                b->expr_struct_id = -1;
                return;
            }
        }
        b->p = save;
    }
    if ((!strncmp(b->p,"++",2) || !strncmp(b->p,"--",2))) {
        int dec = b->p[0]=='-', lv_is_pointer=0, lv_is_char=0, lv_struct_id=-1, lv_far=0;
        b->p += 2;
        if (!cg_lvalue_address(b,&lv_is_pointer,&lv_is_char,&lv_struct_id) || lv_is_pointer || lv_struct_id>=0) { b->ok=0; return; }
        lv_far=b->lvalue_far;
        fprintf(b->out,"    mov bx, ax\n");
        if(lv_is_char) fprintf(b->out, lv_far ? "    mov al, [es:bx]\n    mov ah, 0\n" : "    mov al, [bx]\n    mov ah, 0\n");
        else fprintf(b->out, lv_far ? "    mov ax, [es:bx]\n" : "    mov ax, [bx]\n");
        fprintf(b->out, dec ? "    dec ax\n" : "    inc ax\n");
        if(lv_is_char) fprintf(b->out, lv_far ? "    mov [es:bx], al\n" : "    mov [bx], al\n");
        else fprintf(b->out, lv_far ? "    mov [es:bx], ax\n" : "    mov [bx], ax\n");
        b->expr_width=lv_is_char?1:2; b->expr_is_pointer=0; b->expr_pointer_char=0; b->expr_struct_id=-1;
        return;
    }
    if (*b->p == '&') {
        int lv_is_pointer = 0, lv_is_char = 0, lv_struct_id = -1;
        const char *save;
        char gname[64];
        int gi;
        b->p++;
        save=b->p;
        if (body_ident(b,gname,sizeof(gname))) {
            body_ws(b);
            gi=global_find(gname);
            if (gi>=0 && !g_globals[gi].has_init && !g_globals[gi].array_len) {
                fprintf(b->out,"    mov ax, .G_%s\n",gname);
                b->expr_width=2; b->expr_is_pointer=g_globals[gi].is_pointer+1;
                b->expr_pointer_char=g_globals[gi].is_char; b->expr_struct_id=g_globals[gi].struct_id;
                return;
            }
        }
        b->p=save;
        if (!cg_lvalue_address(b, &lv_is_pointer, &lv_is_char, &lv_struct_id)) return;
        if (lv_is_pointer >= 2 || (lv_struct_id >= 0 && lv_is_pointer >= 1)) { b->ok = 0; return; }
        b->expr_is_pointer = lv_is_pointer + 1;
        b->expr_pointer_char = lv_is_char;
        b->expr_struct_id = lv_struct_id;
        return;
    }
    if (*b->p == '*') {
        b->p++;
        cg_unary(b);
        if (!b->ok || b->expr_is_pointer <= 0) { b->ok = 0; return; }
        {
            int in_depth = b->expr_is_pointer;
            int base_char = b->expr_pointer_char;
            if (b->expr_struct_id >= 0) { b->ok = 0; return; } /* struct rvalues by dereference deferred */
            fprintf(b->out, "    mov bx, ax\n");
            if (in_depth == 1 && base_char) fprintf(b->out, "    mov al, [bx]\n    mov ah, 0\n");
            else fprintf(b->out, "    mov ax, [bx]\n");
            b->expr_is_pointer = in_depth - 1;
            b->expr_pointer_char = (in_depth - 1) ? base_char : 0;
        }
        return;
    }
    if (*b->p == '+') {
        b->p++;
        cg_unary(b);
        if (b->ok && b->expr_is_pointer) b->ok = 0;
        return;
    }
    if (*b->p == '-') {
        b->p++;
        cg_unary(b);
        if (!b->ok || b->expr_is_pointer) { b->ok = 0; return; }
        fprintf(b->out, "    neg ax\n");
        b->expr_is_pointer = 0;
        return;
    }
    if (*b->p == '~') {
        b->p++;
        cg_unary(b);
        if (!b->ok || b->expr_is_pointer) { b->ok = 0; return; }
        fprintf(b->out, "    not ax\n");
        b->expr_is_pointer = 0;
        return;
    }
    if (*b->p == '!' && b->p[1] != '=') {
        int label = b->next_label++;
        b->p++;
        cg_unary(b);
        if (!b->ok) return;
        fprintf(b->out, "    cmp ax, 0\n");
        fprintf(b->out, "    mov ax, 0\n");
        fprintf(b->out, "    jne .Lnot_end_%d\n", label);
        fprintf(b->out, "    mov ax, 1\n");
        fprintf(b->out, ".Lnot_end_%d:\n", label);
        b->expr_is_pointer = 0;
        return;
    }
    cg_primary(b);
}

static void cg_multiplicative(BodyParser *b) {
    cg_unary(b);
    while (b->ok) {
        char op;
        body_ws(b);
        if (*b->p != '*' && *b->p != '/' && *b->p != '%') break;
        op = *b->p++;
        /* Sprint 3: 8086 multiplication by a literal power of two.
         * The low 16 bits match unsigned MUL and signed two's-complement
         * multiplication; preserve the original path for other types. */
        if (g_optimization_level > 0 && op == '*' && !b->expr_is_pointer && b->expr_width == 2) {
            const char *q = b->p;
            char *end;
            unsigned long factor;
            int shifts = 0;
            while (*q == ' ' || *q == '\t') q++;
            if (*q >= '0' && *q <= '9') {
                factor = strtoul(q, &end, 0);
                if (end > q && !isalnum((unsigned char)*end) && *end != '_' &&
                    factor >= 2 && factor <= 32768 && (factor & (factor - 1)) == 0) {
                    while (factor > 1) { factor >>= 1; shifts++; }
                    while (shifts--) fprintf(b->out, "    shl ax, 1\n");
                    b->p = end;
                    b->expr_is_pointer = 0;
                    b->expr_struct_id = -1;
                    continue;
                }
            }
        }
        {
            int lhs_width = b->expr_width;
            int rhs_width;
            if (lhs_width == 4) fprintf(b->out, "    push dx\n");
            fprintf(b->out, "    push ax\n");
            cg_unary(b);
            if (!b->ok) return;
            rhs_width = b->expr_width;
            if (op == '*' && (lhs_width == 4 || rhs_width == 4)) {
                /* Low 32 bits of (a_hi:a_lo) * (b_hi:b_lo):
                 * a_lo*b_lo + ((a_hi*b_lo + a_lo*b_hi) << 16).
                 * All partial products use the native 8086 16-bit MUL. */
                fprintf(b->out, "    mov bx, ax\n");
                if (rhs_width == 4) fprintf(b->out, "    mov cx, dx\n");
                else fprintf(b->out, "    xor cx, cx\n");
                fprintf(b->out, "    pop si\n");
                if (lhs_width == 4) fprintf(b->out, "    pop di\n");
                else fprintf(b->out, "    xor di, di\n");
                fprintf(b->out, "    mov ax, di\n    mul bx\n    push ax\n");
                fprintf(b->out, "    mov ax, si\n    mul cx\n    pop di\n    add di, ax\n");
                fprintf(b->out, "    mov ax, si\n    mul bx\n    add dx, di\n");
                b->expr_width = 4;
            } else {
                fprintf(b->out, "    mov bx, ax\n    pop ax\n");
                if (lhs_width == 4) fprintf(b->out, "    pop di\n");
                if (op == '*') {
                    fprintf(b->out, "    mul bx\n");
                    b->expr_width = 2;
                } else {
                    /* Wide division is not yet implemented. Reject it rather
                     * than silently emit a truncated 16-bit operation. */
                    if (lhs_width == 4 || rhs_width == 4) {
                        b->ok = 0;
                        return;
                    }
                    fprintf(b->out, "    xor dx, dx\n    div bx\n");
                    if (op == '%') fprintf(b->out, "    mov ax, dx\n");
                    b->expr_width = 2;
                }
            }
        }
        b->expr_is_pointer = 0;
        b->expr_struct_id = -1;
    }
}

static void cg_additive(BodyParser *b) {
    int lhs_pointer, lhs_pointer_char, lhs_struct_id, lhs_width;
    cg_multiplicative(b);
    lhs_width = b->expr_width;
    lhs_pointer = b->expr_is_pointer;
    lhs_pointer_char = b->expr_pointer_char;
    lhs_struct_id = b->expr_struct_id;
    while (b->ok) {
        char op;
        int rhs_pointer, rhs_pointer_char, rhs_struct_id;
        body_ws(b);
        if (*b->p != '+' && *b->p != '-') break;
        op = *b->p++;
        if (!lhs_pointer && lhs_width == 4) fprintf(b->out, "    push dx\n");
        fprintf(b->out, "    push ax\n");
        cg_multiplicative(b);
        if (!b->ok) return;
        rhs_pointer = b->expr_is_pointer;
        rhs_pointer_char = b->expr_pointer_char;
        rhs_struct_id = b->expr_struct_id;
        fprintf(b->out, "    pop bx\n");
        if ((lhs_struct_id >= 0 && !lhs_pointer) || (rhs_struct_id >= 0 && !rhs_pointer)) { b->ok = 0; return; }

        /* Pointer arithmetic is scaled by the actual pointee size.
         * BX holds the left operand and AX the right operand here. */
        if (lhs_pointer && !rhs_pointer) {
            if (lhs_pointer == 1 && lhs_struct_id >= 0) {
                int scale = g_structs[lhs_struct_id].size_bytes;
                if (scale == 2) fprintf(b->out, "    add ax, ax\n");
                else if (scale != 1) fprintf(b->out, "    mov cx, %d\n    mul cx\n", scale);
            } else if (!(lhs_pointer == 1 && lhs_pointer_char)) fprintf(b->out, "    add ax, ax\n");
            if (op == '+') fprintf(b->out, "    add bx, ax\n");
            else fprintf(b->out, "    sub bx, ax\n");
            fprintf(b->out, "    mov ax, bx\n");
            lhs_pointer = 1;
            b->expr_struct_id = lhs_struct_id;
        } else if (!lhs_pointer && rhs_pointer && op == '+') {
            /* int + pointer: scale the integer left operand, then add it
             * to the pointer right operand. */
            if (rhs_pointer == 1 && rhs_struct_id >= 0) {
                int scale = g_structs[rhs_struct_id].size_bytes;
                if (scale == 2) fprintf(b->out, "    add bx, bx\n");
                else if (scale != 1) fprintf(b->out, "    mov cx, %d\n    xchg ax, bx\n    mul cx\n    xchg ax, bx\n", scale);
            } else if (!(rhs_pointer == 1 && rhs_pointer_char)) fprintf(b->out, "    add bx, bx\n");
            fprintf(b->out, "    add ax, bx\n");
            lhs_pointer = 1;
            lhs_pointer_char = rhs_pointer_char;
            lhs_struct_id = rhs_struct_id;
        } else if (!lhs_pointer && !rhs_pointer) {
            int rhs_width=b->expr_width;
            if (lhs_width==4) {
                if(rhs_width!=4) fprintf(b->out,"    xor dx, dx\n");
                fprintf(b->out,"    pop di\n");
                if(op=='+') fprintf(b->out,"    add bx, ax\n    adc di, dx\n");
                else fprintf(b->out,"    sub bx, ax\n    sbb di, dx\n");
                fprintf(b->out,"    mov ax, bx\n    mov dx, di\n");
                lhs_width=4;
            } else if(rhs_width==4) {
                fprintf(b->out,"    mov si, dx\n    xor di, di\n");
                if(op=='+') fprintf(b->out,"    add bx, ax\n    adc di, si\n");
                else fprintf(b->out,"    sub bx, ax\n    sbb di, si\n");
                fprintf(b->out,"    mov ax, bx\n    mov dx, di\n");
                lhs_width=4;
            } else {
                if (op == '+') fprintf(b->out, "    add bx, ax\n");
                else fprintf(b->out, "    sub bx, ax\n");
                fprintf(b->out, "    mov ax, bx\n");
                lhs_width=2;
            }
            b->expr_width=lhs_width;
            lhs_pointer = 0;
        } else {
            /* pointer + pointer and scalar - pointer are not C pointer
             * arithmetic forms. Pointer difference is deferred. */
            b->ok = 0;
            return;
        }
        b->expr_is_pointer = lhs_pointer;
        b->expr_pointer_char = lhs_pointer ? lhs_pointer_char : 0;
        lhs_pointer = b->expr_is_pointer;
        lhs_pointer_char = b->expr_pointer_char;
        lhs_struct_id = b->expr_struct_id;
    }
}

static void cg_shift(BodyParser *b) {
    cg_additive(b);
    while (b->ok) {
        int right=0, lhs_width=b->expr_width, lab;
        body_ws(b);
        if (!strncmp(b->p, "<<", 2)) b->p += 2;
        else if (!strncmp(b->p, ">>", 2)) { right=1; b->p += 2; }
        else break;
        if (b->expr_is_pointer) { b->ok=0; return; }
        if (lhs_width==4) fprintf(b->out,"    push dx\n");
        fprintf(b->out,"    push ax\n");
        cg_additive(b);
        if (!b->ok || b->expr_is_pointer) return;
        fprintf(b->out,"    mov cx, ax\n    pop ax\n");
        if (lhs_width==4) fprintf(b->out,"    pop dx\n");
        lab=b->next_label++;
        fprintf(b->out,"    cmp cx, 0\n    je .Lshift_done_%d\n.Lshift_%d:\n",lab,lab);
        if(lhs_width==4) {
            if(right) fprintf(b->out,"    shr dx, 1\n    rcr ax, 1\n");
            else fprintf(b->out,"    shl ax, 1\n    rcl dx, 1\n");
        } else fprintf(b->out,right ? "    shr ax, 1\n" : "    shl ax, 1\n");
        fprintf(b->out,"    dec cx\n    jnz .Lshift_%d\n.Lshift_done_%d:\n",lab,lab);
        b->expr_width=lhs_width; b->expr_is_pointer=0; b->expr_struct_id=-1;
    }
}

static void cg_bool_result(BodyParser *b, const char *false_jump) {
    int label = b->next_label++;
    fprintf(b->out, "    mov ax, 0\n");
    fprintf(b->out, "    %s .Lcmp_end_%d\n", false_jump, label);
    fprintf(b->out, "    mov ax, 1\n");
    fprintf(b->out, ".Lcmp_end_%d:\n", label);
    b->expr_is_pointer = 0;
    b->expr_struct_id = -1;
}

static void cg_relational(BodyParser *b) {
    cg_shift(b);
    while (b->ok) {
        const char *false_jump = NULL;
        body_ws(b);
        if (!strncmp(b->p, "<=", 2)) { false_jump = "jg"; b->p += 2; }
        else if (!strncmp(b->p, ">=", 2)) { false_jump = "jl"; b->p += 2; }
        else if (*b->p == '<') { false_jump = "jge"; b->p++; }
        else if (*b->p == '>') { false_jump = "jle"; b->p++; }
        else break;

        fprintf(b->out, "    push ax\n");
        cg_shift(b);
        if (!b->ok) return;
        fprintf(b->out, "    mov bx, ax\n");
        fprintf(b->out, "    pop ax\n");
        fprintf(b->out, "    cmp ax, bx\n");
        cg_bool_result(b, false_jump);
    }
}

static void cg_equality(BodyParser *b) {
    cg_relational(b);
    while (b->ok) {
        const char *false_jump = NULL;
        body_ws(b);
        if (!strncmp(b->p, "==", 2)) { false_jump = "jne"; b->p += 2; }
        else if (!strncmp(b->p, "!=", 2)) { false_jump = "je"; b->p += 2; }
        else break;

        {
            int lhs_width = b->expr_width;
            int rhs_width;
            int label = b->next_label++;
            if (lhs_width == 4) fprintf(b->out, "    push dx\n");
            fprintf(b->out, "    push ax\n");
            cg_relational(b);
            if (!b->ok) return;
            rhs_width = b->expr_width;
            if (lhs_width == 4 || rhs_width == 4) {
                fprintf(b->out, "    mov bx, ax\n");
                if (rhs_width != 4) fprintf(b->out, "    xor dx, dx\n");
                fprintf(b->out, "    mov cx, dx\n    pop ax\n");
                if (lhs_width == 4) fprintf(b->out, "    pop dx\n");
                else fprintf(b->out, "    xor dx, dx\n");
                fprintf(b->out, "    cmp ax, bx\n    jne .Lwide_neq_%d\n", label);
                fprintf(b->out, "    cmp dx, cx\n    jne .Lwide_neq_%d\n", label);
                fprintf(b->out, "    mov ax, %d\n    jmp .Lwide_done_%d\n",
                        !strcmp(false_jump, "jne") ? 1 : 0, label);
                fprintf(b->out, ".Lwide_neq_%d:\n    mov ax, %d\n.Lwide_done_%d:\n",
                        label, !strcmp(false_jump, "jne") ? 0 : 1, label);
                b->expr_width = 2;
                b->expr_is_pointer = 0;
                b->expr_struct_id = -1;
            } else {
                fprintf(b->out, "    mov bx, ax\n    pop ax\n    cmp ax, bx\n");
                cg_bool_result(b, false_jump);
            }
        }
    }
}

static void cg_bitwise_and(BodyParser *b) {
    cg_equality(b);
    while (b->ok) {
        int lhs_width, rhs_width;
        body_ws(b);
        if (*b->p != '&' || b->p[1] == '&') break;
        lhs_width = b->expr_width;
        b->p++;
        if (lhs_width == 4) fprintf(b->out, "    push dx\n");
        fprintf(b->out, "    push ax\n");
        cg_equality(b);
        if (!b->ok) return;
        rhs_width = b->expr_width;
        fprintf(b->out, "    mov bx, ax\n");
        if (lhs_width == 4 || rhs_width == 4) {
            if (rhs_width != 4) fprintf(b->out, "    xor dx, dx\n");
            fprintf(b->out, "    mov cx, dx\n    pop ax\n");
            if (lhs_width == 4) fprintf(b->out, "    pop dx\n");
            else fprintf(b->out, "    xor dx, dx\n");
            fprintf(b->out, "    and ax, bx\n    and dx, cx\n");
            b->expr_width = 4;
        } else {
            fprintf(b->out, "    pop ax\n    and ax, bx\n");
            b->expr_width = 2;
        }
        b->expr_is_pointer = 0; b->expr_struct_id = -1;
    }
}
static void cg_bitwise_xor(BodyParser *b) {
    cg_bitwise_and(b);
    while (b->ok) {
        int lhs_width, rhs_width;
        body_ws(b); if (*b->p != '^') break;
        lhs_width = b->expr_width;
        b->p++;
        if (lhs_width == 4) fprintf(b->out, "    push dx\n");
        fprintf(b->out, "    push ax\n");
        cg_bitwise_and(b);
        if (!b->ok) return;
        rhs_width = b->expr_width;
        fprintf(b->out, "    mov bx, ax\n");
        if (lhs_width == 4 || rhs_width == 4) {
            if (rhs_width != 4) fprintf(b->out, "    xor dx, dx\n");
            fprintf(b->out, "    mov cx, dx\n    pop ax\n");
            if (lhs_width == 4) fprintf(b->out, "    pop dx\n");
            else fprintf(b->out, "    xor dx, dx\n");
            fprintf(b->out, "    xor ax, bx\n    xor dx, cx\n");
            b->expr_width = 4;
        } else {
            fprintf(b->out, "    pop ax\n    xor ax, bx\n");
            b->expr_width = 2;
        }
        b->expr_is_pointer = 0; b->expr_struct_id = -1;
    }
}
static void cg_bitwise_or(BodyParser *b) {
    cg_bitwise_xor(b);
    while (b->ok) {
        int lhs_width, rhs_width;
        body_ws(b);
        if (*b->p != '|' || b->p[1] == '|') break;
        lhs_width = b->expr_width;
        b->p++;
        if (lhs_width == 4) fprintf(b->out, "    push dx\n");
        fprintf(b->out, "    push ax\n");
        cg_bitwise_xor(b);
        if (!b->ok) return;
        rhs_width = b->expr_width;
        fprintf(b->out, "    mov bx, ax\n");
        if (lhs_width == 4 || rhs_width == 4) {
            if (rhs_width != 4) fprintf(b->out, "    xor dx, dx\n");
            fprintf(b->out, "    mov cx, dx\n    pop ax\n");
            if (lhs_width == 4) fprintf(b->out, "    pop dx\n");
            else fprintf(b->out, "    xor dx, dx\n");
            fprintf(b->out, "    or ax, bx\n    or dx, cx\n");
            b->expr_width = 4;
        } else {
            fprintf(b->out, "    pop ax\n    or ax, bx\n");
            b->expr_width = 2;
        }
        b->expr_is_pointer = 0; b->expr_struct_id = -1;
    }
}

static void cg_logical_and(BodyParser *b) {
    cg_bitwise_or(b);
    while (b->ok) {
        int label;
        body_ws(b);
        if (strncmp(b->p, "&&", 2) != 0) break;
        b->p += 2;
        label = b->next_label++;
        fprintf(b->out, "    cmp ax, 0\n");
        fprintf(b->out, "    je .Land_false_%d\n", label);
        cg_bitwise_or(b);
        if (!b->ok) return;
        fprintf(b->out, "    cmp ax, 0\n");
        fprintf(b->out, "    je .Land_false_%d\n", label);
        fprintf(b->out, "    mov ax, 1\n");
        fprintf(b->out, "    jmp .Land_end_%d\n", label);
        fprintf(b->out, ".Land_false_%d:\n", label);
        fprintf(b->out, "    mov ax, 0\n");
        fprintf(b->out, ".Land_end_%d:\n", label);
    }
}

static void cg_logical_or(BodyParser *b) {
    cg_logical_and(b);
    while (b->ok) {
        int label;
        body_ws(b);
        if (strncmp(b->p, "||", 2) != 0) break;
        b->p += 2;
        label = b->next_label++;
        fprintf(b->out, "    cmp ax, 0\n");
        fprintf(b->out, "    jne .Lor_true_%d\n", label);
        cg_logical_and(b);
        if (!b->ok) return;
        fprintf(b->out, "    cmp ax, 0\n");
        fprintf(b->out, "    jne .Lor_true_%d\n", label);
        fprintf(b->out, "    mov ax, 0\n");
        fprintf(b->out, "    jmp .Lor_end_%d\n", label);
        fprintf(b->out, ".Lor_true_%d:\n", label);
        fprintf(b->out, "    mov ax, 1\n");
        fprintf(b->out, ".Lor_end_%d:\n", label);
    }
}

static void cg_expr(BodyParser *b) {
    int label;
    {
        const char *save = b->p;
        char an[64];
        if (body_ident(b, an, sizeof(an))) {
            int lp = 0, lc = 0, ls = -1, lw = 2;
            b->p = save; b->ok = 1;
            if (cg_lvalue_address(b, &lp, &lc, &ls)) {
                lw = b->lvalue_width;
                body_ws(b);
                if (*b->p == '=' && b->p[1] != '=') {
                    fprintf(b->out, "    push ax\n");
                    b->p++;
                    cg_expr(b);
                    if (!b->ok) return;
                    /* C permits integer constant zero as the null pointer
                       constant.  Other scalar-to-pointer assignments remain
                       rejected by the ordinary type checks. */
                    if (lp && !b->expr_is_pointer) {
                        const char *rq = b->p;
                        (void)rq;
                    }
                    fprintf(b->out, "    pop bx\n");
                    if (lc && !lp) fprintf(b->out, "    mov [bx], al\n");
                    else if (!lp && lw == 4) {
                        if (b->expr_width != 4) fprintf(b->out, "    xor dx, dx\n");
                        fprintf(b->out, "    mov [bx], ax\n    mov [bx+2], dx\n");
                    } else fprintf(b->out, "    mov [bx], ax\n");
                    return;
                }
            }
        }
        b->p = save; b->ok = 1;
    }
    cg_logical_or(b);
    if (!b->ok) return;
    body_ws(b);
    if (*b->p != '?') return;
    label = b->next_label++;
    b->p++;
    fprintf(b->out, "    cmp ax, 0\n    je .Lcond_false_%d\n", label);
    cg_expr(b);
    if (!b->ok) return;
    fprintf(b->out, "    jmp .Lcond_end_%d\n.Lcond_false_%d:\n", label, label);
    body_ws(b);
    if (*b->p != ':') { b->ok = 0; return; }
    b->p++;
    cg_expr(b);
    if (!b->ok) return;
    fprintf(b->out, ".Lcond_end_%d:\n", label);
}

static int count_decl_list_slots(const char *q, int base_width, int is_char) {
    int total = 0;
    (void)is_char;
    for (;;) {
        int pd = 0, slots = 0, depth = 0;
        char *end = NULL; long n = 0;
        int is_far = 0;
        while (isspace((unsigned char)*q)) q++;
        if (!strncmp(q, "far", 3) &&
            !(isalnum((unsigned char)q[3]) || q[3] == '_')) {
            is_far = 1;
            q += 3;
            while (isspace((unsigned char)*q)) q++;
        }
        while (*q == '*') { pd++; q++; while (isspace((unsigned char)*q)) q++; }
        if (!(isalpha((unsigned char)*q) || *q == '_')) return total;
        q++; while (isalnum((unsigned char)*q) || *q == '_') q++;
        while (isspace((unsigned char)*q)) q++;
        if (*q == '[') {
            q++; while (isspace((unsigned char)*q)) q++;
            errno = 0; n = strtol(q, &end, 0);
            if (end != q && !errno && n > 0 && n <= MAX_LOCALS) {
                slots = ((int)n * (pd ? 2 : base_width) + 1) / 2;
                q = end; while (*q && *q != ']') q++; if (*q == ']') q++;
            } else slots = 1;
        } else {
            slots = is_far && pd == 1 ? 2 : (pd ? 1 : (base_width + 1) / 2);
        }
        total += slots;
        while (*q) {
            if (*q == '(' || *q == '[') depth++;
            else if (*q == ')' || *q == ']') { if (depth > 0) depth--; }
            else if (depth == 0 && (*q == ',' || *q == ';')) break;
            q++;
        }
        if (*q == ',') { q++; continue; }
        return total;
    }
}

static int count_local_slots(const char *body) {
    const char *p = body;
    int slots = 0;
    while (*p) {
        int is_char_kw = 0;
        if (isalpha((unsigned char)*p) || *p == '_') {
            const char *q=p; char tn[64]; size_t n=0; int ai;
            while((isalnum((unsigned char)*q)||*q=='_') && n+1<sizeof(tn)) tn[n++]=*q++;
            tn[n]=0; ai=alias_find(tn);
            if(ai>=0) {
                slots += count_decl_list_slots(q, g_aliases[ai].width, g_aliases[ai].is_char);
                while (*q && *q != ';') q++;
                if (*q == ';') { p = q + 1; continue; }
            }
        }
        if (!strncmp(p, "struct", 6) && !(isalnum((unsigned char)p[6]) || p[6] == '_') &&
            (p == body || !(isalnum((unsigned char)p[-1]) || p[-1] == '_'))) {
            const char *q = p + 6; char sname[64]; size_t sn = 0; int sid;
            while (isspace((unsigned char)*q)) q++;
            while ((isalnum((unsigned char)*q) || *q == '_') && sn + 1 < sizeof(sname)) sname[sn++] = *q++;
            sname[sn] = 0; sid = struct_find(sname);
            while (isspace((unsigned char)*q)) q++;
            if (sid >= 0) {
                for (;;) {
                    int pd=0;
                    while(*q=='*'){pd++;q++;while(isspace((unsigned char)*q))q++;}
                    if(!(isalpha((unsigned char)*q)||*q=='_'))break;
                    while(isalnum((unsigned char)*q)||*q=='_')q++;
                    slots += pd ? 1 : (g_structs[sid].size_bytes + 1) / 2;
                    while(isspace((unsigned char)*q))q++;
                    if(*q!=',')break;
                    q++;while(isspace((unsigned char)*q))q++;
                }
            }
        }
        if (((!strncmp(p,"unsigned",8) && isspace((unsigned char)p[8])) || (!strncmp(p,"signed",6) && isspace((unsigned char)p[6]))) &&
            (p == body || !(isalnum((unsigned char)p[-1]) || p[-1]=='_'))) {
            const char *q=p + (!strncmp(p,"unsigned",8)?8:6); int cw=0;
            while(isspace((unsigned char)*q))q++;
            if(!strncmp(q,"short",5) && !(isalnum((unsigned char)q[5])||q[5]=='_')) { q+=5; while(isspace((unsigned char)*q))q++; if(!strncmp(q,"int",3)&&!(isalnum((unsigned char)q[3])||q[3]=='_'))q+=3; slots += count_decl_list_slots(q,2,0); }
            else if(!strncmp(q,"long",4) && !(isalnum((unsigned char)q[4])||q[4]=='_')) { q+=4; while(isspace((unsigned char)*q))q++; if(!strncmp(q,"int",3)&&!(isalnum((unsigned char)q[3])||q[3]=='_'))q+=3; slots += count_decl_list_slots(q,4,0); }
            else if(!strncmp(q,"int",3) && !(isalnum((unsigned char)q[3])||q[3]=='_')) { q+=3; slots += count_decl_list_slots(q,2,0); }
            else if((cw=!strncmp(q,"char",4)) && !(isalnum((unsigned char)q[4])||q[4]=='_')) { q+=4; slots += count_decl_list_slots(q,1,1); }
            else slots += count_decl_list_slots(q,2,0);
            (void)cw;
            { const char *semi=strchr(q,';'); if(semi) p=semi; }
        }
        if ((!strncmp(p, "int", 3) || !strncmp(p,"short",5) || !strncmp(p,"long",4) || (is_char_kw = !strncmp(p, "char", 4))) &&
            (p == body || !(isalnum((unsigned char)p[-1]) || p[-1] == '_'))) {
            int is_long_kw = !strncmp(p,"long",4);
            int kwlen = is_char_kw ? 4 : (is_long_kw ? 4 : (!strncmp(p,"short",5) ? 5 : 3));
            if (isspace((unsigned char)p[kwlen])) {
                const char *q = p + kwlen;
                slots += count_decl_list_slots(q, is_char_kw ? 1 : (is_long_kw ? 4 : 2), is_char_kw);
            }
        }
        p++;
    }
    return slots;
}

static void cg_statement(BodyParser *b, int *saw_return);

static void cg_block(BodyParser *b, int *saw_return) {
    body_ws(b);
    if (*b->p != '{') { b->ok = 0; return; }
    b->p++;
    scope_enter(b);
    if (!b->ok) return;
    while (b->ok) {
        body_ws(b);
        if (*b->p == '}') {
            b->p++;
            scope_leave(b);
            return;
        }
        if (*b->p == '\0') { b->ok = 0; return; }
        cg_statement(b, saw_return);
    }
}

static void cg_statement(BodyParser *b, int *saw_return) {
    char name[64];
    int idx;
    const char *statement_start;

    body_ws(b);
    statement_start = b->p;
    if (*b->p == '{') {
        cg_block(b, saw_return);
        return;
    }

    /* C null statement.  This matters for ordinary constructs such as
     * for (...); and while (...); and is a statement in its own right. */
    if (*b->p == ';') {
        b->p++;
        return;
    }

    /* Blackjack16 inline assembly.  Version 1 deliberately has a very small
     * contract: asm { ... } is an opaque statement whose contents are copied
     * to the generated x86-as source in order.  There are no C operands or
     * constraints yet; the block is the machine boundary. */
    if (body_kw(b, "asm")) {
        const char *p;
        const char *start;
        int depth = 1;

        body_ws(b);
        if (*b->p != '{') { b->ok = 0; return; }
        b->p++;
        start = b->p;
        p = b->p;
        while (*p && depth) {
            if (*p == '{') depth++;
            else if (*p == '}') depth--;
            if (depth) p++;
        }
        if (depth || *p != '}') { b->ok = 0; return; }

        fprintf(b->out, "    ; x86-cc asm begin\n");
        while (start < p) fputc(*start++, b->out);
        if (p > b->p && p[-1] != '\n') fputc('\n', b->out);
        fprintf(b->out, "    ; x86-cc asm end\n");
        b->p = p + 1;
        return;
    }

    if (b->p[0] == '+' && b->p[1] == '+') {
        b->p += 2;
        if (!body_ident(b, name, sizeof(name))) { b->ok = 0; return; }
        idx = local_find(b, name);
        if (idx < 0 || b->locals[idx].is_pointer || b->locals[idx].array_len) { b->ok = 0; return; }
        if (b->locals[idx].width == 4) {
            emit_bp_load(b->out, b->locals[idx].offset);
            fprintf(b->out, "    add ax, 1\n");
            emit_bp_store(b->out, b->locals[idx].offset);
            if (b->locals[idx].offset + 2 >= 0)
                fprintf(b->out, "    mov ax, [bp+%d]\n    adc ax, 0\n    mov [bp+%d], ax\n",
                        b->locals[idx].offset + 2, b->locals[idx].offset + 2);
            else
                fprintf(b->out, "    mov ax, [bp-%d]\n    adc ax, 0\n    mov [bp-%d], ax\n",
                        -(b->locals[idx].offset + 2), -(b->locals[idx].offset + 2));
        } else if (b->locals[idx].is_char) {
            if (b->locals[idx].offset >= 0) fprintf(b->out, "    inc byte [bp+%d]\n", b->locals[idx].offset);
            else fprintf(b->out, "    inc byte [bp-%d]\n", -b->locals[idx].offset);
        } else {
            if (b->locals[idx].offset >= 0) fprintf(b->out, "    inc word [bp+%d]\n", b->locals[idx].offset);
            else fprintf(b->out, "    inc word [bp-%d]\n", -b->locals[idx].offset);
        }
        body_ws(b);
        if (*b->p != ';') { b->ok = 0; return; }
        b->p++;
        return;
    }

    if (body_kw(b, "for")) {
        int label = b->next_label++;
        char incbuf[512];
        size_t incn = 0;
        const char *incstart;
        BodyParser t;
        int dummy_return = 0;

        if (b->loop_depth >= 32) { b->ok = 0; return; }
        /* C gives a for-init declaration a scope spanning condition,
         * increment, and body, ending with the for statement. */
        scope_enter(b);
        if (!b->ok) return;
        body_ws(b);
        if (*b->p != '(') { b->ok = 0; return; }
        b->p++;
        body_ws(b);

        /* initializer: declaration, assignment, or empty */
        if (*b->p != ';') {
            cg_statement(b, saw_return);
            if (!b->ok) return;
        } else {
            b->p++;
        }

        fprintf(b->out, ".Lfor_cond_%d:\n", label);
        body_ws(b);
        if (*b->p != ';') {
            cg_expr(b);
            body_ws(b);
            if (!b->ok || *b->p != ';') { b->ok = 0; return; }
            b->p++;
            fprintf(b->out, "    cmp ax, 0\n");
            fprintf(b->out, "    jne .Lfor_body_%d\n", label);
            fprintf(b->out, "    jmp .Lfor_end_%d\n", label);
            fprintf(b->out, ".Lfor_body_%d:\n", label);
        } else {
            b->p++;
        }

        /* Save the increment clause. It is emitted after the body. */
        body_ws(b);
        incstart = b->p;
        while (*b->p && *b->p != ')') b->p++;
        if (*b->p != ')') { b->ok = 0; return; }
        incn = (size_t)(b->p - incstart);
        if (incn + 2 > sizeof(incbuf)) { b->ok = 0; return; }
        memcpy(incbuf, incstart, incn);
        incbuf[incn] = ';';
        incbuf[incn + 1] = '\0';
        b->p++;

        b->break_label[b->loop_depth] = label;
        b->continue_label[b->loop_depth] = label;
        b->loop_kind[b->loop_depth] = 1;
        b->loop_depth++;
        cg_statement(b, saw_return);
        b->loop_depth--;
        if (!b->ok) return;

        fprintf(b->out, ".Lfor_continue_%d:\n", label);
        if (incn != 0) {
            t = *b;
            t.p = incbuf;
            t.ok = 1;
            cg_statement(&t, &dummy_return);
            body_ws(&t);
            if (!t.ok || *t.p != '\0') { b->ok = 0; return; }
            b->next_label = t.next_label;
        }
        fprintf(b->out, "    jmp .Lfor_cond_%d\n", label);
        fprintf(b->out, ".Lfor_end_%d:\n", label);
        scope_leave(b);
        return;
    }

    if (body_kw(b, "do")) {
        int label = b->next_label++;
        if (b->loop_depth >= 32) { b->ok = 0; return; }
        fprintf(b->out, ".Ldo_body_%d:\n", label);
        b->break_label[b->loop_depth] = label;
        b->continue_label[b->loop_depth] = label;
        b->loop_kind[b->loop_depth] = 2;
        b->loop_depth++;
        cg_statement(b, saw_return);
        b->loop_depth--;
        if (!b->ok || !body_kw(b, "while")) { b->ok = 0; return; }
        body_ws(b);
        if (*b->p != '(') { b->ok = 0; return; }
        b->p++;
        fprintf(b->out, ".Ldo_cond_%d:\n", label);
        cg_expr(b); body_ws(b);
        if (!b->ok || *b->p != ')') { b->ok = 0; return; }
        b->p++; body_ws(b);
        if (*b->p != ';') { b->ok = 0; return; }
        b->p++;
        fprintf(b->out, "    cmp ax, 0\n    jne .Ldo_body_%d\n.Ldo_end_%d:\n", label, label);
        return;
    }

    if (body_kw(b, "while")) {
        int label = b->next_label++;
        if (b->loop_depth >= 32) { b->ok = 0; return; }
        body_ws(b);
        if (*b->p != '(') { b->ok = 0; return; }
        b->p++;
        fprintf(b->out, ".Lwhile_cond_%d:\n", label);
        cg_expr(b);
        body_ws(b);
        if (!b->ok || *b->p != ')') { b->ok = 0; return; }
        b->p++;
        fprintf(b->out, "    cmp ax, 0\n");
        fprintf(b->out, "    jne .Lwhile_body_%d\n", label);
        fprintf(b->out, "    jmp .Lwhile_end_%d\n", label);
        fprintf(b->out, ".Lwhile_body_%d:\n", label);
        b->break_label[b->loop_depth] = label;
        b->continue_label[b->loop_depth] = label;
        b->loop_kind[b->loop_depth] = 0;
        b->loop_depth++;
        cg_statement(b, saw_return);
        b->loop_depth--;
        if (!b->ok) return;
        fprintf(b->out, "    jmp .Lwhile_cond_%d\n", label);
        fprintf(b->out, ".Lwhile_end_%d:\n", label);
        return;
    }

    if (body_kw(b, "break")) {
        int label;
        body_ws(b);
        if (*b->p != ';') { b->ok = 0; return; }
        b->p++;
        if (b->switch_depth > 0 &&
            b->loop_depth == b->switch_outer_loop_depth[b->switch_depth - 1]) {
            fprintf(b->out, "    jmp .Lswitch_end_%d\n", b->switch_end_label[b->switch_depth - 1]);
            return;
        }
        if (b->loop_depth <= 0) { b->ok = 0; return; }
        label = b->break_label[b->loop_depth - 1];
        if (b->loop_kind[b->loop_depth - 1] == 1) fprintf(b->out, "    jmp .Lfor_end_%d\n", label);
        else if (b->loop_kind[b->loop_depth - 1] == 2) fprintf(b->out, "    jmp .Ldo_end_%d\n", label);
        else fprintf(b->out, "    jmp .Lwhile_end_%d\n", label);
        return;
    }

    if (body_kw(b, "continue")) {
        int label;
        if (b->loop_depth <= 0) { b->ok = 0; return; }
        body_ws(b);
        if (*b->p != ';') { b->ok = 0; return; }
        b->p++;
        label = b->continue_label[b->loop_depth - 1];
        if (b->loop_kind[b->loop_depth - 1])
            fprintf(b->out, "    jmp .Lfor_continue_%d\n", label);
        else
            fprintf(b->out, "    jmp .Lwhile_cond_%d\n", label);
        return;
    }

    if (body_kw(b, "switch")) {
        int end_label = b->next_label++, base = b->next_label;
        int case_count = 0, default_label = -1, depth = 0;
        const char *scan;
        if (b->switch_depth >= 16) { b->ok = 0; return; }
        body_ws(b); if (*b->p != '(') { b->ok = 0; return; }
        b->p++; cg_expr(b); body_ws(b);
        if (!b->ok || *b->p != ')') { b->ok = 0; return; }
        b->p++; body_ws(b); if (*b->p != '{') { b->ok = 0; return; }
        scan = b->p + 1; depth = 1;
        while (*scan && depth) {
            if (*scan == '{') { depth++; scan++; continue; }
            if (*scan == '}') { depth--; scan++; continue; }
            if (depth == 1 && !strncmp(scan, "case", 4) && isspace((unsigned char)scan[4])) {
                const char *q = scan + 4; long cv = 0;
                while (isspace((unsigned char)*q)) q++;
                if (*q == '\'') { q++; cv = (unsigned char)*q++; if (*q == '\'') q++; }
                else { char *ep=NULL; cv=strtol(q,&ep,0); if(ep==q){b->ok=0;return;} q=ep; }
                while (isspace((unsigned char)*q)) q++;
                if (*q != ':') { b->ok=0; return; }
                fprintf(b->out, "    cmp ax, %ld\n    jne .Lswitch_next_%d\n    jmp .Lswitch_case_%d\n.Lswitch_next_%d:\n",
                        cv, base + case_count, base + case_count, base + case_count);
                case_count++; scan = q + 1; continue;
            }
            if (depth == 1 && !strncmp(scan, "default", 7) && scan[7] == ':') {
                default_label = base + 100; scan += 8; continue;
            }
            scan++;
        }
        b->next_label += case_count + 101;
        fprintf(b->out, "    jmp .Lswitch_%s_%d\n", default_label >= 0 ? "default" : "end",
                default_label >= 0 ? default_label : end_label);
        b->switch_end_label[b->switch_depth] = end_label;
        b->switch_case_base[b->switch_depth] = base;
        b->switch_case_index[b->switch_depth] = 0;
        b->switch_outer_loop_depth[b->switch_depth] = b->loop_depth;
        b->switch_depth++;
