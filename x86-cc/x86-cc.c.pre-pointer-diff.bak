                    if (((b->p[0] == '+' || b->p[0] == '-' || b->p[0] == '*' || b->p[0] == '/' || b->p[0] == '%' || b->p[0] == '^' || b->p[0] == '&' || b->p[0] == '|') && b->p[1] == '=') || ((b->p[0] == '<' || b->p[0] == '>') && b->p[1] == b->p[0] && b->p[2] == '=')) {
                        compound = b->p[0]; b->p += (compound == '<' || compound == '>') ? 3 : 2;
