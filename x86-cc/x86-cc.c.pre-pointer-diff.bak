        } else if (raw_active && end-line>=7&&!strncmp(line,"#define",7)&&isspace((unsigned char)line[7])) {
            const char *q=line+7,*v; char nbuf[64],vbuf[256]; size_t nn=0,vn;
            while(q<end&&isspace((unsigned char)*q))q++;
            while(q<end&&(isalnum((unsigned char)*q)||*q=='_')&&nn+1<sizeof(nbuf))nbuf[nn++]=*q++;
            nbuf[nn]=0;
            v=q; while(v<end&&isspace((unsigned char)*v))v++; vn=(size_t)(end-v); if(vn>=sizeof(vbuf))vn=sizeof(vbuf)-1; memcpy(vbuf,v,vn);vbuf[vn]=0;
