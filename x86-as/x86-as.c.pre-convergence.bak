        else if(!strncmp(memop,"word ",5)){width=16;memmove(memop,memop+5,strlen(memop+5)+1);}
        Mem m; int pm=parse_mem(a,memop,ln,&m);
        if(pm==1&&width){emit_mem_prefix(a,&m);emit8(a,width==8?0xF6:0xF7);emit_modrm_mem_abs16(a,ext,&m,memop,ln);return;}
