    if((!strcmp(word,"les")||!strcmp(word,"lds"))&&no==2&&reg16(ops[0])>=0){Mem m;int pm=parse_mem(a,ops[1],ln,&m);if(pm==1){emit_mem_prefix(a,&m);emit8(a,!strcmp(word,"les")?0xC4:0xC5);emit_modrm_mem_abs16(a,reg16(ops[0]),&m,ops[1],ln);return;}if(pm<0)return;err(a,ln,"LES/LDS requires an 8086 memory operand");return;}
