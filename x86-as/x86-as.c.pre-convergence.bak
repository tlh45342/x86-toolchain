/* x86-as.c - small NASM-like flat-binary assembler for the x86 project.
 * Version 0.0.1
 * Scope: 8086/8088-oriented, two-pass, intentionally small.
 */
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <ctype.h>
#include <errno.h>

#define X86AS_VERSION "0.0.31"
#define MAX_LINES 16384
#define MAX_LINE 512
#define MAX_SYMS 4096
#define MAX_MACROS 128
#define MAX_MACRO_LINES 64
#define MAX_ARGS 16

typedef struct { char text[MAX_LINE]; int line_no; } SrcLine;
typedef struct { char name[64]; int nargs; char body[MAX_MACRO_LINES][MAX_LINE]; int nbody; } Macro;
typedef struct { char name[96]; uint32_t value; int defined; } Symbol;
typedef struct { uint32_t offset; char symbol[96]; int64_t addend; uint32_t type; } Reloc;

typedef struct {
    SrcLine lines[MAX_LINES]; int nlines;
    Macro macros[MAX_MACROS]; int nmacros;
    Symbol syms[MAX_SYMS]; int nsyms;
    char globals[128][96]; int nglobals;
    Reloc relocs[2048]; int nrelocs;
    uint32_t org;
    uint32_t pc;
    int cpu_level; /* 86 for strict 8086 */
    int mode_bits; /* 16 legacy default, 64 when -m64 is selected */
    int output_elf64; /* -f elf64; currently valid only with -m64 */
    int output_bjobj; /* -f bjobj: Blackjack 16-bit relocatable object */
    int pass;
    FILE *out;
    int errors;
} Asm;

static void lower(char *s){ for(;*s;s++) *s=(char)tolower((unsigned char)*s); }
static void trim(char *s){
    char *p=s; while(isspace((unsigned char)*p)) p++;
    if(p!=s) memmove(s,p,strlen(p)+1);
    size_t n=strlen(s); while(n && isspace((unsigned char)s[n-1])) s[--n]=0;
}
static void strip_comment(char *s){
    int sq=0,dq=0,br=0;
    for(char *p=s;*p;p++){
        if(*p=='\'' && !dq) sq=!sq;
        else if(*p=='"' && !sq) dq=!dq;
        else if(*p=='[' && !sq && !dq) br++;
        else if(*p==']' && !sq && !dq && br) br--;
        else if(*p==';' && !sq && !dq && !br){*p=0;break;}
    }
}
static void err(Asm *a,int ln,const char *msg){ fprintf(stderr,"x86-as:%d: error: %s\n",ln,msg); a->errors++; }
static int sym_find(Asm *a,const char *name,uint32_t *v){
    for (int i = 0; i < a->nsyms; i++) {
        if (!strcmp(a->syms[i].name, name) && a->syms[i].defined) {
            *v = a->syms[i].value;
            return 1;
        }
    }
    return 0;
}
static int global_has(Asm *a,const char *name){
    for(int i=0;i<a->nglobals;i++) if(!strcmp(a->globals[i],name)) return 1;
    return 0;
}
static void global_add(Asm *a,const char *name,int ln){
    if(global_has(a,name)) return;
    if(a->nglobals>=128){err(a,ln,"too many global symbols");return;}
    snprintf(a->globals[a->nglobals++],96,"%s",name);
}
static int global_index(Asm *a,const char *name){
    for(int i=0;i<a->nglobals;i++) if(!strcmp(a->globals[i],name)) return i;
    return -1;
}
static void reloc_add(Asm *a,uint32_t offset,const char *symbol,int64_t addend,uint32_t type,int ln){
    if(a->pass!=2) return;
    if(a->nrelocs>=2048){err(a,ln,"too many relocations");return;}
    Reloc *r=&a->relocs[a->nrelocs++];
    r->offset=offset;r->addend=addend;r->type=type;
    snprintf(r->symbol,sizeof(r->symbol),"%s",symbol);
}
static void sym_set(Asm *a,const char *name,uint32_t v,int ln){
    for(int i=0;i<a->nsyms;i++) if(!strcmp(a->syms[i].name,name)){
        if(a->pass==1 && a->syms[i].defined){err(a,ln,"duplicate symbol"); return;}
        a->syms[i].value=v; a->syms[i].defined=1; return;
    }
    if(a->nsyms>=MAX_SYMS){err(a,ln,"too many symbols");return;}
    snprintf(a->syms[a->nsyms].name,sizeof(a->syms[a->nsyms].name),"%s",name);
    a->syms[a->nsyms].value=v; a->syms[a->nsyms].defined=1; a->nsyms++;
}

typedef struct { const char *p; Asm *a; int ln; int ok; } Expr;
static void eskip(Expr *e){while(isspace((unsigned char)*e->p))e->p++;}
static int64_t expr_or(Expr *e);
static int64_t expr_primary(Expr *e){
    eskip(e);
    if(*e->p=='('){ e->p++; int64_t v=expr_or(e); eskip(e); if(*e->p==')')e->p++; else {err(e->a,e->ln,"missing ')' in expression");e->ok=0;} return v; }
    if(*e->p=='\''){
        e->p++; unsigned char c=(unsigned char)*e->p++;
        if(c=='\\') { char q=*e->p++; if(q=='n')c='\n'; else if(q=='r')c='\r'; else if(q=='t')c='\t'; else c=(unsigned char)q; }
        if(*e->p!='\''){err(e->a,e->ln,"bad character literal");e->ok=0;} else e->p++;
        return c;
    }
    if(*e->p=='$'){
        if(e->p[1]=='$'){e->p+=2;return e->a->org;} e->p++; return (int64_t)e->a->org + e->a->pc;
    }
    if(isdigit((unsigned char)*e->p)){
        char *end=NULL; errno=0; unsigned long v=strtoul(e->p,&end,0);
        if(end==e->p || errno){err(e->a,e->ln,"bad number");e->ok=0;return 0;} e->p=end; return (int64_t)v;
    }
    if(isalpha((unsigned char)*e->p)||*e->p=='_'||*e->p=='.'){
        char name[96];int n=0; while(isalnum((unsigned char)*e->p)||*e->p=='_'||*e->p=='.') {if(n<95)name[n++]=*e->p;e->p++;} name[n]=0;
        uint32_t v=0; if(sym_find(e->a,name,&v)) return v;
        if(e->a->pass==1) return 0;
        char m[160];snprintf(m,sizeof(m),"unknown symbol '%s'",name);err(e->a,e->ln,m);e->ok=0;return 0;
    }
    err(e->a,e->ln,"bad expression");e->ok=0;return 0;
}
static int64_t expr_unary(Expr *e){eskip(e); if(*e->p=='+'){e->p++;return expr_unary(e);} if(*e->p=='-'){e->p++;return -expr_unary(e);} if(*e->p=='~'){e->p++;return ~expr_unary(e);} return expr_primary(e);}
static int64_t expr_mul(Expr *e){int64_t v=expr_unary(e); for(;;){eskip(e); char op=*e->p;if(op!='*'&&op!='/'&&op!='%')break;e->p++;int64_t r=expr_unary(e);if((op=='/'||op=='%')&&r==0){err(e->a,e->ln,"divide by zero");e->ok=0;r=1;} if(op=='*')v*=r;else if(op=='/')v/=r;else v%=r;}return v;}
static int64_t expr_add(Expr *e){int64_t v=expr_mul(e);for(;;){eskip(e);char op=*e->p;if(op!='+'&&op!='-')break;e->p++;int64_t r=expr_mul(e);v=(op=='+')?v+r:v-r;}return v;}
static int64_t expr_shift(Expr *e){int64_t v=expr_add(e);for(;;){eskip(e);if(e->p[0]=='<'&&e->p[1]=='<'){e->p+=2;v<<=expr_add(e);}else if(e->p[0]=='>'&&e->p[1]=='>'){e->p+=2;v>>=expr_add(e);}else break;}return v;}
static int64_t expr_and(Expr *e){int64_t v=expr_shift(e);for(;;){eskip(e);if(*e->p!='&'||e->p[1]=='&')break;e->p++;v&=expr_shift(e);}return v;}
static int64_t expr_xor(Expr *e){int64_t v=expr_and(e);for(;;){eskip(e);if(*e->p!='^')break;e->p++;v^=expr_and(e);}return v;}
static int64_t expr_or(Expr *e){int64_t v=expr_xor(e);for(;;){eskip(e);if(*e->p!='|'||e->p[1]=='|')break;e->p++;v|=expr_xor(e);}return v;}
static int64_t eval(Asm *a,const char *s,int ln,int *ok){Expr e={s,a,ln,1};int64_t v=expr_or(&e);eskip(&e);if(*e.p){err(a,ln,"trailing text in expression");e.ok=0;}if(ok)*ok=e.ok;return v;}

static void emit8(Asm*a,uint8_t v){if(a->pass==2&&a->out)fputc(v,a->out);a->pc++;}
static void emit16(Asm*a,uint16_t v){emit8(a,(uint8_t)v);emit8(a,(uint8_t)(v>>8));}
/* BJO1 ABS16 is deliberately small: for an object-local symbolic word the
 * assembler writes the object's own offset as the addend and records type 2.
 * The Blackjack16 linker adds the object's final placement plus link base. */
static int has_symbol_token(const char *s){
    while(*s){
        if(isdigit((unsigned char)*s)){ while(isalnum((unsigned char)*s)) s++; continue; }
        if(isalpha((unsigned char)*s)||*s=='_'||*s=='.'){
            char w[96];int n=0;
            while(isalnum((unsigned char)*s)||*s=='_'||*s=='.'){if(n<95)w[n++]=(char)tolower((unsigned char)*s);s++;}
            w[n]=0;
            if(strcmp(w,"ax")&&strcmp(w,"bx")&&strcmp(w,"cx")&&strcmp(w,"dx")&&
               strcmp(w,"sp")&&strcmp(w,"bp")&&strcmp(w,"si")&&strcmp(w,"di")&&
               strcmp(w,"al")&&strcmp(w,"ah")&&strcmp(w,"bl")&&strcmp(w,"bh")&&
               strcmp(w,"cl")&&strcmp(w,"ch")&&strcmp(w,"dl")&&strcmp(w,"dh")&&
               strcmp(w,"es")&&strcmp(w,"cs")&&strcmp(w,"ss")&&strcmp(w,"ds")&&
               strcmp(w,"byte")&&strcmp(w,"word")) return 1;
            continue;
        }
        s++;
    }
    return 0;
}
static void bj_abs16_local(Asm *a,uint32_t off,const char *expr,int ln){
    if(a->output_bjobj && has_symbol_token(expr)) reloc_add(a,off,"",0,2,ln);
}
static void emit32(Asm*a,uint32_t v){for(int i=0;i<4;i++)emit8(a,(uint8_t)(v>>(i*8)));}
static void emit64(Asm*a,uint64_t v){for(int i=0;i<8;i++)emit8(a,(uint8_t)(v>>(i*8)));}
static int reg16(const char*s){static const char*n[]={"ax","cx","dx","bx","sp","bp","si","di"};for(int i=0;i<8;i++)if(!strcmp(s,n[i]))return i;return -1;}
static int reg64(const char*s){static const char*n[]={"rax","rcx","rdx","rbx","rsp","rbp","rsi","rdi"};for(int i=0;i<8;i++)if(!strcmp(s,n[i]))return i;return -1;}
static int reg8(const char*s){static const char*n[]={"al","cl","dl","bl","ah","ch","dh","bh"};for(int i=0;i<8;i++)if(!strcmp(s,n[i]))return i;return -1;}
static int sreg(const char*s){if(!strcmp(s,"es"))return 0;if(!strcmp(s,"cs"))return 1;if(!strcmp(s,"ss"))return 2;if(!strcmp(s,"ds"))return 3;return -1;}

static int split_operands(char *s,char *ops[],int max){int n=0,depth=0,sq=0,dq=0;char *start=s;for(char*p=s;;p++){char c=*p;if(c=='\''&&!dq)sq=!sq;else if(c=='"'&&!sq)dq=!dq;else if(!sq&&!dq){if(c=='['||c=='(')depth++;else if((c==']'||c==')')&&depth)depth--;if((c==','&&depth==0)||c==0){if(n<max){*p=0;trim(start);ops[n++]=start;}if(c==0)break;start=p+1;}}}return n;}

typedef struct {int seg;int rm;int mod;int disp_size;int32_t disp;} Mem;
static int parse_mem(Asm*a,const char*src,int ln,Mem*m){
    char b[256];snprintf(b,sizeof(b),"%s",src);trim(b);lower(b);size_t L=strlen(b);if(L<2||b[0]!='['||b[L-1]!=']')return 0;b[L-1]=0;char *p=b+1;trim(p);
    m->seg=-1;m->disp=0;m->disp_size=0;
    char *colon=strchr(p,':');if(colon){*colon=0;trim(p);m->seg=sreg(p);if(m->seg<0){err(a,ln,"bad segment override");return -1;}p=colon+1;trim(p);}
    int has_bx=0,has_bp=0,has_si=0,has_di=0;int sign=1;char tok[96];int tn=0;
    for(;;){while(isspace((unsigned char)*p))p++; if(*p=='+'||*p=='-'){sign=*p=='-'?-1:1;p++;continue;} if(!*p)break;tn=0;while(*p&&*p!='+'&&*p!='-'){if(tn<95)tok[tn++]=*p;p++;}tok[tn]=0;trim(tok);
        if(!strcmp(tok,"bx"))has_bx=1;else if(!strcmp(tok,"bp"))has_bp=1;else if(!strcmp(tok,"si"))has_si=1;else if(!strcmp(tok,"di"))has_di=1;else {int ok=1;int64_t v=eval(a,tok,ln,&ok);m->disp+=(int32_t)(sign*v);} sign=1;
    }
    if(has_bx&&has_si&&!has_bp&&!has_di)m->rm=0;else if(has_bx&&has_di&&!has_bp&&!has_si)m->rm=1;else if(has_bp&&has_si&&!has_bx&&!has_di)m->rm=2;else if(has_bp&&has_di&&!has_bx&&!has_si)m->rm=3;else if(has_si&&!has_bx&&!has_bp&&!has_di)m->rm=4;else if(has_di&&!has_bx&&!has_bp&&!has_si)m->rm=5;else if(has_bp&&!has_bx&&!has_si&&!has_di)m->rm=6;else if(has_bx&&!has_bp&&!has_si&&!has_di)m->rm=7;else if(!has_bx&&!has_bp&&!has_si&&!has_di){m->rm=6;m->mod=0;m->disp_size=2;return 1;}else {err(a,ln,"unsupported 8086 effective address");return -1;}
    if(m->disp==0 && !(m->rm==6&&has_bp)){m->mod=0;m->disp_size=0;}else if(m->disp>=-128&&m->disp<=127){m->mod=1;m->disp_size=1;}else{m->mod=2;m->disp_size=2;} return 1;
}
static void emit_mem_prefix(Asm*a,Mem*m){if(m->seg==0)emit8(a,0x26);else if(m->seg==1)emit8(a,0x2E);else if(m->seg==2)emit8(a,0x36);else if(m->seg==3)emit8(a,0x3E);}
static void emit_modrm_mem(Asm*a,int reg,Mem*m){emit8(a,(uint8_t)((m->mod<<6)|(reg<<3)|m->rm));if(m->disp_size==1)emit8(a,(uint8_t)m->disp);else if(m->disp_size==2)emit16(a,(uint16_t)m->disp);}
static void emit_modrm_mem_abs16(Asm*a,int reg,Mem*m,const char *expr,int ln){
    uint32_t off=a->pc+1;
    emit_modrm_mem(a,reg,m);
    if(m->mod==0&&m->rm==6&&m->disp_size==2)bj_abs16_local(a,off,expr,ln);
}

static int macro_find(Asm*a,const char*name){for(int i=0;i<a->nmacros;i++)if(!strcmp(a->macros[i].name,name))return i;return -1;}
static const char *include_dirs[32]; static int n_include_dirs;
static char include_stack[32][1024]; static int include_depth;
static FILE *open_include(const char *parent,const char *name,char *resolved,size_t cap){
 FILE *f; const char *slash=strrchr(parent,'/'),*back=strrchr(parent,'\\');
 if(!slash||(back&&back>slash))slash=back;
 if(slash){size_t n=(size_t)(slash-parent+1);if(n+strlen(name)+1<cap){memcpy(resolved,parent,n);strcpy(resolved+n,name);f=fopen(resolved,"r");if(f)return f;}}
 f=fopen(name,"r");if(f){snprintf(resolved,cap,"%s",name);return f;}
 for(int i=0;i<n_include_dirs;i++){snprintf(resolved,cap,"%s/%s",include_dirs[i],name);f=fopen(resolved,"r");if(f)return f;}
 return NULL;
}
static void preprocess(Asm*a,const char*path){
 if(include_depth>=32){fprintf(stderr,"x86-as: include nesting too deep: %s\n",path);exit(1);}
 for(int i=0;i<include_depth;i++)if(!strcmp(include_stack[i],path)){fprintf(stderr,"x86-as: circular include: %s\n",path);exit(1);}
 snprintf(include_stack[include_depth++],1024,"%s",path);
    FILE*f=fopen(path,"r");if(!f){perror(path);exit(1);}char line[MAX_LINE];int ln=0;Macro *cur=NULL;
    while(fgets(line,sizeof(line),f)){ln++;line[strcspn(line,"\r\n")]=0;char work[MAX_LINE];snprintf(work,sizeof(work),"%s",line);strip_comment(work);trim(work);char low[MAX_LINE];snprintf(low,sizeof(low),"%s",work);lower(low);
        if(!strncmp(low,"%macro ",7)){if(a->nmacros>=MAX_MACROS){fprintf(stderr,"too many macros\n");exit(1);}char n[64];int na=0;if(sscanf(work+7,"%63s %d",n,&na)!=2){fprintf(stderr,"x86-as:%d: bad %%macro\n",ln);exit(1);}cur=&a->macros[a->nmacros++];memset(cur,0,sizeof(*cur));lower(n);snprintf(cur->name,sizeof(cur->name),"%s",n);cur->nargs=na;continue;}
        if(!strcmp(low,"%endmacro")){cur=NULL;continue;} if(cur){if(cur->nbody<MAX_MACRO_LINES)snprintf(cur->body[cur->nbody++],MAX_LINE,"%s",line);continue;}
        if(!work[0]){continue;}
        if(!strncmp(low,"%include ",9)){
            char resolved[1024]; char *q=work+9; trim(q); size_t len=strlen(q);
            if(len<3 || q[0]!='"' || q[len-1]!='"'){fprintf(stderr,"%s:%d: bad include syntax\n",path,ln);exit(1);}
            q[len-1]=0;
            FILE *inc=open_include(path,q+1,resolved,sizeof(resolved));
            if(!inc){fprintf(stderr,"%s:%d: include not found: %s\n",path,ln,q+1);exit(1);}
            fclose(inc); preprocess(a,resolved); continue;
        }
        char first[64];int fi=0;const char*p=work;while(*p&&!isspace((unsigned char)*p)&&fi<63)first[fi++]=*p++;first[fi]=0;lower(first);int mi=macro_find(a,first);
        if(mi>=0){while(isspace((unsigned char)*p))p++;char argbuf[MAX_LINE];snprintf(argbuf,sizeof(argbuf),"%s",p);char*args[MAX_ARGS]={0};int na=argbuf[0]?split_operands(argbuf,args,MAX_ARGS):0;Macro*m=&a->macros[mi];if(na!=m->nargs){fprintf(stderr,"x86-as:%d: macro %s expects %d args\n",ln,m->name,m->nargs);exit(1);}for(int bi=0;bi<m->nbody;bi++){char ex[MAX_LINE];snprintf(ex,sizeof(ex),"%s",m->body[bi]);for(int ai=1;ai<=na;ai++){char key[16];snprintf(key,sizeof(key),"%%%d",ai);char tmp[MAX_LINE];char*q=ex;tmp[0]=0;while(1){char*hit=strstr(q,key);if(!hit){strncat(tmp,q,sizeof(tmp)-strlen(tmp)-1);break;}strncat(tmp,q,(size_t)(hit-q));strncat(tmp,args[ai-1],sizeof(tmp)-strlen(tmp)-1);q=hit+strlen(key);}snprintf(ex,sizeof(ex),"%s",tmp);}if(a->nlines<MAX_LINES){snprintf(a->lines[a->nlines].text,MAX_LINE,"%s",ex);a->lines[a->nlines].line_no=ln;a->nlines++;}}continue;}
        if(a->nlines<MAX_LINES){snprintf(a->lines[a->nlines].text,MAX_LINE,"%s",line);a->lines[a->nlines].line_no=ln;a->nlines++;}
    }fclose(f);include_depth--;
}

static int parse_db_string(Asm*a,const char*s,int ln){
    char quote = *s;
    if (quote != '\'' && quote != '"') return 0;
    s++;
    while (*s && *s != quote) {
        unsigned char c = (unsigned char)*s++;
        if (c == '\\') {
            if (!*s) { err(a, ln, "unterminated string"); return 1; }
            char q = *s++;
            if (q == 'n') c = '\n';
            else if (q == 'r') c = '\r';
            else if (q == 't') c = '\t';
            else c = (unsigned char)q;
        }
        emit8(a, c);
    }
    if (*s != quote) { err(a, ln, "unterminated string"); return 1; }
    s++;
    while (isspace((unsigned char)*s)) s++;
    if (*s) err(a, ln, "trailing text after string literal");
    return 1;
}
static void assemble_stmt(Asm*a,char*stmt,int ln);
static void directive_data(Asm*a,const char*kind,char*args,int ln){char*ops[MAX_ARGS];int n=split_operands(args,ops,MAX_ARGS);for(int i=0;i<n;i++){trim(ops[i]);if(!strcmp(kind,"db")&&parse_db_string(a,ops[i],ln))continue;int ok=1;int64_t v=eval(a,ops[i],ln,&ok);if(!strcmp(kind,"db"))emit8(a,(uint8_t)v);else emit16(a,(uint16_t)v);}}
static void assemble_stmt(Asm*a,char*stmt,int ln){
    strip_comment(stmt);trim(stmt);if(!*stmt)return;
    /* label */
    char *colon=NULL;int br=0,sq=0,dq=0;for(char*p=stmt;*p;p++){if(isspace((unsigned char)*p) && !br && !sq && !dq) break;if(*p=='\''&&!dq)sq=!sq;else if(*p=='"'&&!sq)dq=!dq;else if(!sq&&!dq){if(*p=='[')br++;else if(*p==']'&&br)br--;else if(*p==':'&&!br){colon=p;break;}}}
    if(colon){*colon=0;trim(stmt);char name[96];snprintf(name,sizeof(name),"%s",stmt);lower(name);if(*name)sym_set(a,name,a->org+a->pc,ln);stmt=colon+1;trim(stmt);if(!*stmt)return;}
    char word[64];int wi=0;char*p=stmt;while(*p&&!isspace((unsigned char)*p)&&wi<63)word[wi++]=*p++;word[wi]=0;lower(word);while(isspace((unsigned char)*p))p++;
    if(!strcmp(word,"bits")){
        char q[32];snprintf(q,sizeof(q),"%s",p);trim(q);
        int requested=atoi(q);
        if(requested!=16&&requested!=64){err(a,ln,"BITS supports 16 or 64");return;}
        if(requested==64&&a->mode_bits!=64){err(a,ln,"BITS 64 requires -m64");return;}
        if(requested==16&&a->mode_bits==64){err(a,ln,"BITS 16 conflicts with -m64");return;}
        return;
    }
    if(!strcmp(word,"section")){
        char q[64];snprintf(q,sizeof(q),"%s",p);trim(q);lower(q);
        if(!a->output_elf64){err(a,ln,"SECTION is currently supported only with -f elf64");return;}
        if(strcmp(q,".text")){err(a,ln,"Phase 1B ELF64 supports only section .text");return;}
        return;
    }
    if(!strcmp(word,"global")||!strcmp(word,"extern")){
        if(!a->output_elf64 && !a->output_bjobj){err(a,ln,"GLOBAL/EXTERN require a relocatable output format");return;}
        char gb[MAX_LINE];snprintf(gb,sizeof(gb),"%s",p);char*names[MAX_ARGS];int nn=split_operands(gb,names,MAX_ARGS);
        for(int i=0;i<nn;i++){trim(names[i]);lower(names[i]);if(!*names[i]){err(a,ln,"empty GLOBAL symbol");return;}global_add(a,names[i],ln);}
        return;
    }
    if(!strcmp(word,"cpu")){char q[64];snprintf(q,sizeof(q),"%s",p);trim(q);lower(q);if(!strcmp(q,"8086")||!strcmp(q,"8088"))a->cpu_level=86;else {err(a,ln,"phase1 supports cpu 8086/8088 only");}return;}
    if(!strcmp(word,"org")){if(a->output_elf64){err(a,ln,"ORG is not valid for ELF64 relocatable objects");return;}int ok=1;int64_t v=eval(a,p,ln,&ok);if(a->pc!=0)err(a,ln,"org must appear before output");else a->org=(uint32_t)v;return;}
    if(!strcmp(word,"equ")){err(a,ln,"use NAME equ EXPR form");return;}
    /* NAME equ EXPR */
    char copy[MAX_LINE];snprintf(copy,sizeof(copy),"%s",stmt);char*n1=strtok(copy," \t");char*n2=strtok(NULL," \t");if(n1&&n2){char l2[64];snprintf(l2,sizeof(l2),"%s",n2);lower(l2);if(!strcmp(l2,"equ")){char*ep=strstr(stmt,n2);ep+=strlen(n2);trim(ep);char nn[96];snprintf(nn,sizeof(nn),"%s",n1);lower(nn);int ok=1;int64_t v=eval(a,ep,ln,&ok);sym_set(a,nn,(uint32_t)v,ln);return;}}
    if(!strcmp(word,"db")||!strcmp(word,"dw")){char ab[MAX_LINE];snprintf(ab,sizeof(ab),"%s",p);directive_data(a,word,ab,ln);return;}
    if(!strcmp(word,"times")){char *db=strstr(p," db ");char *dw=strstr(p," dw ");char *hit=db?db:dw;if(!hit){err(a,ln,"times currently requires db/dw");return;}char ex[256];size_t n=(size_t)(hit-p);if(n>=sizeof(ex))n=sizeof(ex)-1;memcpy(ex,p,n);ex[n]=0;trim(ex);int ok=1;int64_t count=eval(a,ex,ln,&ok);char rest[MAX_LINE];snprintf(rest,sizeof(rest),"%s",hit+1);for(int64_t i=0;i<count;i++){char rr[MAX_LINE];snprintf(rr,sizeof(rr),"%s",rest);assemble_stmt(a,rr,ln);}return;}
    char argsbuf[MAX_LINE];snprintf(argsbuf,sizeof(argsbuf),"%s",p);char*ops[4]={0};int no=argsbuf[0]?split_operands(argsbuf,ops,4):0;for(int i=0;i<no;i++){trim(ops[i]); if (!strchr(ops[i], '\'')) lower(ops[i]);}
